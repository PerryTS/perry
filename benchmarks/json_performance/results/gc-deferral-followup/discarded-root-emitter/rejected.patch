+#[test]
+fn root_record_emits_borrowed_keys_without_managed_scratch() {
+    unsafe {
+        for text in [
+            "{\"id\":42,\"name\":\"東京🙂\",\"active\":true,\"score\":1.5,\"tags\":[\"line\\n\",null,false,3.25]}",
+            "{\"a\\\"b\":1,\"c\\nd\":false,\"\":null,\"long_key\":\"value\",\"tags\":[]}",
+        ] {
+            with_record(text, |obj, template| {
+                let bytes = crate::arena::arena_live_allocated_bytes();
+                let roots = crate::gc::RuntimeHandleScope::active_len_for_tests();
+                let collections = collection_count();
+                let mut output = String::with_capacity(256);
+                for _ in 0..1000 {
+                    output.clear();
+                    assert!(try_emit_root(obj, template.shape_fields, &mut output));
+                    assert_eq!(output, text);
+                }
+                assert_eq!(crate::arena::arena_live_allocated_bytes(), bytes);
+                assert_eq!(crate::gc::RuntimeHandleScope::active_len_for_tests(), roots);
+                assert_eq!(collection_count(), collections);
+            });
+        }
+    }
+}
+
+#[test]
+fn root_record_declines_late_complex_child_before_writing_a_prefix() {
+    unsafe {
+        with_record(
+            "{\"id\":1,\"a\":true,\"b\":null,\"first\":[1,2,3],\"last\":[4,{\"x\":5}]}",
+            |obj, template| {
+                let mut output = String::from("unchanged");
+                let capacity = output.capacity();
+                assert!(!try_emit_root(obj, template.shape_fields, &mut output));
+                assert_eq!(output, "unchanged");
+                assert_eq!(output.capacity(), capacity);
+            },
+        );
+    }
