+use super::*;
+
+fn string_metadata(entries: &[TapeEntry]) -> Vec<(u8, u32)> {
+    entries
+        .iter()
+        .filter(|entry| matches!(entry.kind, KIND_KEY | KIND_STRING))
+        .map(|entry| (entry.kind, entry.link))
+        .collect()
+}
