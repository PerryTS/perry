2026-09-10T06:59:55.2215659Z [36;1mset -euo pipefail[0m
2026-09-10T06:59:55.2215996Z [36;1mwget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \[0m
2026-09-10T06:59:55.2216446Z [36;1m  | sudo tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc >/dev/null[0m
2026-09-10T06:59:55.2216808Z [36;1m. /etc/os-release[0m
2026-09-10T06:59:55.2217259Z [36;1mecho "deb http://apt.llvm.org/${VERSION_CODENAME}/ llvm-toolchain-${VERSION_CODENAME}-22 main" \[0m
2026-09-10T06:59:55.2217821Z [36;1m  | sudo tee /etc/apt/sources.list.d/llvm22.list >/dev/null[0m
2026-09-10T06:59:55.2218173Z [36;1msudo apt-get update -qq[0m
2026-09-10T06:59:55.2218545Z [36;1m# `clang-22` is NOT implied by `llvm-22-dev`: apt ships opt and clang as[0m
2026-09-10T06:59:55.2219026Z [36;1m# separate packages, so installing only the dev libraries leaves[0m
2026-09-10T06:59:55.2219508Z [36;1m# /usr/lib/llvm-22/bin/opt with no clang beside it. That is exactly what[0m
2026-09-10T06:59:55.2220196Z [36;1m# ubuntu-24.04-arm hits. Anything needing a MATCHED opt+clang pair — the[0m
2026-09-10T06:59:55.2220707Z [36;1m# RS4GC arm in gc-native-roots.yml — then finds a half-populated bin dir[0m
2026-09-10T06:59:55.2221202Z [36;1m# and either fails outright or falls back to hand-rolled discovery and[0m
2026-09-10T06:59:55.2221690Z [36;1m# picks up the distro's LLVM 18. Install the pair here, once, so every[0m
2026-09-10T06:59:55.2222140Z [36;1m# workflow gets a version-matched toolchain from one place.[0m
2026-09-10T06:59:55.2222585Z [36;1msudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \[0m
2026-09-10T06:59:55.2223001Z [36;1m  llvm-22-dev libpolly-22-dev libzstd-dev clang-22[0m
2026-09-10T06:59:55.2223368Z [36;1mllvm-config-22 --version | grep -q '^22\.' \[0m
2026-09-10T06:59:55.2223715Z [36;1m  || { echo "::error::apt LLVM is not 22.x"; exit 1; }[0m
2026-09-10T06:59:55.2224061Z [36;1mPREFIX="$(llvm-config-22 --prefix)"[0m
2026-09-10T06:59:55.2224455Z [36;1m# Co-locate clang with opt. apt installs the versioned binary at[0m
2026-09-10T06:59:55.2224924Z [36;1m# /usr/bin/clang-22, but consumers resolve a toolchain by DIRECTORY —[0m
2026-09-10T06:59:55.2225413Z [36;1m# PERRY_LLVM_OPT and PERRY_LLVM_CLANG must come from the same bin dir or[0m
2026-09-10T06:59:55.2225897Z [36;1m# opt and clang can skew across majors — so it has to sit under $PREFIX.[0m
2026-09-10T06:59:55.2226354Z [36;1mif [ ! -x "$PREFIX/bin/clang" ] && [ -x /usr/bin/clang-22 ]; then[0m
2026-09-10T06:59:55.2226765Z [36;1m  sudo ln -sf /usr/bin/clang-22 "$PREFIX/bin/clang"[0m
2026-09-10T06:59:55.2227068Z [36;1mfi[0m
2026-09-10T06:59:55.2227371Z [36;1m# Assert the pair, not just llvm-config. A green setup step that leaves[0m
2026-09-10T06:59:55.2227865Z [36;1m# a mismatched clang is the failure this whole action exists to prevent.[0m
2026-09-10T06:59:55.2228494Z [36;1m"$PREFIX/bin/clang" --version | grep -q 'version 22\.' \[0m
2026-09-10T06:59:55.2229047Z [36;1m  || { echo "::error::clang under $PREFIX is not 22.x"; exit 1; }[0m
2026-09-10T06:59:55.2229448Z [36;1mecho "LLVM_SYS_221_PREFIX=$PREFIX" >> "$GITHUB_ENV"[0m
