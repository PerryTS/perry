2026-09-10T07:00:21.0777504Z [36;1m# scheduling perturb another's wait budget (the event_pump timing[0m
2026-09-10T07:00:21.0777982Z [36;1m# flakes) and races the GC/threading tests into intermittent SIGSEGV.[0m
2026-09-10T07:00:21.0778462Z [36;1m# Run perry-runtime single-threaded so the tests can't interfere.[0m
2026-09-10T07:00:21.0778827Z [36;1m[0m
2026-09-10T07:00:21.0779026Z [36;1mif [ "pr" != "pr" ]; then[0m
2026-09-10T07:00:21.0779396Z [36;1m  # ---- FULL run: release tags / nightly cron / workflow_dispatch ----[0m
2026-09-10T07:00:21.0780180Z [36;1m  # Every target, including the slow auto-optimize integration tests.[0m
2026-09-10T07:00:21.0780650Z [36;1m  if printf '%s\n' "$scope" | grep -qx 'perry-runtime'; then[0m
2026-09-10T07:00:21.0781052Z [36;1m    RUST_TEST_THREADS=1 cargo test -p perry-runtime[0m
2026-09-10T07:00:21.0781374Z [36;1m  fi[0m
2026-09-10T07:00:21.0781681Z [36;1m  # `cargo test` only builds lib/bin/test targets — NOT the `staticlib`[0m
2026-09-10T07:00:21.0782168Z [36;1m  # crate-type — so libperry_runtime.a / libperry_stdlib.a are never[0m
2026-09-10T07:00:21.0782674Z [36;1m  # produced by the steps above; they only exist if restored from the[0m
2026-09-10T07:00:21.0783164Z [36;1m  # cache. Integration tests that compile with PERRY_NO_AUTO_OPTIMIZE=1[0m
2026-09-10T07:00:21.0783660Z [36;1m  # (e.g. functional_batch2_regressions) link the prebuilt archive[0m
2026-09-10T07:00:21.0784303Z [36;1m  # directly and fail with "Could not find libperry_runtime.a" if the[0m
2026-09-10T07:00:21.0784766Z [36;1m  # cached staticlib was invalidated. Build them explicitly.[0m
2026-09-10T07:00:21.0785209Z [36;1m  # #8479: build these with `--release`. The `panic` strategy is a[0m
2026-09-10T07:00:21.0785681Z [36;1m  # PROFILE-level setting, and only `release`/`dist`/`perry-dev` set[0m
2026-09-10T07:00:21.0786144Z [36;1m  # `panic = "abort"` — a bare `cargo build` produces a DEBUG,[0m
2026-09-10T07:00:21.0786583Z [36;1m  # `panic = "unwind"` runtime. Under `panic = "unwind"` rustc plants[0m
2026-09-10T07:00:21.0787041Z [36;1m  # an RFC-2945 abort guard in every `extern "C"` helper, which a JS[0m
2026-09-10T07:00:21.0787491Z [36;1m  # throw crossing that helper trips ("panic in a function that[0m
2026-09-10T07:00:21.0787937Z [36;1m  # cannot unwind"). So the child binaries were linking a runtime[0m
2026-09-10T07:00:21.0788399Z [36;1m  # whose unwind semantics are the OPPOSITE of what Perry ships, and[0m
2026-09-10T07:00:21.0788859Z [36;1m  # the two throw-transport canaries could not both pass: #8416[0m
2026-09-10T07:00:21.0789356Z [36;1m  # papered over it with `extern "C-unwind"` (correct for the debug[0m
2026-09-10T07:00:21.0790180Z [36;1m  # runtime, WRONG for the shipped one), #8464 generalised that and[0m
2026-09-10T07:00:21.0790669Z [36;1m  # cost +20 gap crashes, and #8480 added more. Verified: against a[0m
2026-09-10T07:00:21.0791105Z [36;1m  # `panic = "abort"` runtime, with those conversions removed, BOTH[0m
2026-09-10T07:00:21.0791510Z [36;1m  # `tier1_every_ffi_type_against_test_dylib` and[0m
2026-09-10T07:00:21.0791920Z [36;1m  # `function_apply_with_runtime_args_defers_to_a_located_aot_error`[0m
2026-09-10T07:00:21.0792292Z [36;1m  # pass.[0m
2026-09-10T07:00:21.0792604Z [36;1m  if printf '%s\n' "$scope" | grep -qE '^(perry|perry-stdlib)$'; then[0m
2026-09-10T07:00:21.0793222Z [36;1m    cargo build --release -p perry-runtime -p perry-stdlib -p perry-runtime-static -p perry-stdlib-static[0m
2026-09-10T07:00:21.0793797Z [36;1m    export PERRY_RUNTIME_DIR="$PWD/target/release"[0m
2026-09-10T07:00:21.0794111Z [36;1m  fi[0m
2026-09-10T07:00:21.0794510Z [36;1m  find target/debug/deps -maxdepth 1 -type f -perm -111 ! -name '*.so' -delete 2>/dev/null || true[0m
2026-09-10T07:00:21.0795091Z [36;1m  # Large perry / perry-stdlib integration-test binaries: serialize[0m
2026-09-10T07:00:21.0795716Z [36;1m  # builds and prune linked executables between packages so the runner[0m
2026-09-10T07:00:21.0796113Z [36;1m  # disk doesn't exhaust mid-job.[0m
2026-09-10T07:00:21.0796396Z [36;1m  export CARGO_BUILD_JOBS=1[0m
2026-09-10T07:00:21.0796764Z [36;1m  for package in $(printf '%s\n' "$scope" | grep -vx 'perry-runtime'); do[0m
