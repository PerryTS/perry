2026-09-10T07:00:21.0798081Z [36;1m      # integration target. Keep the bin/unit target here so the[0m
2026-09-10T07:00:21.0798514Z [36;1m      # split is exhaustive without running any target twice.[0m
2026-09-10T07:00:21.0798907Z [36;1m      echo "::group::cargo test --bins -p perry"[0m
2026-09-10T07:00:21.0799232Z [36;1m      cargo test --bins -p perry[0m
2026-09-10T07:00:21.0799499Z [36;1m    else[0m
2026-09-10T07:00:21.0799901Z [36;1m      echo "::group::cargo test -p $package"[0m
2026-09-10T07:00:21.0800263Z [36;1m      cargo test -p "$package"[0m
2026-09-10T07:00:21.0800522Z [36;1m    fi[0m
2026-09-10T07:00:21.0800735Z [36;1m    echo "::endgroup::"[0m
2026-09-10T07:00:21.0801014Z [36;1m    cargo clean -p "$package" || true[0m
2026-09-10T07:00:21.0801500Z [36;1m    find target/debug/deps -maxdepth 1 -type f -perm -111 ! -name '*.so' -delete 2>/dev/null || true[0m
2026-09-10T07:00:21.0801959Z [36;1m  done[0m
2026-09-10T07:00:21.0802150Z [36;1melse[0m
2026-09-10T07:00:21.0802528Z [36;1m  # ---- FAST per-PR run (<10 min target) ----[0m
2026-09-10T07:00:21.0802921Z [36;1m  # Unit / lib / bin tests for the affected crates only. The slow[0m
2026-09-10T07:00:21.0803385Z [36;1m  # auto-optimize *integration* tests (tests/*.rs — each shells out to[0m
2026-09-10T07:00:21.0803873Z [36;1m  # `perry compile`, ~4–6 min apiece, 163 of them in crates/perry[0m
2026-09-10T07:00:21.0804364Z [36;1m  # alone) are NOT run wholesale per-PR; they run in the nightly full[0m
2026-09-10T07:00:21.0804835Z [36;1m  # job, on release tags, and on demand via the `run-extended-tests`[0m
2026-09-10T07:00:21.0805298Z [36;1m  # label. No staticlib dependency to build here (no integration[0m
2026-09-10T07:00:21.0805651Z [36;1m  # tests).[0m
2026-09-10T07:00:21.0805871Z [36;1m  #[0m
2026-09-10T07:00:21.0806154Z [36;1m  # #5960: the suites the DIFF NAMES — i.e. a PR's own new/edited[0m
2026-09-10T07:00:21.0806613Z [36;1m  # acceptance suite — do run per-PR, in the separate `e2e-scoped`[0m
2026-09-10T07:00:21.0807092Z [36;1m  # job below. Without it a PR's acceptance test could not fail its[0m
2026-09-10T07:00:21.0807454Z [36;1m  # own CI (#5938).[0m
2026-09-10T07:00:21.0807682Z [36;1m  #[0m
2026-09-10T07:00:21.0807957Z [36;1m  # Run each crate in its OWN `cargo test` invocation — NOT one[0m
2026-09-10T07:00:21.0808436Z [36;1m  # multi-package invocation. Building several crates together unifies[0m
2026-09-10T07:00:21.0808953Z [36;1m  # perry-runtime's cargo features, which turns on optional impls (e.g.[0m
2026-09-10T07:00:21.0809448Z [36;1m  # `fetch`) whose extern symbols (`js_fetch_with_options`) live in a[0m
2026-09-10T07:00:21.0810042Z [36;1m  # separate crate the other test binaries don't link → `undefined[0m
