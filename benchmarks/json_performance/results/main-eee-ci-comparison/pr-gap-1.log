2026-09-10T07:12:50.6707529Z [36;1m. /etc/os-release[0m
2026-09-10T07:12:50.6708041Z [36;1mecho "deb http://apt.llvm.org/${VERSION_CODENAME}/ llvm-toolchain-${VERSION_CODENAME}-22 main" \[0m
2026-09-10T07:12:50.6708634Z [36;1m  | sudo tee /etc/apt/sources.list.d/llvm22.list >/dev/null[0m
2026-09-10T07:12:50.6709015Z [36;1msudo apt-get update -qq[0m
2026-09-10T07:12:50.6709430Z [36;1m# `clang-22` is NOT implied by `llvm-22-dev`: apt ships opt and clang as[0m
2026-09-10T07:12:50.6709952Z [36;1m# separate packages, so installing only the dev libraries leaves[0m
2026-09-10T07:12:50.6710457Z [36;1m# /usr/lib/llvm-22/bin/opt with no clang beside it. That is exactly what[0m
2026-09-10T07:12:50.6710978Z [36;1m# ubuntu-24.04-arm hits. Anything needing a MATCHED opt+clang pair — the[0m
2026-09-10T07:12:50.6711519Z [36;1m# RS4GC arm in gc-native-roots.yml — then finds a half-populated bin dir[0m
2026-09-10T07:12:50.6712052Z [36;1m# and either fails outright or falls back to hand-rolled discovery and[0m
2026-09-10T07:12:50.6712567Z [36;1m# picks up the distro's LLVM 18. Install the pair here, once, so every[0m
2026-09-10T07:12:50.6713044Z [36;1m# workflow gets a version-matched toolchain from one place.[0m
2026-09-10T07:12:50.6713523Z [36;1msudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \[0m
2026-09-10T07:12:50.6713973Z [36;1m  llvm-22-dev libpolly-22-dev libzstd-dev clang-22[0m
2026-09-10T07:12:50.6714358Z [36;1mllvm-config-22 --version | grep -q '^22\.' \[0m
2026-09-10T07:12:50.6714735Z [36;1m  || { echo "::error::apt LLVM is not 22.x"; exit 1; }[0m
2026-09-10T07:12:50.6715093Z [36;1mPREFIX="$(llvm-config-22 --prefix)"[0m
2026-09-10T07:12:50.6715496Z [36;1m# Co-locate clang with opt. apt installs the versioned binary at[0m
2026-09-10T07:12:50.6715996Z [36;1m# /usr/bin/clang-22, but consumers resolve a toolchain by DIRECTORY —[0m
2026-09-10T07:12:50.6716512Z [36;1m# PERRY_LLVM_OPT and PERRY_LLVM_CLANG must come from the same bin dir or[0m
2026-09-10T07:12:50.6717028Z [36;1m# opt and clang can skew across majors — so it has to sit under $PREFIX.[0m
2026-09-10T07:12:50.6717676Z [36;1mif [ ! -x "$PREFIX/bin/clang" ] && [ -x /usr/bin/clang-22 ]; then[0m
2026-09-10T07:12:50.6718113Z [36;1m  sudo ln -sf /usr/bin/clang-22 "$PREFIX/bin/clang"[0m
2026-09-10T07:12:50.6718451Z [36;1mfi[0m
2026-09-10T07:12:50.6718777Z [36;1m# Assert the pair, not just llvm-config. A green setup step that leaves[0m
2026-09-10T07:12:50.6719297Z [36;1m# a mismatched clang is the failure this whole action exists to prevent.[0m
2026-09-10T07:12:50.6719774Z [36;1m"$PREFIX/bin/clang" --version | grep -q 'version 22\.' \[0m
2026-09-10T07:12:50.6720212Z [36;1m  || { echo "::error::clang under $PREFIX is not 22.x"; exit 1; }[0m
2026-09-10T07:12:50.6720634Z [36;1mecho "LLVM_SYS_221_PREFIX=$PREFIX" >> "$GITHUB_ENV"[0m
