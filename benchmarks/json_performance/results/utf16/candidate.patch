+use super::count;
+use crate::string::{compute_utf16_len, compute_utf16_len_wtf8};
+
+fn check(s: &str) {
+    let expected = s.encode_utf16().count();
+    assert_eq!(count(s), expected);
+    assert_eq!(
+        compute_utf16_len(s.as_ptr(), s.len() as u32) as usize,
+        expected
+    );
+}
