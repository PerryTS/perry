package perry:host-resources@1.0.0;
interface tokens {
  resource token { constructor(value: u32); read: func() -> u32; }
  resource other;
  consume: func(value: own<token>);
  hold: func(value: own<token>);
}
interface aliases {
  use tokens.{token as alias};
  read-alias: func(value: borrow<alias>) -> u32;
}
interface runner {
  use tokens.{token, other};
  record pair { first: own<token>, second: own<token> }
  make: func(value: u32) -> own<token>;
  echo: func(value: own<token>) -> own<token>;
  read: func(value: borrow<token>) -> u32;
  read-alias: func(value: borrow<token>) -> u32;
  consume: func(value: own<token>);
  consume-other: func(value: own<other>);
  consume-imported: func(value: own<token>);
  return-to-host: func(value: own<token>);
  consume-pair: func(value: pair);
  checked: func(value: own<token>, amount: u8);
  mixed: func(owner: own<token>, borrowed: borrow<token>);
  keep: func(value: own<token>);
  take: func() -> own<token>;
  fail: func(value: own<token>);
}
world plugin { import tokens; import aliases; export runner; }
