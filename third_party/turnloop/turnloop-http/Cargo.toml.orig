[package]
name = "turnloop-http"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
description = "Sans-I/O HTTP/1.1 and HTTP/2 client and server protocols"
readme = "README.md"
keywords = ["networking", "sans-io", "http"]
categories = ["network-programming"]
documentation = "https://docs.rs/turnloop-http"

[features]
default = ["ring"]
# turnloop-tls's default crypto provider. Disable default features to link only
# the rustls provider the host passes to turnloop-tls.
ring = ["turnloop-tls/ring"]
turnloop = ["dep:turnloop-io", "turnloop-tls/turnloop"]

pure-rust-zstd = ["dep:turnloop-zstd-decoder"]

[dependencies]
turnloop-io = { workspace = true, optional = true }

turnloop-zstd-decoder = { workspace = true, optional = true }
bytes.workspace = true
http.workspace = true
url.workspace = true
httparse.workspace = true
flate2.workspace = true
brotli.workspace = true
base64.workspace = true
percent-encoding.workspace = true
# Not the workspace entry, so that the host decides whether ring is linked.
turnloop-tls = { path = "../turnloop-tls", version = "0.1.0-alpha.9", default-features = false }

[dev-dependencies]
rcgen.workspace = true

[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
zstd.workspace = true

[target.'cfg(target_arch = "wasm32")'.dependencies]
turnloop-zstd-decoder.workspace = true

[lints]
workspace = true

[package.metadata.turnloop-ci]
role = "protocol"
service-group = "http"
integration-tests = ["interop", "asynchronous", "server_allocations"]
wasi-tests = ["asynchronous", "codecs", "allocations"]

[[test]]
name = "allocations"
harness = false

[[example]]
name = "h2spec_server"
required-features = ["turnloop"]

[[example]]
name = "https_get"
required-features = ["turnloop"]

[[example]]
name = "tls_echo"
required-features = ["turnloop"]

[[test]]
name = "asynchronous"
required-features = ["turnloop"]

[[test]]
name = "server_allocations"
harness = false
required-features = ["turnloop"]

[target.'cfg(all(target_os = "wasi", target_env = "p3"))'.dependencies]
turnloop-io = { workspace = true, optional = true, features = ["wasi-p3-experimental"] }
