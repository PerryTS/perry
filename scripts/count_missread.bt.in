// Replace @BINARY@ with one symbol-preserving lane binary.
// Read-site addresses are stable with setarch -R. No runtime instrumentation.
// ObjectHeader.meta +8; ObjectMeta.flags +24 and dictionary_keys +120 (LP64).
config = { max_map_keys = 262144; missing_probes = warn; }
BEGIN {
  // Normal binaries omit the diagnostic probe. Keep its map types defined.
  @reasons[-1] = count(); @site_reasons[0, -1] = count();
  clear(@reasons); clear(@site_reasons);
}
uprobe:@BINARY@:js_object_get_field_ic_front /pid == cpid/ {
  @front[arg3] = count();
  @counts["front"] = count();
}
uprobe:@BINARY@:js_object_get_field_ic_slow /pid == cpid/ {
  @counts["slow"] = count();
  @slow[arg2, str(arg1 + 20, *(uint32*)uptr(arg1 + 4) + 1)] = count();
  @shapes[arg2, *(uint32*)uptr(arg0 + 4)] = count();
  $kind = *(uint8*)uptr(arg0 - 8);
  @read_kinds[arg2, $kind] = count();
  if ($kind == 2) {
    $meta = *(uint64*)uptr(arg0 + 8);
    @read_classes[arg2, *(uint32*)uptr(arg0)] = count();
    @read_flags[arg2, *(uint64*)uptr($meta + 24) & 127] = count();
    if (*(uint64*)uptr($meta + 120)) { @read_dictionaries[arg2] = count(); }
  }
  if (str(arg1 + 20, *(uint32*)uptr(arg1 + 4) + 1) == "prototype") {
    @prototype_bags[arg2, *(uint32*)uptr(arg0 + 4),
      *(uint32*)uptr(*(uint64*)uptr(arg0 + 8) + 4)] = count();
  }
  @cache_state[*(uint64*)uptr(arg2) != 0] = count();
}
uprobe:@BINARY@:*22get_field_ic_miss_impl /pid == cpid/ {
  @counts["read_miss_impl"] = count();
  @read_misses[arg2, str(arg1 + 20, *(uint32*)uptr(arg1 + 4) + 1)] = count();
}
uprobe:@BINARY@:*23method_site_miss_object /pid == cpid/ { @counts["heap_method_miss"] = count(); }
uprobe:@BINARY@:js_method_site_miss /pid == cpid/ {
  @counts["method_miss"] = count();
  @methods[arg0, arg1] = count();
  @method_ids[arg0, arg2] = count();
  if ((arg2 >> 48) == 0x7ff8) {
    $descriptor = arg2 & 0x0000ffffffffffff;
    @method_names[arg0, str(*(uint64*)uptr($descriptor + 16),
      *(uint32*)uptr($descriptor) + 1)] = count();
  }
}
// The runner verifies the five-byte movq %xmm0,%rax at this offset.
// RDI still holds the site and RAX holds the incoming boxed receiver.
uprobe:@BINARY@:js_method_site_miss+5 /pid == cpid/ {
  $boxed = reg("ax");
  if (($boxed >> 48) == 0x7ffd && ($boxed & 0x0000ffffffffffff) >= 0x100000) {
    $o = $boxed & 0x0000ffffffffffff;
    $kind = *(uint8*)uptr($o - 8);
    @method_kinds[arg0, $kind] = count();
    if ($kind == 2) {
      @method_classes[arg0, *(uint32*)uptr($o)] = count();
      @method_shapes[arg0, *(uint32*)uptr($o + 4)] = count();
      $meta = *(uint64*)uptr($o + 8);
      @method_flags[arg0, *(uint64*)uptr($meta + 24) & 127] = count();
      if (*(uint64*)uptr($meta + 120)) { @method_dictionaries[arg0] = count(); }
    }
  } else { @method_kinds[arg0, -1] = count(); }
}
uprobe:@BINARY@:*ic_diag_note /pid == cpid/ {
  @reasons[arg2] = count();
  @site_reasons[arg0, arg2] = count();
}
uprobe:@BINARY@:*try_data_lookup_key /pid == cpid/ {
  @counts["data_walk"] = count();
}
uprobe:@BINARY@:*is_anon_shape_class_id /pid == cpid/ { @counts["anon_class"] = count(); }
uprobe:@BINARY@:*get_parent_class_id /pid == cpid/ { @counts["parent_class"] = count(); }
uprobe:@BINARY@:*prototype_objects*class_prototype_object /pid == cpid/ {
  @counts["class_prototype"] = count();
}
uprobe:@BINARY@:*get_prototype_of_resolved /pid == cpid/ {
  @counts["get_prototype"] = count();
}
uprobe:@BINARY@:*mark_chain_hops /pid == cpid/ { @counts["store_mark_walk"] = count(); }
uprobe:@BINARY@:*class_instance_set_may_intercept /pid == cpid/ { @counts["store_intercept_walk"] = count(); }
uprobe:@BINARY@:js_put_value_set_packed_miss /pid == cpid/ {
  @counts["packed_store_miss"] = count();
  @stores[arg3, str(arg0 + 20, *(uint32*)uptr(arg0 + 4) + 1)] = count();
}
END {
  print(@counts);
  print(@stores);
  print(@slow); print(@read_misses);
  print(@shapes);
  print(@read_kinds); print(@read_classes); print(@read_flags); print(@read_dictionaries);
  print(@front);
  print(@methods);
  print(@method_shapes);
  print(@method_classes);
  print(@method_kinds); print(@method_flags); print(@method_dictionaries);
  print(@method_ids);
  print(@method_names);
  print(@reasons);
  print(@site_reasons);
  print(@cache_state);
  print(@prototype_bags, 40);
  clear(@read_kinds); clear(@read_classes); clear(@read_flags); clear(@read_dictionaries);
  clear(@method_flags); clear(@method_dictionaries);
  clear(@read_misses);
  clear(@stores); clear(@counts); clear(@slow); clear(@shapes); clear(@front);
  clear(@method_shapes); clear(@method_classes); clear(@method_kinds); clear(@methods); clear(@cache_state);
  clear(@method_ids);
  clear(@method_names); clear(@reasons); clear(@site_reasons);
  clear(@prototype_bags);
}
