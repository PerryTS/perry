// Replace @BINARY@ with one symbol-preserving lane binary.
// Read-site addresses are stable with setarch -R. No runtime instrumentation.
config = { max_map_keys = 262144; missing_probes = warn; }
uprobe:@BINARY@:js_object_get_field_ic_front /pid == cpid/ {
  @front[arg3] = count();
  @counts["front"] = count();
}
uprobe:@BINARY@:js_object_get_field_ic_slow /pid == cpid/ {
  @counts["slow"] = count();
  @slow[arg2, str(arg1 + 20, *(uint32*)uptr(arg1 + 4) + 1)] = count();
  @shapes[arg2, *(uint32*)uptr(arg0 + 4)] = count();
  if (str(arg1 + 20, *(uint32*)uptr(arg1 + 4) + 1) == "prototype") {
    @prototype_bags[arg2, *(uint32*)uptr(arg0 + 4),
      *(uint32*)uptr(*(uint64*)uptr(arg0 + 16) + 4)] = count();
  }
  @cache_state[*(uint64*)uptr(arg2) != 0] = count();
}
uprobe:@BINARY@:js_method_site_miss /pid == cpid/ {
  @counts["method_miss"] = count();
  @methods[arg0, arg1] = count();
  @method_ids[arg0, arg2] = count();
  if ((arg2 >> 48) == 0x7ff8) {
    $descriptor = arg2 & 0x0000ffffffffffff;
    @method_names[arg0, str(*(uint64*)uptr($descriptor + 16),
      *(uint32*)uptr($descriptor) + 1)] = count();
  }
}
uprobe:@BINARY@:*ic_diag_note /pid == cpid/ {
  @reasons[arg2] = count();
  @site_reasons[arg0, arg2] = count();
}
uprobe:@BINARY@:*try_data_lookup_key /pid == cpid/ { @counts["data_walk"] = count(); }
uprobe:@BINARY@:*is_anon_shape_class_id /pid == cpid/ { @counts["anon_class"] = count(); }
uprobe:@BINARY@:*get_parent_class_id /pid == cpid/ { @counts["parent_class"] = count(); }
uprobe:@BINARY@:*prototype_objects*class_prototype_object /pid == cpid/ {
  @counts["class_prototype"] = count();
}
uprobe:@BINARY@:*get_prototype_of_resolved /pid == cpid/ {
  @counts["get_prototype"] = count();
}
END {
  print(@counts);
  print(@slow);
  print(@shapes);
  print(@front);
  print(@methods);
  print(@method_ids);
  print(@method_names);
  print(@reasons);
  print(@site_reasons);
  print(@cache_state);
  print(@prototype_bags, 40);
  clear(@counts); clear(@slow); clear(@shapes); clear(@front);
  clear(@methods); clear(@cache_state);
  clear(@method_ids);
  clear(@method_names); clear(@reasons); clear(@site_reasons);
  clear(@prototype_bags);
}
