{
  "default_branch": "main",
  "tag_pattern": "^v[0-9]",
  "workflows": [
    {
      "path": "test.yml",
      "name": "CI",
      "subjects": [
        {
          "id": "core",
          "name": "CI core gate",
          "job_names": [
            "pr-gate",
            "main-gate",
            "full-suite-gate"
          ],
          "path": "test.yml"
        },
        {
          "id": "security-audit",
          "name": "Security Audit",
          "job": "security-audit",
          "path": "security-audit.yml"
        },
        {
          "id": "coverage",
          "name": "Coverage",
          "job": "coverage",
          "path": "coverage.yml"
        }
      ]
    },
    {
      "path": "gc.yml",
      "name": "GC",
      "subjects": [
        {
          "id": "gc-ratchet",
          "name": "GC Ratchet",
          "job": "gc-ratchet",
          "path": "gc-ratchet.yml"
        },
        {
          "id": "gc-root-dominance",
          "name": "GC Root Dominance",
          "job": "gc-root-dominance",
          "path": "gc-root-dominance.yml"
        },
        {
          "id": "gc-native-roots",
          "name": "gc-native-roots",
          "job": "gc-native-roots",
          "path": "gc-native-roots.yml"
        },
        {
          "id": "gc-moving-witnesses",
          "name": "GC Moving Witnesses",
          "job": "gc-moving-witnesses",
          "path": "gc-moving-witnesses.yml"
        },
        {
          "id": "gc-parse-churn-gate",
          "name": "GC Parse-Churn Layout Gate",
          "job": "gc-parse-churn-gate",
          "path": "gc-parse-churn-gate.yml"
        },
        {
          "id": "gc-ptr-shape-off-witness",
          "name": "GC Ptr<Shape> OFF-arm witness",
          "job": "gc-ptr-shape-off-witness",
          "path": "gc-ptr-shape-off-witness.yml"
        }
      ]
    },
    {
      "path": "compiler-runtime.yml",
      "name": "Extended Tests",
      "subjects": [
        {
          "id": "eh-transport",
          "name": "eh-transport",
          "job": "eh-transport",
          "path": "eh-transport.yml"
        },
        {
          "id": "llvm-inprocess",
          "name": "llvm-inprocess",
          "job": "llvm-inprocess",
          "path": "llvm-inprocess.yml"
        },
        {
          "id": "auto-opt-app-patterns",
          "name": "Auto-Optimize App Patterns",
          "job": "auto-opt-app-patterns",
          "path": "auto-opt-app-patterns.yml"
        },
        {
          "id": "tls-budget",
          "name": "TLS Budget",
          "job": "tls-budget",
          "path": "tls-budget.yml"
        }
      ]
    }
  ],
  "excluded": [
    {
      "path": "maintenance.yml",
      "why": "Repository's gate-freshness and npm-publish-freshness subjects maintain their own sticky issues; observer validation runs offline in Repository and the observer does not subscribe to its own parent."
    }
  ]
}
