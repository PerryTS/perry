          "original_events": {
            "schedule": [
              {
                "cron": "37 6 * * *"
              }
            ],
            "release": {
              "types": [
                "published"
              ]
            },
            "workflow_dispatch": {
              "inputs": {
                "cut_release": {
                  "description": "Release the dispatched candidate: gates/builds, npm OIDC publish, registry verification, then tag + GitHub Release.",
                  "type": "boolean",
                  "default": false
                },
                "nightly": {
                  "description": "Build this exact commit and publish its host/cross archives as a GitHub prerelease. Does not run stable release gates or publish to npm.",
                  "type": "boolean",
                  "default": false
                },
                "candidate_sha": {
                  "description": "Required with cut_release: exact pushed candidate SHA. Prevents a moved branch from publishing or being tagged.",
                  "type": "string",
                  "default": ""
                },
                "dist_tag": {
                  "description": "npm dist-tag for a cut release (normally latest).",
                  "type": "string",
                  "default": "latest"
                },
                "socket_scan": {
                  "description": "Run the optional Socket tarball scan before npm publication.",
                  "type": "boolean",
                  "default": false
                },
                "existing_tag": {
                  "description": "Re-publish an existing release (e.g. v0.5.1300): rebuild and re-upload assets / re-run publish legs for that tag. Replaces the old implicit 'latest release' fallback.",
                  "type": "string",
                  "default": ""
                },
                "publish_npm": {
                  "description": "With existing_tag: also (re-)publish the npm packages. release / cut_release runs always publish npm.",
                  "type": "boolean",
                  "default": false
                }
              }
            }
