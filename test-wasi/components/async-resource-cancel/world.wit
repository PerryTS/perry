package test:async-guest-resources@1.0.0;
interface foreign {
    resource item { constructor(value: u32); read: func() -> u32; }
    exchange: async func(id: u32, value: own<item>) -> own<item>;
    borrow-wait: async func(id: u32, value: borrow<item>) -> u32;
    block: func();
    unblock: func();
}
world provider {
    import gate: async func(id: u32);
    import entered: func(id: u32);
    import ready: func(id: u32);
    import dropped: func(id: u32);
    export foreign;
}
world supervisor {
    import foreign;
    use foreign.{item};
    import cancel-exchange: async func(id: u32, value: own<item>) -> own<item>;
    import loan: async func(id: u32, value: borrow<item>) -> u32;
    import cancel-loan: async func(id: u32, value: borrow<item>) -> u32;
    import cancelled-expired: func() -> bool;
    import published: func() -> u32;
    import wait: async func(id: u32);
    import submitted: func(id: u32);
    import gate: async func(id: u32);
    import entered: func(id: u32);
    import ready: func(id: u32);
    import dropped: func(id: u32);
    import proceed: async func(mode: u32, base: u32) -> u32;
    import acknowledged: func(mode: u32, base: u32, state: u32);
    export exercise: async func(mode: u32, base: u32) -> u32;
}
