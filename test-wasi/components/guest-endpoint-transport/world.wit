package perry:guest-endpoint-transport@1.0.0;

world plugin {
    record payload { text: string, wide: u64, letter: char, bytes: list<u8> }
    type pending = future<payload>;
    type values = stream<payload>;
    record pair { first: pending, second: values }
    export pass-future: func(value: pending) -> pending;
    export pass-stream: async func(value: values) -> values;
    export pass-pair: func(value: pair) -> pair;
    export character: async func(value: future<char>) -> future<char>;
    export empty: async func(value: future) -> future;
    export units: async func(value: stream) -> stream;
    export bytes: async func(value: stream<u8>) -> stream<u8>;
    export nested-value: async func(value: future<future<u32>>) -> future<future<u32>>;
    export dispose: func(value: future<u32>);
    export forget: func(value: stream<u32>);
    export checkpoint: func() -> u32;
    export read-started: func() -> u32;
    export read-future: async func(value: pending) -> payload;
    export read-values: async func(value: values) -> list<payload>;
    export read-character: async func(value: future<char>) -> char;
    export read-empty: async func(value: future) -> bool;
    export read-units: async func(value: stream) -> u32;
    export read-bytes: async func(value: stream<u8>) -> list<u8>;
    export read-nested: async func(value: future<future<u32>>) -> u32;
    export dispose-pending: async func(value: future<u32>) -> bool;
    export abandon-read: async func(value: future<u32>) -> bool;
    export read-held: async func() -> u32;
    export make-future: async func(value: payload) -> pending;
    export make-values: async func(value: list<payload>) -> values;
    export make-character: async func() -> future<char>;
    export make-empty: async func() -> future;
    export make-units: async func() -> stream;
    export make-bytes: async func() -> stream<u8>;
    export make-nested: async func() -> future<future<u32>>;
    export make-cancelled: async func() -> stream<u32>;
    export make-closed: async func() -> stream<u32>;
    export writes-completed: func() -> u32;
    export writes-failed: func() -> u32;
    export write-chunks: func() -> u32;
    export make-sync-future: func(value: payload) -> pending;
    export make-sync-values: func(value: list<payload>) -> values;
}
