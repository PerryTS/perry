+/// Discard backing after an Eden block has already stayed logically empty
+/// through a complete mutator interval. The mapping and header-start bitmap
+/// stay owned by the arena; complete interior pages exclude allocator metadata.
+pub(super) fn discard_idle_eden_block_pages(block: &ArenaBlock) -> usize {
+    debug_assert_eq!(block.offset, 0);
+    unsafe { decommit::release(block.data, block.size) }
+}
