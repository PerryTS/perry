+        };
+        let entry = PageClassEntry::new(range, 731).unwrap();
+        assert_eq!(entry.epoch, 731);
+        assert_eq!(entry.range(), range);
+        for address in [0, base - 1, base, base + 7, usize::MAX - 1, usize::MAX] {
+            assert_eq!(entry.contains(address), range.contains(address));
+        }
