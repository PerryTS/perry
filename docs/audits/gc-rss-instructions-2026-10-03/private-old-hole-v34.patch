+#[cfg(all(test, target_os = "linux"))]
+#[test]
+fn old_hole_page_advice_preserves_headers_links_neighbors_and_actual_reuse() {
+    crate::arena::tests::run_with_fresh_arenas(|| unsafe {
+        let _change = crate::gc::heap_generation::HeapChange::begin(
+            crate::gc::heap_generation::HeapChangeKind::Sweep,
+        );
+        old_free_reset_for_test();
+        let page = libc::sysconf(libc::_SC_PAGESIZE) as usize;
+        let payload = 4 * page + 56;
+        let first = crate::arena::arena_alloc_gc_old(payload, 8, GC_TYPE_STRING);
+        let neighbor = crate::arena::arena_alloc_gc_old(56, 8, GC_TYPE_STRING);
+        let second = crate::arena::arena_alloc_gc_old(payload, 8, GC_TYPE_STRING);
+        std::ptr::write_bytes(first, 0xa5, payload);
+        std::ptr::write_bytes(second, 0xa5, payload);
+        std::ptr::write_bytes(neighbor, 0xcc, 56);
+        let first_header = first.sub(GC_HEADER_SIZE) as *mut GcHeader;
+        let second_header = second.sub(GC_HEADER_SIZE) as *mut GcHeader;
+        let total = (*first_header).size as usize;
+        assert_eq!((*second_header).size as usize, total);
+        super::invalidate_dead_old_arena_header(first_header, total);
+        super::invalidate_dead_old_arena_header(second_header, total);
+        old_free_push_for_test(first as usize, total);
+        old_free_push_for_test(second as usize, total);
+        let bytes_before = old_free_bytes();
+        let resident = |user: *mut u8| {
+            let begin = user.add(OLD_FREE_LINK_BYTES) as usize;
+            let aligned = begin.next_multiple_of(page);
+            let end = (user as usize + payload) / page * page;
+            let count = (end - aligned) / page;
+            let mut bits = vec![0u8; count];
+            assert_eq!(
+                libc::mincore(aligned as *mut _, count * page, bits.as_mut_ptr()),
+                0
+            );
+            bits.iter().filter(|&&b| b & 1 != 0).count()
+        };
+        assert!(resident(first) >= 3 && resident(second) >= 3);
+        assert!(discard_previously_free_large_payload_pages() > 0);
+        assert_eq!(resident(first), 0);
+        assert_eq!(resident(second), 0);
+        assert_eq!((*first_header).size as usize, total);
+        assert_eq!((*second_header).size as usize, total);
+        assert_eq!((*first_header).obj_type, 0);
+        assert_eq!((*second_header).obj_type, 0);
+        assert_eq!(old_free_link(second as usize), first as usize);
+        assert_eq!(old_free_link(first as usize), 0);
+        assert_eq!(old_free_bytes(), bytes_before);
+        for i in 0..56 {
+            assert_eq!(*neighbor.add(i), 0xcc, "live neighbor remains intact");
+        }
+        let reused = crate::arena::arena_alloc_gc_old(payload, 8, GC_TYPE_STRING);
+        assert_eq!(reused, second, "actual old allocator consumes advised hole");
+        std::ptr::write_bytes(reused, 0x5a, payload);
+        assert!(resident(reused) >= 3);
+        discard_previously_free_large_payload_pages();
+        assert!(resident(reused) >= 3, "reused span is no longer eligible");
+        assert_eq!(*reused.add(2 * page), 0x5a);
+        assert_eq!(old_free_take_exact(total, None), Some(first as usize));
+        assert_eq!(old_free_take_exact(total, None), None);
+    });
