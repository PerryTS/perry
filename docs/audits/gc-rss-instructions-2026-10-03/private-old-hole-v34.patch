diff --git a/crates/perry-runtime/src/gc/old_free.rs b/crates/perry-runtime/src/gc/old_free.rs
index ed7b2077c2..f2dd3234f1 100644
--- a/crates/perry-runtime/src/gc/old_free.rs
+++ b/crates/perry-runtime/src/gc/old_free.rs
@@ -286,0 +287,53 @@ pub(super) fn old_free_rebuild_from_old_blocks(parse: impl FnMut(usize) -> bool)
+/// At full-collection entry, these holes were already free before this
+/// collection and were not consumed during the preceding mutator interval.
+/// The list is authoritative and unlinking precedes every block recycle.
+/// Preserve each header (heap walking) and its first payload word (the list
+/// link); only complete interior pages of the remaining dead payload qualify.
+/// No new heap walk, metadata table, layout bit or collection trigger.
+/// Repeated advice of a still-listed span is safe; its instruction cost must
+/// be measured before adopting this policy.
+pub(super) fn discard_previously_free_large_payload_pages() -> usize {
+    #[cfg(unix)]
+    {
+        if !OLD_FREE_NONEMPTY.with(Cell::get) {
+            return 0;
+        }
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) };
+        if page <= 0 {
+            return 0;
+        }
+        let prefix = GC_HEADER_SIZE + OLD_FREE_LINK_BYTES;
+        let minimum = (page as usize).saturating_mul(2).saturating_add(prefix);
+        OLD_FREE_MAP.with(|map| {
+            let heads = map.borrow();
+            let mut advised = 0;
+            // Small classes cannot contain a whole owned payload page. The
+            // size-class map lets us skip them without reading every header.
+            for (&total_size, &head) in &heads.large {
+                if total_size < minimum {
+                    continue;
+                }
+                let mut hole = head;
+                while hole != 0 {
+                    unsafe {
+                        let next = old_free_link(hole);
+                        let header = (hole - GC_HEADER_SIZE) as *const GcHeader;
+                        debug_assert_eq!((*header).obj_type, 0);
+                        debug_assert_eq!((*header).size as usize, total_size);
+                        advised += crate::arena::discard_dead_payload_pages(
+                            (hole + OLD_FREE_LINK_BYTES) as *mut u8,
+                            total_size - prefix,
+                        );
+                        hole = next;
+                    }
+                }
+            }
+            advised
+        })
+    }
+    #[cfg(not(unix))]
+    {
+        0
+    }
+}
