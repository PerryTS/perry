--- /dev/null
+++ b/crates/perry-runtime/src/gc/roots/stack_maps_prefix_tests.rs
@@ -0,0 +1,106 @@
+//! Preserve all matched roots while avoiding unrelated record-stream suffixes.
+use super::*;
+
+fn index(functions: &[lazy::TestFunction]) -> StackMapIndex {
+    let bytes = Box::leak(lazy::test_blob_multi(functions).into_boxed_slice());
+    build_index_from_sections_lazy(vec![bytes])
+}
+
+fn records(count: usize, root: i32) -> Vec<(u32, Vec<(u16, i32)>)> {
+    (0..count)
+        .map(|i| (64 + i as u32 * 8, vec![(DWARF_REG_FP_AARCH64, root)]))
+        .collect()
+}
+
+fn matched(
+    index: &StackMapIndex,
+    ip: usize,
+) -> Vec<(usize, Vec<StackMapLocation>, Vec<StackMapDerived>)> {
+    let found = index
+        .match_records(ip)
+        .expect("fixture must have a native root match");
+    index.materialise(Some(&found))
+}
+
+#[test]
+fn early_native_root_does_not_decode_unrelated_suffix() {
+    let mut rows = records(500, -8);
+    rows[0].0 = 16;
+    let ix = index(&[(0x1000, 64, rows)]);
+    lazy::DECODE_STEPS.with(|s| s.set(0));
+    let found = matched(&ix, 0x1010);
+    assert_eq!(found.len(), 1);
+    assert_eq!(
+        found[0].1,
+        vec![StackMapLocation {
+            dwarf_reg: DWARF_REG_FP_AARCH64,
+            offset: -8
+        }]
+    );
+    assert_eq!(lazy::DECODE_STEPS.with(|s| s.get()), 1);
+}
+
+#[test]
+fn unsorted_late_duplicate_offset_keeps_every_native_root() {
+    let mut rows = records(500, -8);
+    rows[2] = (16, vec![(DWARF_REG_FP_AARCH64, -16)]);
+    rows[401] = (16, vec![(DWARF_REG_FP_AARCH64, -24)]);
+    let ix = index(&[(0x1000, 64, rows)]);
+    lazy::DECODE_STEPS.with(|s| s.set(0));
+    let found = matched(&ix, 0x1010);
+    assert_eq!(found.len(), 2);
+    assert_eq!(
+        found.iter().map(|r| r.1[0].offset).collect::<Vec<_>>(),
+        [-16, -24]
+    );
+    assert_eq!(lazy::DECODE_STEPS.with(|s| s.get()), 402);
+}
+
+#[test]
+fn folded_functions_keep_all_roots_from_both_sections() {
+    let mut first = records(600, -8);
+    first[1].0 = 16;
+    let mut second = records(900, -16);
+    second[30].0 = 16;
+    let a = Box::leak(lazy::test_blob_multi(&[(0x1000, 64, first)]).into_boxed_slice());
+    let b = Box::leak(lazy::test_blob_multi(&[(0x1000, 64, second)]).into_boxed_slice());
+    let ix = build_index_from_sections_lazy(vec![a, b]);
+    lazy::DECODE_STEPS.with(|s| s.set(0));
+    let mut found = matched(&ix, 0x1010);
+    found.sort_by_key(|r| r.1[0].offset);
+    assert_eq!(
+        found.iter().map(|r| r.1[0].offset).collect::<Vec<_>>(),
+        [-16, -8]
+    );
+    assert_eq!(lazy::DECODE_STEPS.with(|s| s.get()), 62);
+}
+
+#[test]
+fn equally_near_offsets_preserve_existing_stream_order_tie() {
+    let ix = index(&[(
+        0x1000,
+        64,
+        vec![
+            (32, vec![(DWARF_REG_FP_AARCH64, -8)]),
+            (0, vec![(DWARF_REG_FP_AARCH64, -16)]),
+            (64, vec![(DWARF_REG_FP_AARCH64, -24)]),
+        ],
+    )]);
+    lazy::DECODE_STEPS.with(|s| s.set(0));
+    let found = matched(&ix, 0x1010);
+    assert_eq!(found.len(), 1);
+    assert_eq!(found[0].1[0].offset, -8);
+    assert_eq!(lazy::DECODE_STEPS.with(|s| s.get()), 1);
+}
+
+#[test]
+#[should_panic(expected = "does not decode")]
+fn malformed_selected_prefix_still_fails_closed() {
+    let mut bytes =
+        lazy::test_blob_multi(&[(0x1000, 64, vec![(16, vec![(DWARF_REG_FP_AARCH64, -8)])])]);
+    let stream_at = 16 + 12 + 4 + 4;
+    bytes[stream_at] = 1; // Repeat without a previous root payload.
+    let bytes = Box::leak(bytes.into_boxed_slice());
+    let ix = build_index_from_sections_lazy(vec![bytes]);
+    let _ = matched(&ix, 0x1010);
+}
