diff --git a/crates/perry-runtime/src/gc/tests/minor_lazy_rss.rs b/crates/perry-runtime/src/gc/tests/minor_lazy_rss.rs
new file mode 100644
index 0000000000..5ce7a40ea8
--- /dev/null
+++ b/crates/perry-runtime/src/gc/tests/minor_lazy_rss.rs
@@ -0,0 +1,65 @@
+use super::super::*;
+use super::support::*;
+
+thread_local! {
+    static RSS_READS: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+pub(crate) fn note_read() {
+    RSS_READS.with(|reads| reads.set(reads.get() + 1));
+}
+
+#[test]
+fn successful_copying_minor_does_not_query_fallback_rss() {
+    std::thread::spawn(|| {
+        let _guard = CopyingNurseryTestGuard::new(1);
+        let _trigger_guard = GcTriggerThresholdTestGuard::suppress_automatic_triggers();
+        let _diag = GcDiagTestGuard::force_on();
+        let bytes = b"lazy_rss_copied_root";
+        let young = crate::string::js_string_from_bytes(bytes.as_ptr(), bytes.len() as u32);
+        js_shadow_slot_set(0, string_bits(young as usize));
+        RSS_READS.with(|reads| reads.set(0));
+
+        let trace = collect_minor_trace(GcTriggerKind::Direct);
+        assert_copied_minor_trace(&trace, true, CopiedMinorFallbackReason::None, false);
+        assert!(trace.copying_nursery.copied_objects > 0);
+        let survivor = (js_shadow_slot_get(0) & POINTER_MASK) as usize;
+        assert_ne!(survivor, young as usize);
+        unsafe { assert_string_bytes(survivor as *const crate::StringHeader, bytes) };
+        assert_eq!(RSS_READS.with(std::cell::Cell::get), 0);
+    })
+    .join()
+    .unwrap();
+}
+
+#[test]
+fn pinned_minor_fallback_still_samples_rss_and_preserves_root() {
+    std::thread::spawn(|| {
+        let _guard = CopyingNurseryTestGuard::new(1);
+        let _trigger_guard = GcTriggerThresholdTestGuard::suppress_automatic_triggers();
+        let _diag = GcDiagTestGuard::force_on();
+        let bytes = b"lazy_rss_pinned_root";
+        let young = crate::string::js_string_from_bytes(bytes.as_ptr(), bytes.len() as u32);
+        js_shadow_slot_set(0, string_bits(young as usize));
+        unsafe { pin_object(header_from_user_ptr(young as *const u8)) };
+        RSS_READS.with(|reads| reads.set(0));
+
+        let trace = collect_minor_trace(GcTriggerKind::Direct);
+        assert_copied_minor_trace(
+            &trace,
+            false,
+            CopiedMinorFallbackReason::PinnedYoungRoot,
+            false,
+        );
+        assert_eq!(RSS_READS.with(std::cell::Cell::get), 1);
+        #[cfg(any(target_os = "linux", target_os = "macos"))]
+        assert!(trace.evacuation_policy.snapshot.rss_bytes > 0);
+        assert_eq!((js_shadow_slot_get(0) & POINTER_MASK) as usize, young as usize);
+        unsafe {
+            assert_string_bytes(young, bytes);
+            unpin_object(header_from_user_ptr(young as *const u8));
+        }
+    })
+    .join()
+    .unwrap();
+}
