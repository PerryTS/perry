  "behavior": {
    "query": "DriverClient::retained_origins returns native invocation IDs from queued/unpublished replies, conservative guest-root bindings and captured host-future leases. No Store borrow or JS heap data is exposed.",
    "bounds": "A real 512-call workload with its oldest post-return task still active keeps at most eight retained origins and releases more than 500 completed origins before global quiescence. This is a tested workload bound, not a universal task count limit.",
    "conservativeness": "A completed root binding may remain until the engine reuses its task ID or the Store becomes quiescent. This query is not a per-task exit signal; embeddings separately retain context for results they have not consumed.",
    "leases": "Capture before yielding off the guest fiber. Scope restoration applies on every poll and on Drop; the inner future and borrowed dispatch jobs are destroyed before releasing their capture lease.",
    "retirement": "Dropping StoreData::Origins clears guest roots. Deferred captures remain in the registry until their future cleanup finishes, including cleanup before first poll and cleanup after Store retirement.",
    "isolation": "A fallback current invocation is accepted only when already owned by that component registry; legacy calls without registered roots keep their no-origin behavior.",
    "recovery": "Dropping a previously recovered driver cannot clear a restarted Host\u2019s live origin bindings.",
    "runtime": "The registry contains IDs and counts only. No TypeScript frame allocation, ALS snapshots, first-JS-error routing or owned wrapper GC is implemented by this milestone."
  },
