  "subjects": [
    "ffi_driver_core_start_defers_async_import_failure_to_the_first_poll",
    "ffi_driver_async_core_start_resolves_without_any_export_invocation"
  ],
  "assertions": [
    "Synchronous core-start imports use constructor context at origin zero.",
    "Async core-start imports are accepted at instantiation but execute under a fresh first-poll context.",
    "No export invocation is needed to suspend and resolve the import.",
    "Pending embedding reply channels keep active true even if Wasmtime reports its unobserved subtask quiescent.",
    "Successful resolution returns the driver to idle without replaying a constructor frame or callback.",
    "Initialization callback failure retires the Store and reports failed origin zero."
  ],
