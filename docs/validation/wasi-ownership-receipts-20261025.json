  "protocol": [
    "Persistent C lower events optionally include guestTransferred and asyncTransferred arrays of native Store-local tokens.",
    "Host created/transferred ResourceRefs retain their existing shape. One callback validates the whole transaction before native ownership changes.",
    "No event is published for a later-invalid aggregate member; rejection leaves original resource/future ownership available for retry.",
    "Native-only future clients may omit the lifecycle callback and its deallocator.",
    "Async import-result transfer waits for accepted borrowers and reports the original invocation under fresh poll context."
  ],
  "developmentCorrections": [
    "v294 used a stale deliberately failing wac dependency despite positive source bytes; checks now clean wac-graph explicitly as well as engine/WIT.",
    "v295 corrected strict nested core memory reference syntax in the owned WASI import-result fixture.",
    "v296 all175 tests passed; Clippy required direct State field initialization in the callback-free client test; corrected in v297."
  ],
  "unchanged": [
    "All runtime, ABI and vendored encoder sources match the preceding borrow-interop qualification.",
    "Shipping lock and manifests match the preceding qualification, including its open crypto-bigint advisory and cargo-deny pass.",
    "No dependency or dependency-soak exception was added."
  ],
  "remaining": [
    "Persistent TypeScript FrameBatch/ALS/error and native receipt consumption.",
    "Owned future/stream wrappers, producers and GC command integration.",
    "Persistent HTTP integration and canonical async initialization/guest adapter qualification.",
    "Other platforms, released Turnloop adoption, final combined package/moving-GC qualification and existing lint/security debt."
  ],
