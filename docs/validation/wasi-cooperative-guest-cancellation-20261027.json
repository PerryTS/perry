      "repair": "use exact generated TypeScript keys; v422 ordinary normal/moving/import modes pass"
    },
    {
      "snapshot": "v422 caller only",
      "failure": "C caller passed direct parameters but maintained async backend requires *_args_t pointers",
      "repair": "retain generated argument records in C state; compile corrected v423 caller against unchanged frozen v422 generator/native probes and Perry guest",
      "qualification": "v423 runs generate/link/compose/normal/moving; v422 main caller link failure is retained as prototype evidence, not reported as a passing end-to-end script"
    }
  ],
  "limitations": [
    "hidden Rust/example generator only; public --guest-c async output remains rejected",
    "guest resources and public future/stream values remain rejected",
    "actual cooperative cancellation covers a started pre-return task with two pending native imports; pre-start cancellation and successful-return races are not separately forced in execution",
    "native DriverCall cancellation and traps still retire the whole Store",
    "WASI AsyncLocalStorage constructor/link gap remains; ALS task snapshots are qualified by native runtime tests",
    "guest checkpoints exclude timers and foreign native I/O",
    "no new full native compiler/runtime/stdlib/engine distribution set or macOS/Windows/package qualification",
    "no strict TypeScript fixture check",
    "inherited address/root-holder/file-size failures are byte-identical; no new waivers"
  ],
  "next": [
    "resource ownership across generated async calls and cancellation",
    "future/stream guest adapters and ownership",
    "WASI ALS constructor/link packaging",
    "broader value/layout/cancellation profiles, cross-platform and final distribution qualification"
