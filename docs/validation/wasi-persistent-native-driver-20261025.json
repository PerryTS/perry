  "driverSubjects": [
    "concurrent_calls_keep_their_origins_when_completed_in_reverse_order",
    "results_return_before_background_tasks_exit_and_driver_keeps_polling_imports",
    "preflight_errors_and_cancelled_queued_calls_leave_the_component_reusable",
    "dropping_started_calls_retires_store_and_cancels_native_imports",
    "a_failed_import_retires_sibling_calls_and_restores_embedding_context",
    "queue_quota_survives_cancellation_and_is_released_when_requests_are_drained",
    "dropping_last_client_with_background_work_retires_the_component",
    "synchronous_import_dispatch_preserves_each_suspended_call_origin",
    "overlapping_calls_cannot_replenish_the_shared_guest_fuel_budget",
    "quiescence_replenishes_fuel_for_a_later_independent_call",
    "reused_task_indices_do_not_replace_an_older_background_invocation",
    "a_post_return_import_failure_is_reported_by_the_persistent_driver",
    "an_idle_driver_is_woken_by_submission_and_by_native_import_readiness"
  ],
  "behavior": {
    "entryPoint": "Host::into_driver returns Driver and DriverClient; DriverClient::call returns DriverCall",
    "ownerThread": "Rc-backed endpoint and driver; native callbacks and polling assert the creating thread",
    "background": "one persistent run_concurrent continues imports after task.return publishes an exported result",
    "invocationIdentity": "global opaque numeric InvocationId, native GuestTaskId registry, capture oldest registered ancestor before yielding, restore scope per poll and cancelled import future drop",
    "queuedRequests": 64,
    "queuedCancellation": "cancelled requests retain permits until removed from the mailbox",
    "startedCancellation": "retire Store from outer driver poll before re-entering Wasmtime",
    "errors": "pending reply registry retains original diagnostic when Store-wide failure drops Wasmtime call futures",
    "fuel": "one budget for overlapping/post-return guest work; replenished only on quiescence",
    "idle": "is_active false for idle mailbox; actual submission and native import readiness wake the embedding",
    "taskReuseRegressionCalls": 80,
    "legacy": "TypeScript FFI stays on its existing single-call ABI; legacy hosts skip guest ancestry lookup when no native driver roots are registered"
  },
  "validationDependencyOverride": "Only validation locks/config use immutable Turnloop paths. No released registry dependency or shipping package claim.",
  "notQualified": [
    "TypeScript per-invocation callback/cleanup frames and ALS routing",
