    "ffi_driver_resource_disposal_preserves_nominal_identity_and_ignores_transferred_collectors",
    "ffi_driver_foreign_disposal_preflight_and_discarded_cleanup_observer_keep_owners_distinct",
    "ffi_driver_resource_destructor_failure_retires_store_and_preserves_original_origin",
