  "behavior": {
    "types": "AsyncValueType handles retain Store identity, adapter index and WIT payload aliases; foreign types reject before queueing. Actual instantiated types remain private and resource-aware.",
    "api": [
      "DriverClient::async_value_types",
      "DriverClient::create_async_value",
      "DriverClient::write_async_value",
      "DriverClient::cancel_async_write",
      "DriverClient::close_async_writer",
      "DriverClient::abort_async_writer"
    ],
    "factory": "Create {value,writer} descriptors with private nonce/counter tokens. Reserve both endpoints before running the canonical factory. Core writer integers never enter the application transport.",
    "write": "Bounded 1..65536-element writes; futures take exactly one element; void/unit values use null placeholders. Return {written,remaining,cancelled,closed}. Transactional lowering validates every owned resource and nested async value before commit.",
    "ownership": "After canonical transfer, unconsumed values lift with fresh owned descriptors; preflight failure and skipped queued writes preserve original owners. Consumed prefixes are never disposed with remaining suffixes.",
    "cancellation": "Submission-time intent wins before semantic commit even after helper return. Cancellation returns remaining ownership for retry; stream close disposes it and closes writable continuation. Accepted controls survive observer drop.",
    "operationIdentity": "Delayed cancellation only targets operation IDs registered at submission; a subsequent retry is not cancelled by an older request.",
    "abort": "Explicit producer abort validates ownership then retires only that Store; dropping a started write observer also retires it. Future writer close is rejected before setting cancellation intent; completion or explicit abort is required.",
    "quota": "1024 live readable/writer descriptors plus in-flight factory reservations, 64 outstanding commands; 512 concurrent pairs fill the live quota and excess factories reject without orphaning ends.",
    "lifecycle": "Quiescent Host recovery and restarting the driver retain writer metadata. Immutable adapter metadata is shared by Arc across read/write operations.",
    "guests": "Real canonical guest reads consume factory-created futures returned by a host import or passed to an async export, including own<resource> defined by that guest; invocation origin and exact nominal identity survive.",
    "payloads": "Compound wide integer/Unicode/65,537 bytes, nested futures, unit streams with 3/3/1 partial writes, resource cancellation/retry, unread peer closure and independent prefix/remainder destruction.",
    "legacy": "TypeScript remains on its existing single-call ABI. Generic TypeScript methods are declarations only until per-invocation frames, wrappers and GC ownership are wired."
  },
