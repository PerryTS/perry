  "behavior": {
    "submission": "Queue-only owned JSON snapshot; decimal-string invocation ID; no Store borrow or guest/embedding code. Callback submission can execute in the same outer poll. Recursive poll/dispose is rejected before borrowing Store.",
    "operations": [
      "call",
      "read",
      "close",
      "create",
      "write",
      "cancel-write",
      "close-writer",
      "abort-writer"
    ],
    "callbacks": "Explicit u64 invocation origin plus current-poll context token. Force embedding-stack Dispatcher for persistent instances including synchronous WIT worlds; initialize using async linker when dispatcher is present.",
    "poll": "Native completed events, conservative retained IDs, active/retired state and driver error. Drain replies before pruning invocation contexts; retention is not task completion. Null output or missing contexts rejects before execution.",
    "errors": "Ordered deduplicated failedOrigins includes async rejection channel origin; original operation error survives throwing retirement cleanup. Cleanup uses current cleanup context, component-wide origin zero.",
    "ownership": "Real C transport test exchanges compound wide-integer/Unicode/bytes future payload and a partial string stream. Native tokens retain existing actual type checks and transactional ownership.",
    "cancellation": "Discarding a queued observer skips its request; dropping a started observer requests Store retirement. Accepted soft controls remain executable.",
    "lifetime": "Explicit dispose reports RELEASED_ERROR for a failing embedding destructor; native host_drop invokes no embedding callbacks. Fresh context tokens are reset after each call.",
    "legacy": "Retain legacy constructors and entry points within matching ABI9 table; reject execution/resource/HTTP operations against persistent handles. No TypeScript runtime switch in this slice."
  },
  "limitations": [
    "TypeScript per-origin traced frames, ALS/first-JS-error routing, owned future/stream wrappers and producer interfaces remain unfinished.",
    "Deferred resource collection and HTTP have not migrated to persistent driver commands; legacy runtime/HTTP behavior retained.",
    "Current Linux engine/runtime regression checks do not qualify current combined compiler/static archives, moving GC, guest async adapters, other platforms or final packages.",
    "Turnloop provider sources remain immutable validation patches; no releases performed.",
    "Shipping-lock crypto-bigint RUSTSEC-2026-0387 remains open; manifest and shipping lock unchanged; no audit waiver or publish-age override.",
    "Full goal remains active; no readiness, release or merge authorization inferred."
  ],
