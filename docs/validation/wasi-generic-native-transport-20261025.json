    "pending_read_close_wakes_control_and_reuses_store_after_producer_finishes",
    "queued_close_cannot_be_cancelled_by_dropping_its_observer",
    "close_submitted_from_producer_completion_discards_a_copied_owned_payload_once",
    "close_from_post_return_cleanup_wins_before_read_commit_and_drops_payload_once",
    "rejected_close_at_mailbox_quota_does_not_cancel_a_pending_read",
