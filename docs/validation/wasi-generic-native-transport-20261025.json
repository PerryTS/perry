  ],
  "behavior": {
    "composition": "Validate original first; compose whole original and canonical helpers using wac-graph 0.12.0; actual imports/exports preserve nominal resource identities and pruned provider names.",
    "nativeApi": "DriverClient::read_async_value and close_async_value; future/stream descriptors can transfer as export arguments and imported results; exact instantiated type metadata retained at every nested payload.",
    "ownership": "Store-local nonce plus checked monotonic tokens; preflight kind, type, busy state, foreign and duplicate transfers before commit; no FutureReader<Val> assumption.",
    "quotas": "1024 live descriptors, 64 outstanding commands, stream capacity 1..65536 and future capacity 1; helper memory/instances share Store limits.",
    "cancellation": "Reserve native signal before Wasm; submission intent wins before semantic result commit even after helper returns; dispose copied owned values through original nominal resource types; close continuation; accepted close survives observer drop.",
    "memory": "Shared maintained canonical layout DAG; cleanup skips scalar-only list elements while still freeing each buffer; 3,145,865 bytes plus Unicode and owned resource passes at unchanged 100-million fuel.",
    "stream": "Preserve final partial chunks and unit counts; next read reports EOF; nested futures survive outer canonical cleanup.",
    "legacy": "Components with generic async values require the persistent Rust driver; legacy call/call_async reject before executing guest exports. TypeScript read methods are still declarations only."
  },
