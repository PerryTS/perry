msgstr ""

#: src/ui/dialogs.md:69
msgid ""
"```typescript\n"
"function confirmDelete(): void {\n"
"    alertWithButtons(\n"
"        \"Delete Item?\",\n"
"        \"This action cannot be undone.\",\n"
"        [\"Cancel\", \"Delete\"],\n"
"        (index: number) => {\n"
