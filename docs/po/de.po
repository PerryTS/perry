"  ja: \"Due: 2026/03/22\"\n"
"\n"
"LongDate\n"
"  en: \"Event: March 22, 2026\"\n"
"  de: \"Event: 22. März 2026\"\n"
"  fr: \"Event: 22. mars 2026\"\n"
"```"
msgstr ""
"```text\n"
"ShortDate\n"
"  en: \"Due: 3/22/2026\"\n"
"  de: \"Due: 22.03.2026\"\n"
"  ja: \"Due: 2026/03/22\"\n"
"\n"
"LongDate\n"
"  en: \"Event: March 22, 2026\"\n"
"  de: \"Event: 22. März 2026\"\n"
"  fr: \"Event: 22. mars 2026\"\n"
"```"

