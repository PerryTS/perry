#: src/native-libraries/manifest-v1.md:50
msgid "Top-level shape"
msgstr "Top-Level-Form"

#: src/native-libraries/manifest-v1.md:52
msgid ""
"```jsonc\n"
"{\n"
"  \"perry\": {\n"
"    \"nativeLibrary\": {\n"
"      // Required from v0.6.0; warning-only in v0.5.x.\n"
"      \"abiVersion\": \"0.5\",\n"
"\n"
"      // FFI function declarations — what TypeScript-side\n"
"      // call sites bind to. See \"Functions\" below.\n"
"      \"functions\": [\n"
"        { \"name\": \"js_my_thing\", \"params\": [\"string\"], \"returns\": "
"\"string\" }\n"
"      ],\n"
"\n"
"      // Per-target build configuration. Optional; if omitted, no\n"
"      // crate is built and the wrapper is purely a `.d.ts`-style\n"
"      // declaration of pre-built symbols (rare).\n"
"      \"targets\": {\n"
"        \"macos\":     { \"...\": \"...\" },\n"
"        \"ios\":       { \"...\": \"...\" },\n"
"        \"linux\":     { \"...\": \"...\" },\n"
"        \"windows\":   { \"...\": \"...\" },\n"
"        \"android\":   { \"...\": \"...\" },\n"
"        \"web\":       { \"...\": \"...\" },\n"
"        \"harmonyos\": { \"...\": \"...\" },\n"
"        \"tvos\":      { \"...\": \"...\" },\n"
"        \"watchos\":   { \"...\": \"...\" },\n"
"        \"visionos\":  { \"...\": \"...\" }\n"
"      }\n"
"    }\n"
"  }\n"
"}\n"
"```"
msgstr ""
"```jsonc\n"
"{\n"
"  \"perry\": {\n"
"    \"nativeLibrary\": {\n"
"      // Ab v0.6.0 erforderlich; in v0.5.x nur als Warnung.\n"
"      \"abiVersion\": \"0.5\",\n"
"\n"
"      // FFI-Funktionsdeklarationen — an was TypeScript-seitige\n"
"      // Aufrufstellen gebunden werden. Siehe \"Functions\" unten.\n"
"      \"functions\": [\n"
"        { \"name\": \"js_my_thing\", \"params\": [\"string\"], \"returns\": "
"\"string\" }\n"
"      ],\n"
"\n"
"      // Zielspezifische Build-Konfiguration. Optional; wenn weggelassen,\n"
"      // wird kein Crate gebaut und der Wrapper ist rein eine `.d.ts`-"
"artige\n"
"      // Deklaration vorgefertigter Symbole (selten).\n"
"      \"targets\": {\n"
"        \"macos\":     { \"...\": \"...\" },\n"
"        \"ios\":       { \"...\": \"...\" },\n"
"        \"linux\":     { \"...\": \"...\" },\n"
"        \"windows\":   { \"...\": \"...\" },\n"
"        \"android\":   { \"...\": \"...\" },\n"
"        \"web\":       { \"...\": \"...\" },\n"
"        \"harmonyos\": { \"...\": \"...\" },\n"
"        \"tvos\":      { \"...\": \"...\" },\n"
"        \"watchos\":   { \"...\": \"...\" },\n"
"        \"visionos\":  { \"...\": \"...\" }\n"
"      }\n"
"    }\n"
"  }\n"
"}\n"
"```"

