#: src/container/determinism.md:64
msgid ""
"The four mechanisms compose. The most common production pattern combines (4) "
"and (3):"
msgstr ""
"Die vier Mechanismen bilden sich zusammen. Das häufigste Produktionsmuster "
"kombiniert (4) und (3):"

#: src/container/determinism.md:66
msgid ""
"```typescript,no-test\n"
"import { selectBackendFor, setBackend, up } from 'perry/container';\n"
"\n"
"const best = JSON.parse(selectBackendFor(JSON.stringify(spec))) as string;\n"
"// privileged: true rules out apple/container → returns \"docker\"\n"
"// trivial spec on macOS → returns \"apple/container\"\n"
"\n"
"await setBackend(best);\n"
"await up(spec);\n"
"```"
msgstr ""
"```typescript,no-test\n"
"import { selectBackendFor, setBackend, up } from 'perry/container';\n"
"\n"
"const best = JSON.parse(selectBackendFor(JSON.stringify(spec))) as string;\n"
"// privileged: true rules out apple/container → returns \"docker\"\n"
"// trivial spec on macOS → returns \"apple/container\"\n"
"\n"
"await setBackend(best);\n"
"await up(spec);\n"
"```"

