#: src/ui/layout.md:119
msgid "Nesting Layouts"
msgstr "Layouts verschachteln"

#: src/ui/layout.md:121
msgid "Layouts can be nested freely. This complete example is verified by CI:"
msgstr ""
"Layouts können beliebig verschachtelt werden. Dieses vollständige Beispiel "
"wird von CI verifiziert:"

#: src/ui/layout.md:123
msgid ""
"```typescript\n"
"// demonstrates: nested VStack/HStack + Spacer + Divider\n"
"// docs: docs/src/ui/layout.md\n"
"// platforms: macos, linux, windows\n"
"// targets: ios-simulator, web, wasm\n"
"\n"
"import { App, VStack, HStack, Text, Button, Spacer, Divider } from \"perry/"
"ui\"\n"
"\n"
"App({\n"
"    title: \"Layout Example\",\n"
"    width: 800,\n"
"    height: 600,\n"
"    body: VStack(16, [\n"
"        // Header\n"
"        HStack(8, [\n"
"            Text(\"My App\"),\n"
"            Spacer(),\n"
"            Button(\"Settings\", () => {}),\n"
"        ]),\n"
"        Divider(),\n"
"        // Content\n"
"        VStack(12, [\n"
"            Text(\"Welcome!\"),\n"
"            HStack(8, [\n"
"                Button(\"Action 1\", () => {}),\n"
"                Button(\"Action 2\", () => {}),\n"
"            ]),\n"
"        ]),\n"
"        Spacer(),\n"
"        // Footer\n"
"        Text(\"v1.0.0\"),\n"
"    ]),\n"
"})\n"
"```"
msgstr ""
"```typescript\n"
"// demonstrates: nested VStack/HStack + Spacer + Divider\n"
