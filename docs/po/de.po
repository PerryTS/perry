"\n"
"const text = State(\"\")\n"
"const field = TextField(\"Placeholder...\", (value: string) => "
"text.set(value))\n"
"stateBindTextfield(text, field) // programmatic text.set() also updates the "
"field\n"
"\n"
"App({\n"
"    title: \"TextField\",\n"
"    width: 400,\n"
"    height: 200,\n"
"    body: VStack(12, [\n"
"        field,\n"
"        Text(`You typed: ${text.value}`),\n"
"    ]),\n"
"})\n"
"```"
