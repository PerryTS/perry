"    webviewLoadUrl,\n"
"    webviewReload,\n"
"    webviewGoBack,\n"
"    webviewGoForward,\n"
"    webviewCanGoBack,\n"
"    webviewEvaluateJs,\n"
"    webviewClearCookies,\n"
"} from \"perry/ui\"\n"
"```"
msgstr ""
"```ts\n"
"import {\n"
"    WebView,\n"
"    webviewLoadUrl,\n"
"    webviewReload,\n"
"    webviewGoBack,\n"
