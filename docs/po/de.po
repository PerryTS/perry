"            if ((i & 0xff) === 0) count++\n"
"        }\n"
"        return { count }\n"
"    })\n"
"\n"
"    result.set(`Found ${data.count} patterns`)\n"
"    status.set(\"Done\")\n"
"})\n"
"```"
