msgid "\"modules\""
msgstr "\"Module\""

#: src/cli/perry-audit-sbom.md:50
msgid "\"/repo/main.ts\""
msgstr "\"/repo/main.ts\""

#: src/cli/perry-audit-sbom.md:52
msgid "\"stdlib\""
msgstr "\"stdlib\""

#: src/cli/perry-audit-sbom.md:53
msgid "\"fs\""
msgstr "\"fs\""

#: src/cli/perry-audit-sbom.md:53
