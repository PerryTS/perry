#: src/stdlib/container.md:30 src/container/compose.md:12
msgid ""
"```typescript\n"
"import { up } from \"perry/compose\";\n"
"\n"
"async function bringUpSimpleStack(): Promise<void> {\n"
"    const stack = await up({\n"
"        version: \"3.8\",\n"
"        services: {\n"
"            cache: {\n"
"                image: \"redis:7-alpine\",\n"
"                ports: [\"6379:6379\"],\n"
"                networks: [\"app-net\"],\n"
"                healthcheck: {\n"
"                    test: [\"CMD\", \"redis-cli\", \"PING\"],\n"
"                    interval: \"5s\",\n"
"                    timeout: \"3s\",\n"
"                    retries: 6,\n"
"                },\n"
"            },\n"
"        },\n"
"        networks: {\n"
"            \"app-net\": { driver: \"bridge\" },\n"
"        },\n"
"    });\n"
"    // `stack` is an opaque handle (NaN-boxed integer) — pass it as\n"
"    // the first arg to `down` / `ps` / `logs` / `exec`.\n"
"    console.log(`stack handle: ${String(stack)}`);\n"
"}\n"
"```"
msgstr ""
"```typescript\n"
"import { up } from \"perry/compose\";\n"
"\n"
"async function bringUpSimpleStack(): Promise<void> {\n"
"    const stack = await up({\n"
"        version: \"3.8\",\n"
"        services: {\n"
"            cache: {\n"
"                image: \"redis:7-alpine\",\n"
"                ports: [\"6379:6379\"],\n"
"                networks: [\"app-net\"],\n"
"                healthcheck: {\n"
"                    test: [\"CMD\", \"redis-cli\", \"PING\"],\n"
"                    interval: \"5s\",\n"
"                    timeout: \"3s\",\n"
"                    retries: 6,\n"
"                },\n"
"            },\n"
"        },\n"
"        networks: {\n"
"            \"app-net\": { driver: \"bridge\" },\n"
"        },\n"
"    });\n"
"    // `stack` est un handle opaque (entier NaN-boxé) — passez-le comme\n"
"    // premier argument à `down` / `ps` / `logs` / `exec`.\n"
"    console.log(`stack handle: ${String(stack)}`);\n"
"}\n"
"```"

#: src/stdlib/container.md:59 src/container/compose.md:227
msgid ""
"```typescript\n"
"import { down } from \"perry/compose\";\n"
"\n"
"async function tearDown(stack: number): Promise<void> {\n"
"    // Default: containers + networks removed; named volumes preserved\n"
"    // so a subsequent `up()` against the same spec resumes from\n"
"    // committed state.\n"
"    await down(stack);\n"
"\n"
"    // Pass `volumes: true` to also drop named volumes — DESTROYS DATA.\n"
"    // Useful for test teardown or for a \"rip and replace\" redeploy.\n"
"    await down(stack, { volumes: true });\n"
"}\n"
"```"
msgstr ""
"```typescript\n"
"import { down } from \"perry/compose\";\n"
"\n"
"async function tearDown(stack: number): Promise<void> {\n"
"    // Par défaut : conteneurs + réseaux supprimés ; volumes nommés "
"préservés\n"
"    // afin qu'un `up()` ultérieur avec la même spec reprenne depuis\n"
"    // l'état persisté.\n"
"    await down(stack);\n"
"\n"
"    // Passez `volumes: true` pour supprimer également les volumes nommés — "
"DÉTRUIT LES DONNÉES.\n"
"    // Utile pour le nettoyage de tests ou un redéploiement complet.\n"
"    await down(stack, { volumes: true });\n"
"}\n"
"```"

