msgstr "Retour de nettoyage pas encore câblé."

#: src/tui/hooks.md:173
msgid "`useMemo(fn, [])`"
msgstr "`useMemo(fn, [])`"

#: src/tui/hooks.md:174
msgid "`useRef(0)`"
msgstr "`useRef(0)`"

#: src/tui/hooks.md:174
msgid "`.get()`/`.set(v)` instead of `.current`."
msgstr "`.get()`/`.set(v)` à la place de `.current`."

#: src/tui/hooks.md:175
