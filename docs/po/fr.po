msgstr "Perry = empreinte digitale de l' oracle"

#: src/testing/node-compat-matrix.md:102
msgid "`shape-diff`"
msgstr "`shape-diff`"

#: src/testing/node-compat-matrix.md:102
msgid "both resolved, fingerprints differ (a real shape gap)"
msgstr ""
"les deux résolus, les empreintes digitales diffèrent (un écart de forme "
"réelle)"

