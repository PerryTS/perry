"function registerFilter(api: PluginApi) {\n"
"    api.registerHook(\"transform\", (data: any) => {\n"
"        data.content = data.content.toUpperCase()\n"
"        return data // Returned data goes to next plugin\n"
"    })\n"
"}\n"
"```"
