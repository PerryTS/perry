msgstr "AArch64/arm64 64 bits et x86-64, y compris x86-64 Windows"

#: src/internals/garbage-collector.md:111
msgid "LLVM RS4GC statepoints plus Perry's compact native stack map"
msgstr ""
"Les points d'état RS4GC de LLVM plus la carte de pile native compacte de "
