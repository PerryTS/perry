"    const task1 = spawn(() => {\n"
"        let acc = 0\n"
"        for (const v of dataA) acc += v * v\n"
"        return acc\n"
"    })\n"
"    const task2 = spawn(() => {\n"
"        let acc = 0\n"
"        for (const v of dataB) acc += v * v\n"
"        return acc\n"
"    })\n"
"    const task3 = spawn(() => {\n"
