msgstr "onHover"

#: src/ui/events.md:29
msgid "Triggered when the cursor enters the widget."
msgstr "Déclenché lorsque le curseur entre dans le widget."

#: src/ui/events.md:31
msgid ""
"```typescript\n"
"const hoverBtn = Button(\"Hover me\", () => {})\n"
"widgetSetOnHover(hoverBtn, () => {\n"
"    log.set(\"hovered\")\n"
"})\n"
"```"
msgstr ""
