msgid ""
"```typescript\n"
"const sections = VStack(12, [\n"
"    Text(\"Section 1\"),\n"
"    Divider(),\n"
"    Text(\"Section 2\"),\n"
"])\n"
"```"
msgstr ""
"```typescript\n"
"const sections = VStack(12, [\n"
