msgstr "`all=true` 包含已停止的容器。"

#: src/container/containers.md:132
msgid "`inspect(id)`"
msgstr "`inspect(id)`"

#: src/container/containers.md:132
msgid "`(id: string) → Promise<ContainerInfo>`"
msgstr "`(id: string) → Promise<ContainerInfo>`"

#: src/container/containers.md:132
