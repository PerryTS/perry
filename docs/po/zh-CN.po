"    const profiles = parallelMap(active, (u: { name: string; score: "
"number }) => ({\n"
"        name: u.name,\n"
"        score: u.score * 2,\n"
"    }))\n"
"\n"
"    console.log(`parallel-filter-combined active=${active.length} profiles=$"
"{profiles.length}`)\n"
"}\n"
"```"
msgstr ""
"```typescript\n"
"function parallelFilterCombined(): void {\n"
"    const users = [\n"
"        { name: \"Alice\", isActive: true, age: 28, score: 90 },\n"
