"openURL(\"https://example.com\")          // Opens in default browser\n"
"const dark = isDarkMode()               // Check appearance\n"
"preferencesSet(\"key\", \"value\")          // NSUserDefaults\n"
"const val = preferencesGet(\"key\")       // NSUserDefaults\n"
"```"

