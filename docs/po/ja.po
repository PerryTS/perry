"    Text(\"Heading\"),\n"
"    Text(\"Subtitle\"),\n"
"    Button(\"Action\", () => { console.log(\"clicked\") }),\n"
"], {\n"
"    backgroundColor: { r: 0.96, g: 0.97, b: 0.99, a: 1.0 },\n"
"    borderRadius: 12,\n"
"    padding: 16,\n"
