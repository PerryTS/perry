#: src/ui/layout.md:233
msgid ""
"```typescript\n"
"const banner = Text(\"Full width banner\")\n"
"widgetMatchParentWidth(banner)\n"
"const banneredPage = VStack(16, [banner, Text(\"Normal width\")])\n"
"```"
msgstr ""
