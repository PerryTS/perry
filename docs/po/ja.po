msgstr "12–14"

#: src/testing/ci-gate-scheduling.md:227
msgid "queued by event"
msgstr "イベントによって並べた"

#: src/testing/ci-gate-scheduling.md:227
msgid "794 `pull_request`, 181 `push`, 19 `schedule`"
msgstr "794 `pull_request`, 181 `push`, 19 `schedule`"

#: src/testing/ci-gate-scheduling.md:228
