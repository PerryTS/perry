"```typescript\n"
"function parallelMapBasic(): void {\n"
"    const numbers = [1, 2, 3, 4, 5, 6, 7, 8]\n"
"    const doubled = parallelMap(numbers, (x: number) => x * 2)\n"
"    // [2, 4, 6, 8, 10, 12, 14, 16]\n"
"    console.log(`parallel-map-basic len=${doubled.length}`)\n"
"}\n"
"```"
