"        blur: 8,\n"
"        offsetY: 2,\n"
"    },\n"
"})\n"
"\n"
"// HStack with no explicit spacing (children-array first form) + style.\n"
"const toolbar = HStack([\n"
"    Text(\"Left\"),\n"
"    Text(\"Right\"),\n"
"], {\n"
"    backgroundColor: { r: 0.2, g: 0.2, b: 0.2, a: 1.0 },\n"
"    padding: { top: 8, right: 16, bottom: 8, left: 16 },\n"
