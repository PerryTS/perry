msgstr "捜索の間には数時間"

#: src/cli/app-updates.md:63
msgid "`notifyInterval`"
msgstr "`notifyInterval`"

#: src/cli/app-updates.md:63
msgid "Minimum hours between two notices about the same version."
msgstr "同じバージョンに関する2つの通知の間の最低時間は"

