"```toml\n"
"[i18n]\n"
"locales = [\"en\", \"de\"]\n"
"default_locale = \"en\"\n"
"```"
msgstr ""
"```toml\n"
"[i18n]\n"
"locales = [\"en\", \"de\"]\n"
"default_locale = \"en\"\n"
