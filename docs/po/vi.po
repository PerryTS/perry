"ui\"\n"
"\n"
"const selected = State(0)\n"
"const picker = Picker((index: number) => selected.set(index))\n"
"pickerAddItem(picker, \"Option A\")\n"
"pickerAddItem(picker, \"Option B\")\n"
"pickerAddItem(picker, \"Option C\")\n"
"\n"
"App({\n"
"    title: \"Picker\",\n"
"    width: 400,\n"
"    height: 200,\n"
"    body: VStack(12, [\n"
