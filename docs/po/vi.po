msgid "Example"
msgstr "Ví dụ"

#: src/widgets/wearos.md:38
msgid ""
"```typescript\n"
"Widget({\n"
"    kind: \"StepsTile\",\n"
"    displayName: \"Steps\",\n"
"    description: \"Daily step count\",\n"
"    supportedFamilies: [\"accessoryCircular\"],\n"
"\n"
"    provider: async () => {\n"
"        return {\n"
"            entries: [{ steps: 7500, goal: 10000 }],\n"
"            reloadPolicy: { after: { minutes: 60 } },\n"
"        }\n"
"    },\n"
"\n"
"    render(entry: { steps: number; goal: number }) {\n"
"        return VStack([\n"
"            Gauge(entry.steps / entry.goal, 1.0),\n"
"            Text(`${entry.steps}`),\n"
"        ])\n"
"    },\n"
"})\n"
"```"
msgstr ""
"```typescript\n"
"Widget({\n"
"    kind: \"StepsTile\",\n"
"    displayName: \"Steps\",\n"
"    description: \"Daily step count\",\n"
"    supportedFamilies: [\"accessoryCircular\"],\n"
"\n"
"    provider: async () => {\n"
"        return {\n"
"            entries: [{ steps: 7500, goal: 10000 }],\n"
"            reloadPolicy: { after: { minutes: 60 } },\n"
"        }\n"
"    },\n"
"\n"
"    render(entry: { steps: number; goal: number }) {\n"
"        return VStack([\n"
"            Gauge(entry.steps / entry.goal, 1.0),\n"
"            Text(`${entry.steps}`),\n"
"        ])\n"
"    },\n"
"})\n"
"```"

