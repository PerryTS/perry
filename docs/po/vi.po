"    const and = big & BigInt(0xFF);\n"
"    const or = big | BigInt(0xFF);\n"
"    const xor = big ^ BigInt(0xFF);\n"
"    const shl = big << BigInt(2);\n"
"    const shr = big >> BigInt(2);\n"
"    const not = ~big;\n"
"\n"
"    console.log(`bigint: result_ok=${result !== null} and_ok=${and !== null} "
"or_ok=${or !== null}`)\n"
"}\n"
"```"

