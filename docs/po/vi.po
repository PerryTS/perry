#: src/platforms/ios.md:67
msgid ""
"```typescript\n"
"import { App, Text, VStack } from \"perry/ui\"\n"
"\n"
"App({\n"
"    title: \"My iOS App\",\n"
"    width: 400,\n"
"    height: 800,\n"
"    body: VStack(16, [\n"
"        Text(\"Hello, iPhone!\"),\n"
"    ]),\n"
"})\n"
"```"
msgstr ""
"```typescript\n"
"import { App, Text, VStack } from \"perry/ui\"\n"
"\n"
