"// Copy to clipboard\n"
"clipboardWrite(\"Hello, clipboard!\")\n"
"\n"
"// Read from clipboard\n"
"const text = clipboardRead()\n"
"log.set(`clipboard length: ${text.length}`)\n"
"```"
msgstr ""
