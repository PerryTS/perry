"        \"macos\":     { \"...\": \"...\" },\n"
"        \"ios\":       { \"...\": \"...\" },\n"
"        \"linux\":     { \"...\": \"...\" },\n"
"        \"windows\":   { \"...\": \"...\" },\n"
"        \"android\":   { \"...\": \"...\" },\n"
"        \"web\":       { \"...\": \"...\" },\n"
"        \"harmonyos\": { \"...\": \"...\" },\n"
"        \"tvos\":      { \"...\": \"...\" },\n"
"        \"watchos\":   { \"...\": \"...\" },\n"
"        \"visionos\":  { \"...\": \"...\" }\n"
"      }\n"
"    }\n"
"  }\n"
"}\n"
