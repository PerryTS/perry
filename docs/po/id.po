"\n"
"const stack = VStack(20, [label, btn])\n"
"setPadding(stack, 20, 20, 20, 20)\n"
"\n"
"App({\n"
"    title: \"Styled Counter\",\n"
"    width: 400,\n"
"    height: 300,\n"
"    body: stack,\n"
"})\n"
"```"

