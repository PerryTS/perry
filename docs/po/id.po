"    const every = nums.every((x) => x > 0);\n"
"    const some = nums.some((x) => x > 2);\n"
"    nums.forEach((x) => console.log(x));\n"
"    const flat = [[1, 2], [3]].flat();\n"
"    const concatted = nums.concat([5, 6]);\n"
"\n"
"    // Array.from\n"
