msgstr "Encoder PNG inline (blok zlib stored)"

#: src/testing/geisterhand.md:265
msgid "Chaos Mode"
msgstr "Mode Chaos"

#: src/testing/geisterhand.md:267
msgid ""
"Chaos mode randomly interacts with widgets at a configurable interval — "
"useful for stress testing, finding edge cases, and crash hunting."
msgstr ""
"Mode chaos berinteraksi dengan widget secara acak pada interval yang dapat "
"dikonfigurasi — berguna untuk stress testing, menemukan edge case, dan "
"berburu crash."

#: src/testing/geisterhand.md:269
msgid "Start"
msgstr "Mulai"

#: src/testing/geisterhand.md:271
msgid ""
"```\n"
"POST /chaos/start\n"
"Content-Type: application/json\n"
"\n"
"{\"interval_ms\": 200}\n"
"```"
msgstr ""
"```\n"
"POST /chaos/start\n"
"Content-Type: application/json\n"
"\n"
"{\"interval_ms\": 200}\n"
"```"

