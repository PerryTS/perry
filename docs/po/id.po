"\n"
"const label = Text(`Count: ${count.value}`)\n"
"textSetFontSize(label, 24)\n"
"textSetColor(label, 0.2, 0.2, 0.2, 1.0)        // RGBA in [0,1] — same as "
"#333333\n"
"\n"
