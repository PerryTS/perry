"  radius: { [key: string]: number };\n"
"  fontSize: { [key: string]: number };\n"
"  borderWidth: { [key: string]: number };\n"
"}\n"
"\n"
"interface ResolvedTheme {\n"
"  colors: { [key: string]: PerryColor };\n"
"  spacing: { [key: string]: number };\n"
"  radius: { [key: string]: number };\n"
"  fontSize: { [key: string]: number };\n"
"  borderWidth: { [key: string]: number };\n"
"}\n"
"```"
