"            Spacer(),\n"
"            Button(\"Settings\", () => {}),\n"
"        ]),\n"
"        Divider(),\n"
"        // Content\n"
"        VStack(12, [\n"
"            Text(\"Welcome!\"),\n"
"            HStack(8, [\n"
"                Button(\"Action 1\", () => {}),\n"
