"const primary = Button(\"Click Me\", () => console.log(\"Clicked!\"))\n"
"buttonSetBordered(primary, 1)\n"
"setCornerRadius(primary, 8)\n"
"\n"
"const disabled = Button(\"Can't click me\", () => {})\n"
"widgetSetEnabled(disabled, 0)\n"
"\n"
