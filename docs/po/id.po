"```typescript\n"
"import { App, Text, VStack } from \"perry/ui\"\n"
"\n"
"App({\n"
"    title: \"My TV App\",\n"
"    width: 1920,\n"
"    height: 1080,\n"
"    body: VStack(16, [\n"
"        Text(\"Hello, Apple TV!\"),\n"
"    ]),\n"
"})\n"
"```"
msgstr ""
"```typescript\n"
"import { App, Text, VStack } from \"perry/ui\"\n"
