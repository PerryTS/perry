msgid ""
"```\n"
"POST /scroll/:handle\n"
"Content-Type: application/json\n"
"\n"
"{\"x\": 0, \"y\": 100}\n"
"```"
msgstr ""
"```\n"
"POST /scroll/:handle\n"
"Content-Type: application/json\n"
"\n"
"{\"x\": 0, \"y\": 100}\n"
"```"

