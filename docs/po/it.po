msgstr "Wrapper di Formattazione"

#: src/i18n/formatting.md:28
msgid "Currency"
msgstr "Currency"

#: src/i18n/formatting.md:30
msgid ""
"Formats a number as currency with the locale's symbol, decimal separator, "
