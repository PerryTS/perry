"// Currency: locale-appropriate symbol, separator, and placement.\n"
"//   en: \"$23.10\"   de: \"23,10 €\"   ja: \"¥23.10\"\n"
"const cur = Currency(23.10)\n"
"console.log(t(\"Total: {price}\", { price: cur }))\n"
"```"
msgstr ""
"```typescript\n"
"// Currency: locale-appropriate symbol, separator, and placement.\n"
"//   en: \"$23.10\"   de: \"23,10 €\"   ja: \"¥23.10\"\n"
