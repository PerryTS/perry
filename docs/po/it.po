"const heart = ImageSymbol(\"heart.fill\")\n"
"const bell = ImageSymbol(\"bell.fill\")\n"
"\n"
"App({\n"
"    title: \"ImageSymbol\",\n"
"    width: 400,\n"
"    height: 200,\n"
"    body: HStack(12, [star, heart, bell]),\n"
"})\n"
"```"

