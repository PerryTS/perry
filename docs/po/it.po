#: src/system/audio_module.md:81
msgid "Three-bus mix template"
msgstr "Template con tre bus"

#: src/system/audio_module.md:83
msgid ""
"```typescript,no-test\n"
"const sfx   = createBus(\"sfx\");\n"
"const music = createBus(\"music\");\n"
"const voice = createBus(\"voice\");\n"
"\n"
"// User-facing sliders bind to these:\n"
