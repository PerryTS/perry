"en: \"Total: $23.10\"\n"
"de: \"Total: 23,10 €\"\n"
"fr: \"Total: 23,10 €\"\n"
"ja: \"Total: ¥23.10\"\n"
"```"
msgstr ""
"```text\n"
"en: \"Total: $23.10\"\n"
"de: \"Total: 23,10 €\"\n"
"fr: \"Total: 23,10 €\"\n"
"ja: \"Total: ¥23.10\"\n"
"```"

#: src/i18n/formatting.md:46
msgid "Percent"
msgstr "Percent"

#: src/i18n/formatting.md:48
msgid "Formats a decimal as a percentage (value is multiplied by 100):"
msgstr ""
