#: src/i18n/formatting.md:156
msgid "Configure default currency codes per locale in `perry.toml`:"
msgstr ""
"Configura i codici valuta predefiniti per localizzazione in `perry.toml`:"

#: src/i18n/formatting.md:158
msgid ""
"```toml\n"
"[i18n]\n"
"locales = [\"en\", \"de\", \"fr\"]\n"
"default_locale = \"en\"\n"
"\n"
