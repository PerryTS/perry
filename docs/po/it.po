msgstr "Attiva una scorciatoia da tastiera"

#: src/testing/geisterhand.md:206
msgid ""
"```\n"
"POST /key\n"
"Content-Type: application/json\n"
"\n"
"{\"shortcut\": \"s\"}\n"
"```"
msgstr ""
"```\n"
"POST /key\n"
"Content-Type: application/json\n"
"\n"
"{\"shortcut\": \"s\"}\n"
"```"

