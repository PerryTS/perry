msgstr "**Grasa: brazo64 + arm64_32**"

#: src/platforms/watchos-app-store.md:19
msgid "\\< 27 (e.g. 10.0)"
msgstr "\\< 27 (e.g. 10.0)"

#: src/platforms/watchos-app-store.md:19
msgid "Every watch from Series 4 to the latest"
msgstr "Cada reloj de la Serie 4 a la última"

#: src/platforms/watchos-app-store.md:20
msgid "arm64-only"
msgstr "arm64-only"

#: src/platforms/watchos-app-store.md:20
