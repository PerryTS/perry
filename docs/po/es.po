"widgetSetEnabled(disabled, 0)\n"
"\n"
"App({\n"
"    title: \"Button\",\n"
"    width: 400,\n"
"    height: 200,\n"
"    body: VStack(12, [primary, disabled]),\n"
"})\n"
"```"
