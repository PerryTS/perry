msgid ""
"```typescript\n"
"const settings = Window(\"Settings\", 500, 400)\n"
"settings.setBody(VStack(16, [\n"
"    Text(\"Settings panel\"),\n"
"]))\n"
"settings.show()\n"
"```"
msgstr ""
