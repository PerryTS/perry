#: src/widgets/watchos.md:28
msgid "The `Gauge` component is designed for watchOS circular complications:"
msgstr ""
"El componente `Gauge` está diseñado para las complicaciones circulares de "
"watchOS:"

#: src/widgets/watchos.md:30
msgid ""
"```typescript\n"
"Widget({\n"
"    kind: \"QuickStats\",\n"
"    displayName: \"Quick Stats\",\n"
"    supportedFamilies: [\"accessoryCircular\", \"accessoryRectangular\"],\n"
"\n"
"    render(entry: { progress: number; label: string }, family) {\n"
"        if (family === \"accessoryCircular\") {\n"
"            return Gauge(entry.progress, 1.0)\n"
"        }\n"
"        return VStack([\n"
"            Text(entry.label),\n"
"            Gauge(entry.progress, 1.0),\n"
"        ])\n"
"    },\n"
"})\n"
"```"
msgstr ""
"```typescript\n"
"Widget({\n"
"    kind: \"QuickStats\",\n"
"    displayName: \"Quick Stats\",\n"
"    supportedFamilies: [\"accessoryCircular\", \"accessoryRectangular\"],\n"
"\n"
"    render(entry: { progress: number; label: string }, family) {\n"
"        if (family === \"accessoryCircular\") {\n"
"            return Gauge(entry.progress, 1.0)\n"
"        }\n"
"        return VStack([\n"
"            Text(entry.label),\n"
"            Gauge(entry.progress, 1.0),\n"
"        ])\n"
"    },\n"
"})\n"
"```"

