"        let count = 0\n"
"        for (let i = 0; i < 1_000_000; i++) {\n"
"            if ((i & 0xff) === 0) count++\n"
"        }\n"
"        return { count }\n"
"    })\n"
"\n"
"    result.set(`Found ${data.count} patterns`)\n"
"    status.set(\"Done\")\n"
"})\n"
"```"

#: src/threading/spawn.md:163
