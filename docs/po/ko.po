"const long = LongDate(now)     // en: \"March 22, 2026\"   de: \"22. März "
"2026\"\n"
"console.log(t(\"Due: {d}\", { d: short }))\n"
"console.log(t(\"Event: {d}\", { d: long }))\n"
"```"
msgstr ""
