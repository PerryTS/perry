# Build artifacts
target/
*.o
*.app/
__pycache__/
*.py[cod]

# Pinned Node oracle for the builtin-module compat matrix
# (scripts/node_compat_matrix.mjs downloads + SRI-verifies + caches here).
.cache/node-pin/
# Pinned WASI SDK/runtime and local acceptance reports.
.cache/wasi/
.cache/wasi-*
# Local receipts for the staged npm release pipeline. These must survive
# between `publish:stage` and `publish:approve`, but must never make a clean
# release-candidate checkout appear dirty or be committed.
.cache/perry/publish-pipeline/

# Android Gradle: caches and build outputs are regenerable. Source under
# android-build/ that we DO track: build.gradle.kts files, gradle wrapper,
# AndroidManifest.xml, Kotlin sources under app/src/main/java, and resources
# under app/src/main/res. Everything below is daemon cache or compiler
# intermediates that churn on every build.
android-build/.gradle/
android-build/build/
android-build/app/build/
android-build/local.properties
android-build/.idea/
android-build/captures/

# Doc-example test reports (generated by scripts/run_doc_tests.sh,
# uploaded as a CI artifact in test.yml — never source)
docs/examples/_reports/

# External demo assets (game project assets the user keeps adjacent for
# perry-ui-* manual testing — not perry source). The publish.rs `assets/`
# references are about the *consumer's* project layout, not perry's repo.
/assets/
benchmarks/suite/assets/

# V2.2 per-module object cache (machine-local: keyed by opts + source hash,
# but the cached .o files bake in host CPU features via clang -mcpu=native /
# -march=native, so sharing across machines with different CPUs can produce
# SIGILL at runtime. Always machine-local, always regenerable.)
.perry-cache/
.feature-matrix/

# `perry compile --trace llvm` dumps per-module .ll files here.
.perry-trace/
# scripts/gc_root_dominance_corpus.sh output (regenerate, never commit)
ir-corpus/

# Compiled test executables in the project root (no extension)
/test_*
/test-*
!/test_*.ts
!/test-*.ts
# Re-include the test source directories
!tests/fixtures/programs/
!tests/
!tests/parity/
!tests/integration/wasi/
# But ignore compiled test binaries (no extension) inside them
tests/fixtures/programs/test_*
tests/fixtures/programs/test-*
!tests/fixtures/programs/test_*.ts
!tests/fixtures/programs/test_*.tsx
!tests/fixtures/programs/test-*.ts
!tests/fixtures/programs/test-*.tsx
# A fixture that must be CommonJS in BOTH runtimes is a `.cts` (this repo's
# package is `"type": "module"`, so a `.ts` is strict-mode ESM for Node and for
# Perry alike). Without these it would be an ignored file — a DARK TEST, the
# exact failure mode `scripts/check_test_registration.py` exists to prevent.
!tests/fixtures/programs/test_*.cts
!tests/fixtures/programs/test_*.mts
!tests/fixtures/programs/test-*.cts
!tests/fixtures/programs/test-*.mts
!tests/fixtures/programs/*/
tests/integration/test_*
tests/integration/test-*
!tests/integration/test_*.ts
!tests/integration/test-*.ts
!tests/integration/test_*.sh
!tests/integration/test-*.sh
!tests/tooling/infrastructure/test_copied_minor_fallback_report.py
!tests/tooling/infrastructure/test_compiler_output_regression.py
!tests/tooling/infrastructure/test_gc_1090_evidence_report.py
!tests/tooling/infrastructure/test_native_abi_evidence_report.py
!tests/tooling/infrastructure/test_changelog_archive.py
!tests/tooling/infrastructure/test_typed_feedback_runtime_evidence.py
!tests/tooling/infrastructure/test_perf_frontier_report.py
!tests/tooling/compat/test_test262_focused_report.py
!tests/tooling/infrastructure/test_zfs_build_storage.py
!tests/tooling/compat/test_npm_sweep.py
!tests/tooling/infrastructure/test_repsel_census.py
!tests/tooling/compat/test_node_core_subset.py
!tests/tooling/infrastructure/test_visual_test_check.py
# Relocation preserves source tracking; executable CI callers still register
# standalone regression modules. A directory alone does not make a test run.
!tests/tooling/parity/test_parity_normalize.py
!tests/tooling/parity/test_parity_runner.py
!tests/integration/test_perf_frontier_gate_smoke.sh
!tests/*/
bench_*
!bench_*.ts
