# npm-cli soak window (npm >= 11.17, DAYS) — governs the root npm install
# that materializes the parity-test fixture deps (package-lock.json).
# Managed by scripts/soak/soak.mts (`npm run soak` / `npm run soak:fix`).
#
# The pnpm-side soak (minimumReleaseAge, catalog) lives in
# tools/pnpm-workspace.yaml, NOT here: pnpm only honors minimumReleaseAge
# from a workspace yaml, and a workspace yaml at the repo root would mark
# the npm-managed root as a pnpm workspace.
min-release-age=7
