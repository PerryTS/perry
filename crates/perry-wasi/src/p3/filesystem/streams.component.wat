;; Pinned WASI 0.3 resource and error types; transfers real canonical handles.
(component
  (import "wasi:filesystem/types@0.3.0" (instance $fs
    (export "descriptor" (type $descriptor (sub resource)))
    (type $detail (option string))
    (type $error (variant
      (case "access")
      (case "already")
      (case "bad-descriptor")
      (case "busy")
      (case "deadlock")
      (case "quota")
      (case "exist")
      (case "file-too-large")
      (case "illegal-byte-sequence")
      (case "in-progress")
      (case "interrupted")
      (case "invalid")
      (case "io")
      (case "is-directory")
      (case "loop")
      (case "too-many-links")
      (case "message-size")
      (case "name-too-long")
      (case "no-device")
      (case "no-entry")
      (case "no-lock")
      (case "insufficient-memory")
      (case "insufficient-space")
      (case "not-directory")
      (case "not-empty")
      (case "not-recoverable")
      (case "unsupported")
      (case "no-tty")
      (case "no-such-device")
      (case "overflow")
      (case "not-permitted")
      (case "pipe")
      (case "read-only")
      (case "invalid-seek")
      (case "text-file-busy")
      (case "cross-device")
      (case "other" $detail)
    ))
    (export "error-code" (type $named-error (eq $error)))
    (type $outcome (result (error $named-error)))
    (type $completion (future $outcome))
    (type $bytes (stream u8))
    (export "[method]descriptor.read-via-stream" (func
      (param "self" (borrow $descriptor)) (param "offset" u64)
      (result (tuple $bytes $completion))))
    (export "[method]descriptor.write-via-stream" (func
      (param "self" (borrow $descriptor)) (param "data" $bytes) (param "offset" u64)
      (result $completion)))))
  (alias export $fs "descriptor" (type $descriptor))
  (alias export $fs "error-code" (type $error))
  (export "descriptor" (type $descriptor))
  (export "error-code" (type $error))
  (type $outcome (result (error $error)))
  (type $completion (future $outcome))
  (alias export $fs "[method]descriptor.read-via-stream" (func $read))
  (alias export $fs "[method]descriptor.write-via-stream" (func $write))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (core func $read (canon lower (func $read) (memory (core memory $memory "memory"))))
  (core func $write (canon lower (func $write)))
  (core func $drop (canon resource.drop $descriptor))
  (core module $guest
    (import "memory" "memory" (memory 1))
    (import "host" "drop" (func $drop (param i32)))
    (import "host" "read" (func $read (param i32 i64 i32)))
    (import "host" "write" (func $write (param i32 i32 i64) (result i32)))
    (func (export "run") (param $source i32) (param $target i32) (result i32)
      (call $read (local.get $source) (i64.const 0) (i32.const 16))
      (i32.store (i32.const 0) (i32.load (i32.const 20)))
      (i32.store (i32.const 4) (call $write (local.get $target) (i32.load (i32.const 16)) (i64.const 0)))
      (call $drop (local.get $source))
      (call $drop (local.get $target))
      (i32.const 0)))
  (core instance $guest (instantiate $guest
    (with "memory" (instance $memory))
    (with "host" (instance (export "drop" (func $drop)) (export "read" (func $read)) (export "write" (func $write))))))
  (func (export "run") (param "source" (borrow $descriptor)) (param "target" (borrow $descriptor)) (result (tuple $completion $completion))
    (canon lift (core func $guest "run") (memory (core memory $memory "memory")))))
