;; Pinned WASI 0.3 resource and error types; transfers real canonical handles.
(component
  (import "wasi:sockets/types@0.3.0" (instance $sockets
    (export "tcp-socket" (type $tcp-socket (sub resource)))
    (type $detail (option string))
    (type $error (variant
      (case "access-denied")
      (case "not-supported")
      (case "invalid-argument")
      (case "out-of-memory")
      (case "timeout")
      (case "invalid-state")
      (case "address-not-bindable")
      (case "address-in-use")
      (case "remote-unreachable")
      (case "connection-refused")
      (case "connection-broken")
      (case "connection-reset")
      (case "connection-aborted")
      (case "datagram-too-large")
      (case "other" $detail)
    ))
    (export "error-code" (type $named-error (eq $error)))
    (type $outcome (result (error $named-error)))
    (type $completion (future $outcome))
    (type $bytes (stream u8))
    (export "[method]tcp-socket.receive" (func
      (param "self" (borrow $tcp-socket))
      (result (tuple $bytes $completion))))
    (export "[method]tcp-socket.send" (func
      (param "self" (borrow $tcp-socket)) (param "data" $bytes)
      (result $completion)))))
  (alias export $sockets "tcp-socket" (type $tcp-socket))
  (alias export $sockets "error-code" (type $error))
  (export "tcp-socket" (type $tcp-socket))
  (export "error-code" (type $error))
  (type $outcome (result (error $error)))
  (type $completion (future $outcome))
  (alias export $sockets "[method]tcp-socket.receive" (func $read))
  (alias export $sockets "[method]tcp-socket.send" (func $write))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (core func $read (canon lower (func $read) (memory (core memory $memory "memory"))))
  (core func $write (canon lower (func $write)))
  (core func $drop (canon resource.drop $tcp-socket))
  (core module $guest
    (import "memory" "memory" (memory 1))
    (import "host" "drop" (func $drop (param i32)))
    (import "host" "read" (func $read (param i32 i32)))
    (import "host" "write" (func $write (param i32 i32) (result i32)))
    (func (export "run") (param $socket i32) (result i32)
      (call $read (local.get $socket) (i32.const 16))
      (i32.store (i32.const 0) (i32.load (i32.const 20)))
      (i32.store (i32.const 4) (call $write (local.get $socket) (i32.load (i32.const 16))))
      (call $drop (local.get $socket))
      (i32.const 0)))
  (core instance $guest (instantiate $guest
    (with "memory" (instance $memory))
    (with "host" (instance (export "drop" (func $drop)) (export "read" (func $read)) (export "write" (func $write))))))
  (func (export "run") (param "socket" (borrow $tcp-socket)) (result (tuple $completion $completion))
    (canon lift (core func $guest "run") (memory (core memory $memory "memory")))))
