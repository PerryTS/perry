;; Send and receive real UDP packets through canonical async calls.
;; Return zero only when binary payload and source address match.
(component
  (import "wasi:sockets/types@0.3.0" (instance $sockets
    (export "udp-socket" (type $udp-socket (sub resource)))
    (type $detail (option string))
    (type $error (variant
      (case "access-denied")
      (case "not-supported")
      (case "invalid-argument")
      (case "out-of-memory")
      (case "timeout")
      (case "invalid-state")
      (case "address-not-bindable")
      (case "address-in-use")
      (case "remote-unreachable")
      (case "connection-refused")
      (case "connection-broken")
      (case "connection-reset")
      (case "connection-aborted")
      (case "datagram-too-large")
      (case "other" $detail)
    ))
    (export "error-code" (type $named-error (eq $error)))
    (type $outcome (result (error $named-error)))
    (type $v4 (tuple u8 u8 u8 u8))
    (export "ipv4-address" (type $named-v4 (eq $v4)))
    (type $v6 (tuple u16 u16 u16 u16 u16 u16 u16 u16))
    (export "ipv6-address" (type $named-v6 (eq $v6)))
    (type $a4 (record (field "port" u16) (field "address" $named-v4)))
    (export "ipv4-socket-address" (type $named-a4 (eq $a4)))
    (type $a6 (record (field "port" u16) (field "flow-info" u32) (field "address" $named-v6) (field "scope-id" u32)))
    (export "ipv6-socket-address" (type $named-a6 (eq $a6)))
    (type $address (variant (case "ipv4" $named-a4) (case "ipv6" $named-a6)))
    (export "ip-socket-address" (type $named-address (eq $address)))
    (type $data (list u8))
    (type $remote (option $named-address))
    (type $packet (tuple $data $named-address))
    (type $received (result $packet (error $named-error)))
    (export "[method]udp-socket.send" (func async (param "self" (borrow $udp-socket)) (param "data" $data) (param "remote-address" $remote) (result $outcome)))
    (export "[method]udp-socket.receive" (func async (param "self" (borrow $udp-socket)) (result $received)))))
  (alias export $sockets "udp-socket" (type $udp-socket))
  (export "udp-socket" (type $udp-socket))
  (alias export $sockets "[method]udp-socket.send" (func $send))
  (alias export $sockets "[method]udp-socket.receive" (func $receive))
  (core module $memory
    (memory (export "memory") 1)
    (global $heap (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32) (local $p i32)
      (local.set $p (i32.and (i32.add (global.get $heap) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $heap (i32.add (local.get $p) (local.get $size)))
      (local.get $p)))
  (core instance $memory (instantiate $memory))
  (core func $send (canon lower (func $send) async (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (core func $receive (canon lower (func $receive) async (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (core func $return (canon task.return (result u32)))
  (core func $new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core func $drop-task (canon subtask.drop))
  (core func $drop (canon resource.drop $udp-socket))
  (core module $guest
    (import "memory" "memory" (memory 1))
    (import "host" "send" (func $send (param i32 i32) (result i32)))
    (import "host" "receive" (func $receive (param i32 i32) (result i32)))
    (import "host" "return" (func $return (param i32)))
    (import "host" "new" (func $new (result i32)))
    (import "host" "join" (func $join (param i32 i32)))
    (import "host" "drop-set" (func $drop-set (param i32)))
    (import "host" "drop-task" (func $drop-task (param i32)))
    (import "host" "drop" (func $drop (param i32)))
    (global $self (mut i32) (i32.const 0))
    (global $port (mut i32) (i32.const 0))
    (global $stage (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (global $task (mut i32) (i32.const 0))
    (func $finish (param $code i32) (result i32)
      (call $drop (global.get $self))
      (call $drop-set (global.get $set))
      (call $return (local.get $code))
      (i32.const 0))
    (func $start (param $status i32) (result i32)
      (global.set $task (i32.shr_u (local.get $status) (i32.const 4)))
      (if (result i32) (i32.eq (i32.and (local.get $status) (i32.const 15)) (i32.const 2))
        (then (call $after))
        (else
          (call $join (global.get $task) (global.get $set))
          (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))))
    (func $after (result i32) (local $bytes i32)
      (if (global.get $task) (then (call $drop-task (global.get $task))))
      (global.set $task (i32.const 0))
      (if (i32.eqz (global.get $stage)) (then
        (if (i32.load8_u (i32.const 32)) (then (return (call $finish (i32.add (i32.const 100) (i32.load8_u (i32.const 36)))))))
        (global.set $stage (i32.const 1))
        (return (call $start (call $receive (global.get $self) (i32.const 128))))))
      (if (i32.load8_u (i32.const 128)) (then (return (call $finish (i32.add (i32.const 200) (i32.load8_u (i32.const 132)))))))
      (if (i32.ne (i32.load (i32.const 136)) (i32.const 3)) (then (return (call $finish (i32.const 301)))))
      (local.set $bytes (i32.load (i32.const 132)))
      (if (i32.ne (i32.load8_u (local.get $bytes)) (i32.const 97)) (then (return (call $finish (i32.const 302)))))
      (if (i32.ne (i32.load8_u offset=1 (local.get $bytes)) (i32.const 0)) (then (return (call $finish (i32.const 303)))))
      (if (i32.ne (i32.load8_u offset=2 (local.get $bytes)) (i32.const 255)) (then (return (call $finish (i32.const 304)))))
      (if (i32.load8_u (i32.const 140)) (then (return (call $finish (i32.const 305)))))
      (if (i32.ne (i32.load16_u (i32.const 144)) (global.get $port)) (then (return (call $finish (i32.const 306)))))
      (call $finish (i32.const 0)))
    (func (export "run") (param $self i32) (param $port i32) (result i32)
      (global.set $self (local.get $self))
      (global.set $port (local.get $port))
      (global.set $stage (i32.const 0))
      (global.set $set (call $new))
      (i32.store8 (i32.const 16) (i32.const 97))
      (i32.store8 (i32.const 17) (i32.const 0))
      (i32.store8 (i32.const 18) (i32.const 255))
      (i32.store (i32.const 64) (local.get $self))
      (i32.store (i32.const 68) (i32.const 16))
      (i32.store (i32.const 72) (i32.const 3))
      (i32.store8 (i32.const 76) (i32.const 1))
      (i32.store8 (i32.const 80) (i32.const 0))
      (i32.store16 (i32.const 84) (local.get $port))
      (i32.store8 (i32.const 86) (i32.const 127))
      (i32.store8 (i32.const 87) (i32.const 0))
      (i32.store8 (i32.const 88) (i32.const 0))
      (i32.store8 (i32.const 89) (i32.const 1))
      (call $start (call $send (i32.const 64) (i32.const 32))))
    (func (export "callback") (param $event i32) (param $waitable i32) (param $code i32) (result i32)
      (if (i32.ne (local.get $event) (i32.const 1)) (then unreachable))
      (if (i32.ne (local.get $waitable) (global.get $task)) (then unreachable))
      (if (result i32) (i32.eq (local.get $code) (i32.const 2))
        (then (call $after))
        (else (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4)))))))
  (core instance $guest (instantiate $guest (with "memory" (instance $memory)) (with "host" (instance
    (export "send" (func $send)) (export "receive" (func $receive))
    (export "drop" (func $drop)) (export "return" (func $return))
    (export "new" (func $new)) (export "join" (func $join))
    (export "drop-set" (func $drop-set)) (export "drop-task" (func $drop-task))))))
  (func (export "run") async (param "self" (borrow $udp-socket)) (param "port" u16) (result u32)
    (canon lift (core func $guest "run") async (callback (core func $guest "callback")))))
