;; Real canonical async HTTP client call with callback suspension.
(component
  (import "wasi:http/types@0.3.0" (instance $http
    (type $dns-definition (record (field "rcode" (option string)) (field "info-code" (option u16))))
    (export "DNS-error-payload" (type $dns (eq $dns-definition)))
    (type $tls-definition (record (field "alert-id" (option u8)) (field "alert-message" (option string))))
    (export "TLS-alert-received-payload" (type $tls (eq $tls-definition)))
    (type $size-definition (record (field "field-name" (option string)) (field "field-size" (option u32))))
    (export "field-size-payload" (type $size (eq $size-definition)))
    (type $error-definition (variant
      (case "DNS-timeout")
      (case "DNS-error" $dns)
      (case "destination-not-found")
      (case "destination-unavailable")
      (case "destination-IP-prohibited")
      (case "destination-IP-unroutable")
      (case "connection-refused")
      (case "connection-terminated")
      (case "connection-timeout")
      (case "connection-read-timeout")
      (case "connection-write-timeout")
      (case "connection-limit-reached")
      (case "TLS-protocol-error")
      (case "TLS-certificate-error")
      (case "TLS-alert-received" $tls)
      (case "HTTP-request-denied")
      (case "HTTP-request-length-required")
      (case "HTTP-request-body-size" (option u64))
      (case "HTTP-request-method-invalid")
      (case "HTTP-request-URI-invalid")
      (case "HTTP-request-URI-too-long")
      (case "HTTP-request-header-section-size" (option u32))
      (case "HTTP-request-header-size" (option $size))
      (case "HTTP-request-trailer-section-size" (option u32))
      (case "HTTP-request-trailer-size" $size)
      (case "HTTP-response-incomplete")
      (case "HTTP-response-header-section-size" (option u32))
      (case "HTTP-response-header-size" $size)
      (case "HTTP-response-body-size" (option u64))
      (case "HTTP-response-trailer-section-size" (option u32))
      (case "HTTP-response-trailer-size" $size)
      (case "HTTP-response-transfer-coding" (option string))
      (case "HTTP-response-content-coding" (option string))
      (case "HTTP-response-timeout")
      (case "HTTP-upgrade-failed")
      (case "HTTP-protocol-error")
      (case "loop-detected")
      (case "configuration-error")
      (case "internal-error" (option string))))
    (export "error-code" (type $error (eq $error-definition)))
    (export "request" (type (sub resource)))
    (export "response" (type (sub resource)))))
  (alias export $http "request" (type $request))
  (alias export $http "response" (type $response))
  (alias export $http "error-code" (type $error))
  (export "request" (type $request))
  (export "response" (type $response))
  (import "wasi:http/client@0.3.0" (instance $client
    (alias outer 1 $request (type $request)) (export "request" (type (eq $request)))
    (alias outer 1 $response (type $response)) (export "response" (type (eq $response)))
    (alias outer 1 $error (type $error)) (export "error-code" (type $named-error (eq $error)))
    (export "send" (func async (param "request" (own $request)) (result (result (own $response) (error $named-error)))))))
  (alias export $client "send" (func $send))
  (core module $memory
    (memory (export "memory") 1)
    (global $heap (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32) (local $p i32)
      (local.set $p (i32.and (i32.add (global.get $heap) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $heap (i32.add (local.get $p) (local.get $size)))
      (local.get $p)))
  (core instance $memory (instantiate $memory))
  (core func $wait (canon lower (func $send) async (memory (core memory $memory "memory")) (realloc (core func $memory "realloc"))))
  (core func $return (canon task.return (result (own $response))))
  (core func $new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core func $drop-task (canon subtask.drop))
  (core module $guest
    (import "memory" "memory" (memory 1))
    (import "host" "wait" (func $wait (param i32 i32) (result i32)))
    (import "host" "return" (func $return (param i32)))
    (import "host" "new" (func $new (result i32)))
    (import "host" "join" (func $join (param i32 i32)))
    (import "host" "drop-set" (func $drop-set (param i32)))
    (import "host" "drop-task" (func $drop-task (param i32)))
    (global $callbacks (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (global $task (mut i32) (i32.const 0))
    (func $finish (result i32)
      ;; Immediate completion has no subtask handle.
      (if (global.get $task) (then (call $drop-task (global.get $task))))
      (call $drop-set (global.get $set))
      (if (i32.load8_u (i32.const 16)) (then unreachable))
      (call $return (i32.load (i32.const 24)))
      (i32.const 0))
    (func (export "run") (param $request i32) (result i32) (local $status i32)
      (global.set $set (call $new))
      (local.set $status (call $wait (local.get $request) (i32.const 16)))
      (global.set $task (i32.shr_u (local.get $status) (i32.const 4)))
      (if (result i32) (i32.eq (i32.and (local.get $status) (i32.const 15)) (i32.const 2))
        (then (call $finish))
        (else
          (call $join (global.get $task) (global.get $set))
          (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))))
    (func (export "callbacks") (result i32) (global.get $callbacks))
    (func (export "callback") (param $event i32) (param $waitable i32) (param $code i32) (result i32)
      (global.set $callbacks (i32.add (global.get $callbacks) (i32.const 1)))
      (if (i32.ne (local.get $event) (i32.const 1)) (then unreachable))
      (if (i32.ne (local.get $waitable) (global.get $task)) (then unreachable))
      (if (result i32) (i32.eq (local.get $code) (i32.const 2))
        (then (call $finish))
        (else (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4)))))))
  (core instance $guest (instantiate $guest (with "memory" (instance $memory)) (with "host" (instance
    (export "wait" (func $wait))
    (export "return" (func $return)) (export "new" (func $new))
    (export "join" (func $join)) (export "drop-set" (func $drop-set))
    (export "drop-task" (func $drop-task))))))
  (func (export "run") async (param "request" (own $request)) (result (own $response))
    (canon lift (core func $guest "run") async (callback (core func $guest "callback"))))
  (func (export "callbacks") (result u32) (canon lift (core func $guest "callbacks"))))
