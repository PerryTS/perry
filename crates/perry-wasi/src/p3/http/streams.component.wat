;; Transfer request bodies, trailers and completion futures through real Wasm.
(component
  (import "wasi:http/types@0.3.0" (instance $http
    (type $dns-definition (record (field "rcode" (option string)) (field "info-code" (option u16))))
    (export "DNS-error-payload" (type $dns (eq $dns-definition)))
    (type $tls-definition (record (field "alert-id" (option u8)) (field "alert-message" (option string))))
    (export "TLS-alert-received-payload" (type $tls (eq $tls-definition)))
    (type $size-definition (record (field "field-name" (option string)) (field "field-size" (option u32))))
    (export "field-size-payload" (type $size (eq $size-definition)))
    (type $error-definition (variant
      (case "DNS-timeout")
      (case "DNS-error" $dns)
      (case "destination-not-found")
      (case "destination-unavailable")
      (case "destination-IP-prohibited")
      (case "destination-IP-unroutable")
      (case "connection-refused")
      (case "connection-terminated")
      (case "connection-timeout")
      (case "connection-read-timeout")
      (case "connection-write-timeout")
      (case "connection-limit-reached")
      (case "TLS-protocol-error")
      (case "TLS-certificate-error")
      (case "TLS-alert-received" $tls)
      (case "HTTP-request-denied")
      (case "HTTP-request-length-required")
      (case "HTTP-request-body-size" (option u64))
      (case "HTTP-request-method-invalid")
      (case "HTTP-request-URI-invalid")
      (case "HTTP-request-URI-too-long")
      (case "HTTP-request-header-section-size" (option u32))
      (case "HTTP-request-header-size" (option $size))
      (case "HTTP-request-trailer-section-size" (option u32))
      (case "HTTP-request-trailer-size" $size)
      (case "HTTP-response-incomplete")
      (case "HTTP-response-header-section-size" (option u32))
      (case "HTTP-response-header-size" $size)
      (case "HTTP-response-body-size" (option u64))
      (case "HTTP-response-trailer-section-size" (option u32))
      (case "HTTP-response-trailer-size" $size)
      (case "HTTP-response-transfer-coding" (option string))
      (case "HTTP-response-content-coding" (option string))
      (case "HTTP-response-timeout")
      (case "HTTP-upgrade-failed")
      (case "HTTP-protocol-error")
      (case "loop-detected")
      (case "configuration-error")
      (case "internal-error" (option string))))
    (export "error-code" (type $error (eq $error-definition)))
    (export "fields" (type $fields (sub resource)))
    (export "headers" (type (eq $fields)))
    (export "trailers" (type (eq $fields)))
    (export "request" (type $request (sub resource)))
    (export "response" (type $response (sub resource)))
    (type $outcome (result (error $error)))
    (type $completion (future $outcome))
    (type $bytes (stream u8))
    (type $trailers (future (result (option (own $fields)) (error $error))))
    (export "[method]request.get-headers" (func (param "self" (borrow $request)) (result (own $fields))))
    (export "[static]request.consume-body" (func (param "this" (own $request)) (param "res" $completion) (result (tuple $bytes $trailers))))
    (export "[static]response.new" (func (param "headers" (own $fields)) (param "contents" (option $bytes)) (param "trailers" $trailers) (result (tuple (own $response) $completion))))))
  (alias export $http "request" (type $request))
  (alias export $http "response" (type $response))
  (alias export $http "fields" (type $fields))
  (alias export $http "error-code" (type $error))
  (export "request" (type $request))
  (export "response" (type $response))
  (export "fields" (type $fields))
  (export "error-code" (type $error))
  (type $completion (future (result (error $error))))
  (alias export $http "[method]request.get-headers" (func $headers))
  (alias export $http "[static]request.consume-body" (func $consume))
  (alias export $http "[static]response.new" (func $response))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (core func $headers (canon lower (func $headers)))
  (core func $consume (canon lower (func $consume) (memory (core memory $memory "memory"))))
  (core func $response (canon lower (func $response) (memory (core memory $memory "memory"))))
  (core module $guest
    (import "memory" "memory" (memory 1))
    (import "host" "headers" (func $headers (param i32) (result i32)))
    (import "host" "consume" (func $consume (param i32 i32 i32)))
    (import "host" "response" (func $response (param i32 i32 i32 i32 i32)))
    (func (export "run") (param $request i32) (param $result i32) (result i32) (local $headers i32)
      (local.set $headers (call $headers (local.get $request)))
      (call $consume (local.get $request) (local.get $result) (i32.const 16))
      (call $response (local.get $headers) (i32.const 1) (i32.load (i32.const 16)) (i32.load (i32.const 20)) (i32.const 0))
      (i32.const 0)))
  (core instance $guest (instantiate $guest (with "memory" (instance $memory))
    (with "host" (instance (export "headers" (func $headers)) (export "consume" (func $consume)) (export "response" (func $response))))))
  (func (export "run") (param "request" (own $request)) (param "result" $completion) (result (tuple (own $response) $completion))
    (canon lift (core func $guest "run") (memory (core memory $memory "memory")))))
