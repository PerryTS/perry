(component
  (import "wasi:io/poll@0.2.0" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.block" (func (param "self" (borrow $pollable))))))
  (alias export $poll "pollable" (type $pollable))
  (import "wasi:io/error@0.2.0" (instance $errors
    (export "error" (type (sub resource)))))
  (alias export $errors "error" (type $io-error))
  (import "wasi:io/streams@0.2.0" (instance $streams
    (alias outer 1 $io-error (type $io-error))
    (export "error" (type (eq $io-error)))
    (export "input-stream" (type $input (sub resource)))
    (export "output-stream" (type $output (sub resource)))
    (type $stream-error-definition (variant (case "last-operation-failed" (own $io-error)) (case "closed")))
    (export "stream-error" (type $stream-error (eq $stream-error-definition)))
    (export "[method]output-stream.check-write" (func (param "self" (borrow $output)) (result (result u64 (error $stream-error)))))
    (export "[method]output-stream.write" (func (param "self" (borrow $output)) (param "contents" (list u8)) (result (result (error $stream-error)))))
    (export "[method]input-stream.blocking-read" (func (param "self" (borrow $input)) (param "len" u64) (result (result (list u8) (error $stream-error)))))))
  (alias export $streams "input-stream" (type $input))
  (alias export $streams "output-stream" (type $output))

  (import "wasi:http/types@0.2.0" (instance $types
    (alias outer 1 $pollable (type $pollable))
    (alias outer 1 $input (type $input))
    (export "pollable" (type (eq $pollable)))
    (export "input-stream" (type (eq $input)))
    (type $dns-definition (record (field "rcode" (option string)) (field "info-code" (option u16))))
    (export "DNS-error-payload" (type $dns (eq $dns-definition)))
    (type $tls-definition (record (field "alert-id" (option u8)) (field "alert-message" (option string))))
    (export "TLS-alert-received-payload" (type $tls (eq $tls-definition)))
    (type $size-definition (record (field "field-name" (option string)) (field "field-size" (option u32))))
    (export "field-size-payload" (type $size (eq $size-definition)))
    (type $error-definition (variant
      (case "DNS-timeout")
      (case "DNS-error" $dns)
      (case "destination-not-found")
      (case "destination-unavailable")
      (case "destination-IP-prohibited")
      (case "destination-IP-unroutable")
      (case "connection-refused")
      (case "connection-terminated")
      (case "connection-timeout")
      (case "connection-read-timeout")
      (case "connection-write-timeout")
      (case "connection-limit-reached")
      (case "TLS-protocol-error")
      (case "TLS-certificate-error")
      (case "TLS-alert-received" $tls)
      (case "HTTP-request-denied")
      (case "HTTP-request-length-required")
      (case "HTTP-request-body-size" (option u64))
      (case "HTTP-request-method-invalid")
      (case "HTTP-request-URI-invalid")
      (case "HTTP-request-URI-too-long")
      (case "HTTP-request-header-section-size" (option u32))
      (case "HTTP-request-header-size" (option $size))
      (case "HTTP-request-trailer-section-size" (option u32))
      (case "HTTP-request-trailer-size" $size)
      (case "HTTP-response-incomplete")
      (case "HTTP-response-header-section-size" (option u32))
      (case "HTTP-response-header-size" $size)
      (case "HTTP-response-body-size" (option u64))
      (case "HTTP-response-trailer-section-size" (option u32))
      (case "HTTP-response-trailer-size" $size)
      (case "HTTP-response-transfer-coding" (option string))
      (case "HTTP-response-content-coding" (option string))
      (case "HTTP-response-timeout")
      (case "HTTP-upgrade-failed")
      (case "HTTP-protocol-error")
      (case "loop-detected")
      (case "configuration-error")
      (case "internal-error" (option string))))
    (export "error-code" (type $error (eq $error-definition)))
    (type $scheme-definition (variant (case "HTTP") (case "HTTPS") (case "other" string)))
    (export "scheme" (type $scheme (eq $scheme-definition)))
    (export "fields" (type $fields (sub resource)))
    (export "outgoing-request" (type $request (sub resource)))
    (export "request-options" (type $options (sub resource)))
    (export "future-incoming-response" (type $future (sub resource)))
    (export "incoming-response" (type $response (sub resource)))
    (export "incoming-body" (type $body (sub resource)))
    (export "future-trailers" (type $trailers (sub resource)))
    (export "[constructor]fields" (func (result (own $fields))))
    (export "[constructor]outgoing-request" (func (param "headers" (own $fields)) (result (own $request))))
    (export "[method]outgoing-request.set-scheme" (func (param "self" (borrow $request)) (param "scheme" (option $scheme)) (result (result))))
    (export "[method]outgoing-request.set-authority" (func (param "self" (borrow $request)) (param "authority" (option string)) (result (result))))
    (export "[method]future-incoming-response.subscribe" (func (param "self" (borrow $future)) (result (own $pollable))))
    (export "[method]future-incoming-response.get" (func (param "self" (borrow $future)) (result (option (result (result (own $response) (error $error)))))))
    (export "[method]incoming-response.status" (func (param "self" (borrow $response)) (result u16)))
    (export "[method]incoming-response.consume" (func (param "self" (borrow $response)) (result (result (own $body)))))
    (export "[method]incoming-body.stream" (func (param "self" (borrow $body)) (result (result (own $input)))))
    (export "[static]incoming-body.finish" (func (param "this" (own $body)) (result (own $trailers))))
    (export "[method]future-trailers.subscribe" (func (param "self" (borrow $trailers)) (result (own $pollable))))
    (export "[method]future-trailers.get" (func (param "self" (borrow $trailers)) (result (option (result (result (option (own $fields)) (error $error)))))))))
  (alias export $types "outgoing-request" (type $outgoing-request))
  (alias export $types "request-options" (type $request-options))
  (alias export $types "future-incoming-response" (type $future-incoming-response))
  (alias export $types "error-code" (type $error-code))
  (alias export $types "incoming-response" (type $incoming-response))
  (alias export $types "incoming-body" (type $incoming-body))
  (alias export $types "future-trailers" (type $future-trailers))
  (import "wasi:http/outgoing-handler@0.2.0" (instance $handler
    (alias outer 1 $outgoing-request (type $request))
    (alias outer 1 $request-options (type $options))
    (alias outer 1 $future-incoming-response (type $future))
    (alias outer 1 $error-code (type $error))
    (export "outgoing-request" (type (eq $request)))
    (export "request-options" (type (eq $options)))
    (export "future-incoming-response" (type (eq $future)))
    (export "error-code" (type (eq $error)))
    (export "handle" (func (param "request" (own $request)) (param "options" (option (own $options))) (result (result (own $future) (error $error)))))))
  (core module $mem
    (memory (export "memory") 1)
    (global $bump (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (i32.and (i32.add (global.get $bump) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $bump (i32.add (local.get $ptr) (local.get $size))) (local.get $ptr)))
  (core instance $mem (instantiate $mem))
  (alias core export $mem "memory" (core memory $memory))
  (alias core export $mem "realloc" (core func $realloc))
  (alias export $types "[constructor]fields" (func $new-fields))
  (core func $new-fields (canon lower (func $new-fields)))
  (alias export $types "[constructor]outgoing-request" (func $new-request))
  (core func $new-request (canon lower (func $new-request)))
  (alias export $types "[method]outgoing-request.set-scheme" (func $scheme))
  (core func $scheme (canon lower (func $scheme) (memory $memory)))
  (alias export $types "[method]outgoing-request.set-authority" (func $authority))
  (core func $authority (canon lower (func $authority) (memory $memory)))
  (alias export $handler "handle" (func $handle))
  (core func $handle (canon lower (func $handle) (memory $memory) (realloc $realloc)))
  (alias export $types "[method]future-incoming-response.subscribe" (func $subscribe))
  (core func $subscribe (canon lower (func $subscribe)))
  (alias export $types "[method]future-incoming-response.get" (func $get))
  (core func $get (canon lower (func $get) (memory $memory) (realloc $realloc)))
  (alias export $poll "[method]pollable.block" (func $block))
  (core func $block (canon lower (func $block)))
  (alias export $types "[method]incoming-response.status" (func $status))
  (core func $status (canon lower (func $status)))
  (alias export $types "[method]incoming-response.consume" (func $consume))
  (core func $consume (canon lower (func $consume) (memory $memory)))
  (alias export $types "[method]incoming-body.stream" (func $stream))
  (core func $stream (canon lower (func $stream) (memory $memory)))
  (alias export $types "[static]incoming-body.finish" (func $finish))
  (core func $finish (canon lower (func $finish)))
  (alias export $types "[method]future-trailers.subscribe" (func $trailers-subscribe))
  (core func $trailers-subscribe (canon lower (func $trailers-subscribe)))
  (alias export $types "[method]future-trailers.get" (func $trailers-get))
  (core func $trailers-get (canon lower (func $trailers-get) (memory $memory) (realloc $realloc)))
  (alias export $streams "[method]input-stream.blocking-read" (func $read))
  (core func $read (canon lower (func $read) (memory $memory) (realloc $realloc)))
  (core func $drop-future (canon resource.drop $future-incoming-response))
  (core func $drop-response (canon resource.drop $incoming-response))
  (core func $drop-trailers (canon resource.drop $future-trailers))
  (core func $drop-pollable (canon resource.drop $pollable))
  (core func $drop-input (canon resource.drop $input))
  (core module $code
    (import "host" "memory" (memory 1))
    (import "host" "new-fields" (func $new-fields (result i32)))
    (import "host" "new-request" (func $new-request (param i32) (result i32)))
    (import "host" "scheme" (func $scheme (param i32 i32 i32 i32 i32) (result i32)))
    (import "host" "authority" (func $authority (param i32 i32 i32 i32) (result i32)))
    (import "host" "handle" (func $handle (param i32 i32 i32 i32)))
    (import "host" "subscribe" (func $subscribe (param i32) (result i32)))
    (import "host" "get" (func $get (param i32 i32)))
    (import "host" "block" (func $block (param i32)))
    (import "host" "status" (func $status (param i32) (result i32)))
    (import "host" "consume" (func $consume (param i32 i32)))
    (import "host" "stream" (func $stream (param i32 i32)))
    (import "host" "finish" (func $finish (param i32) (result i32)))
    (import "host" "trailers-subscribe" (func $trailers-subscribe (param i32) (result i32)))
    (import "host" "trailers-get" (func $trailers-get (param i32 i32)))
    (import "host" "read" (func $read (param i32 i64 i32)))
    (import "host" "drop-future" (func $drop-future (param i32)))
    (import "host" "drop-response" (func $drop-response (param i32)))
    (import "host" "drop-trailers" (func $drop-trailers (param i32)))
    (import "host" "drop-pollable" (func $drop-pollable (param i32)))
    (import "host" "drop-input" (func $drop-input (param i32)))
    (data (i32.const 512) "pong")
    (func (export "run") (param $address i32) (param $len i32) (result i32)
      (local $request i32) (local $future i32) (local $poll i32) (local $response i32)
      (local $body i32) (local $input i32) (local $trailers i32) (local $count i32) (local $ptr i32) (local $n i32) (local $i i32) (local $error i32)
      (local.set $request (call $new-request (call $new-fields)))
      (if (call $scheme (local.get $request) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)) (then unreachable))
      (if (call $authority (local.get $request) (i32.const 1) (local.get $address) (local.get $len)) (then unreachable))
      (call $handle (local.get $request) (i32.const 0) (i32.const 0) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then (return (i32.add (i32.const 1000) (i32.load8_u (i32.const 8))))))
      (local.set $future (i32.load (i32.const 8)))
      (local.set $poll (call $subscribe (local.get $future)))
      (call $block (local.get $poll))
      (call $get (local.get $future) (i32.const 0))
      (if (i32.ne (i32.load8_u (i32.const 0)) (i32.const 1)) (then unreachable))
      (if (i32.load8_u (i32.const 8)) (then unreachable))
      (if (i32.load8_u (i32.const 16)) (then
        (local.set $error (i32.add (i32.const 1000) (i32.load8_u (i32.const 24))))
        (call $drop-pollable (local.get $poll)) (call $drop-future (local.get $future))
        (return (local.get $error))))
      (local.set $response (i32.load (i32.const 24)))
      (call $drop-pollable (local.get $poll)) (call $drop-future (local.get $future))
      (if (i32.ne (call $status (local.get $response)) (i32.const 202)) (then unreachable))
      (call $consume (local.get $response) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $body (i32.load (i32.const 4))) (call $drop-response (local.get $response))
      (call $stream (local.get $body) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $input (i32.load (i32.const 4)))
      (loop $read
        (call $read (local.get $input) (i64.const 4) (i32.const 0))
        (if (i32.load8_u (i32.const 0)) (then unreachable))
        (local.set $ptr (i32.load (i32.const 4))) (local.set $n (i32.load (i32.const 8)))
        (local.set $i (i32.const 0))
        (block $end (loop $bytes
          (br_if $end (i32.ge_u (local.get $i) (local.get $n)))
          (if (i32.ne (i32.load8_u (i32.add (local.get $ptr) (local.get $i)))
              (i32.load8_u (i32.add (i32.const 512) (local.get $count)))) (then unreachable))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (local.set $count (i32.add (local.get $count) (i32.const 1))) (br $bytes)))
        (br_if $read (i32.lt_u (local.get $count) (i32.const 4))))
      (call $drop-input (local.get $input)) (local.set $trailers (call $finish (local.get $body)))
      (local.set $poll (call $trailers-subscribe (local.get $trailers))) (call $block (local.get $poll))
      (call $trailers-get (local.get $trailers) (i32.const 0))
      (if (i32.ne (i32.load8_u (i32.const 0)) (i32.const 1)) (then unreachable))
      (if (i32.load8_u (i32.const 8)) (then unreachable)) (if (i32.load8_u (i32.const 16)) (then unreachable))
      (if (i32.load8_u (i32.const 24)) (then unreachable))
      (call $drop-pollable (local.get $poll)) (call $drop-trailers (local.get $trailers)) (i32.const 202)))
  (core instance $host
    (export "memory" (memory $memory))
    (export "new-fields" (func $new-fields))
    (export "new-request" (func $new-request))
    (export "scheme" (func $scheme))
    (export "authority" (func $authority))
    (export "handle" (func $handle))
    (export "subscribe" (func $subscribe))
    (export "get" (func $get))
    (export "block" (func $block))
    (export "status" (func $status))
    (export "consume" (func $consume))
    (export "stream" (func $stream))
    (export "finish" (func $finish))
    (export "trailers-subscribe" (func $trailers-subscribe))
    (export "trailers-get" (func $trailers-get))
    (export "read" (func $read))
    (export "drop-future" (func $drop-future))
    (export "drop-response" (func $drop-response))
    (export "drop-trailers" (func $drop-trailers))
    (export "drop-pollable" (func $drop-pollable))
    (export "drop-input" (func $drop-input))
  )
  (core instance $code (instantiate $code (with "host" (instance $host))))
  (alias core export $code "run" (core func $run))
  (func (export "run") (param "authority" string) (result u32)
    (canon lift (core func $run) (memory $memory) (realloc $realloc))))
