(component
  (import "wasi:io/poll@0.2.0" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.block" (func (param "self" (borrow $pollable))))))
  (alias export $poll "pollable" (type $pollable))
  (import "wasi:io/error@0.2.0" (instance $errors
    (export "error" (type (sub resource)))))
  (alias export $errors "error" (type $io-error))
  (import "wasi:io/streams@0.2.0" (instance $streams
    (alias outer 1 $io-error (type $io-error))
    (export "error" (type (eq $io-error)))
    (export "input-stream" (type $input (sub resource)))
    (export "output-stream" (type $output (sub resource)))
    (type $stream-error-definition (variant (case "last-operation-failed" (own $io-error)) (case "closed")))
    (export "stream-error" (type $stream-error (eq $stream-error-definition)))
    (export "[method]output-stream.check-write" (func (param "self" (borrow $output)) (result (result u64 (error $stream-error)))))
    (export "[method]output-stream.write" (func (param "self" (borrow $output)) (param "contents" (list u8)) (result (result (error $stream-error)))))
    (export "[method]input-stream.blocking-read" (func (param "self" (borrow $input)) (param "len" u64) (result (result (list u8) (error $stream-error)))))))
  (alias export $streams "input-stream" (type $input))
  (alias export $streams "output-stream" (type $output))

  (import "wasi:http/types@0.2.0" (instance $types
    (alias outer 1 $pollable (type $pollable))
    (alias outer 1 $input (type $input))
    (export "pollable" (type (eq $pollable)))
    (export "input-stream" (type (eq $input)))
    (alias outer 1 $output (type $output))
    (export "output-stream" (type (eq $output)))
    (type $dns-definition (record (field "rcode" (option string)) (field "info-code" (option u16))))
    (export "DNS-error-payload" (type $dns (eq $dns-definition)))
    (type $tls-definition (record (field "alert-id" (option u8)) (field "alert-message" (option string))))
    (export "TLS-alert-received-payload" (type $tls (eq $tls-definition)))
    (type $size-definition (record (field "field-name" (option string)) (field "field-size" (option u32))))
    (export "field-size-payload" (type $size (eq $size-definition)))
    (type $error-definition (variant
      (case "DNS-timeout")
      (case "DNS-error" $dns)
      (case "destination-not-found")
      (case "destination-unavailable")
      (case "destination-IP-prohibited")
      (case "destination-IP-unroutable")
      (case "connection-refused")
      (case "connection-terminated")
      (case "connection-timeout")
      (case "connection-read-timeout")
      (case "connection-write-timeout")
      (case "connection-limit-reached")
      (case "TLS-protocol-error")
      (case "TLS-certificate-error")
      (case "TLS-alert-received" $tls)
      (case "HTTP-request-denied")
      (case "HTTP-request-length-required")
      (case "HTTP-request-body-size" (option u64))
      (case "HTTP-request-method-invalid")
      (case "HTTP-request-URI-invalid")
      (case "HTTP-request-URI-too-long")
      (case "HTTP-request-header-section-size" (option u32))
      (case "HTTP-request-header-size" (option $size))
      (case "HTTP-request-trailer-section-size" (option u32))
      (case "HTTP-request-trailer-size" $size)
      (case "HTTP-response-incomplete")
      (case "HTTP-response-header-section-size" (option u32))
      (case "HTTP-response-header-size" $size)
      (case "HTTP-response-body-size" (option u64))
      (case "HTTP-response-trailer-section-size" (option u32))
      (case "HTTP-response-trailer-size" $size)
      (case "HTTP-response-transfer-coding" (option string))
      (case "HTTP-response-content-coding" (option string))
      (case "HTTP-response-timeout")
      (case "HTTP-upgrade-failed")
      (case "HTTP-protocol-error")
      (case "loop-detected")
      (case "configuration-error")
      (case "internal-error" (option string))))
    (export "error-code" (type $error (eq $error-definition)))
    (export "fields" (type $fields (sub resource)))
    (export "incoming-request" (type $request (sub resource)))
    (export "response-outparam" (type $outparam (sub resource)))
    (export "outgoing-response" (type $response (sub resource)))
    (export "incoming-body" (type $incoming (sub resource)))
    (export "outgoing-body" (type $outgoing (sub resource)))
    (export "future-trailers" (type $trailers (sub resource)))
    (export "[constructor]fields" (func (result (own $fields))))
    (export "[constructor]outgoing-response" (func (param "headers" (own $fields)) (result (own $response))))
    (export "[method]outgoing-response.set-status-code" (func (param "self" (borrow $response)) (param "status-code" u16) (result (result))))
    (export "[method]outgoing-response.body" (func (param "self" (borrow $response)) (result (result (own $outgoing)))))
    (export "[method]outgoing-body.write" (func (param "self" (borrow $outgoing)) (result (result (own $output)))))
    (export "[static]outgoing-body.finish" (func (param "this" (own $outgoing)) (param "trailers" (option (own $fields))) (result (result (error $error)))))
    (export "[static]response-outparam.set" (func (param "param" (own $outparam)) (param "response" (result (own $response) (error $error)))))
    (export "[method]incoming-request.consume" (func (param "self" (borrow $request)) (result (result (own $incoming)))))
    (export "[method]incoming-body.stream" (func (param "self" (borrow $incoming)) (result (result (own $input)))))
    (export "[static]incoming-body.finish" (func (param "this" (own $incoming)) (result (own $trailers))))
  ))
  (alias export $types "incoming-request" (type $incoming-request))
  (alias export $types "response-outparam" (type $response-outparam))
  (alias export $types "outgoing-response" (type $outgoing-response))
  (alias export $types "incoming-body" (type $incoming-body))
  (alias export $types "outgoing-body" (type $outgoing-body))
  (alias export $types "future-trailers" (type $future-trailers))
  (core module $mem
    (memory (export "memory") 1)
    (global $bump (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (i32.and (i32.add (global.get $bump) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $bump (i32.add (local.get $ptr) (local.get $size))) (local.get $ptr)))
  (core instance $mem (instantiate $mem))
  (alias core export $mem "memory" (core memory $memory))
  (alias core export $mem "realloc" (core func $realloc))
  (alias export $types "[constructor]fields" (func $new-fields))
  (core func $new-fields (canon lower (func $new-fields)))
  (alias export $types "[constructor]outgoing-response" (func $new-response))
  (core func $new-response (canon lower (func $new-response)))
  (alias export $types "[method]outgoing-response.set-status-code" (func $status))
  (core func $status (canon lower (func $status)))
  (alias export $types "[method]outgoing-response.body" (func $body))
  (core func $body (canon lower (func $body) (memory $memory)))
  (alias export $types "[method]outgoing-body.write" (func $stream-out))
  (core func $stream-out (canon lower (func $stream-out) (memory $memory)))
  (alias export $types "[static]outgoing-body.finish" (func $finish-out))
  (core func $finish-out (canon lower (func $finish-out) (memory $memory) (realloc $realloc)))
  (alias export $types "[static]response-outparam.set" (func $set))
  (core func $set (canon lower (func $set) (memory $memory)))
  (alias export $types "[method]incoming-request.consume" (func $consume))
  (core func $consume (canon lower (func $consume) (memory $memory)))
  (alias export $types "[method]incoming-body.stream" (func $stream-in))
  (core func $stream-in (canon lower (func $stream-in) (memory $memory)))
  (alias export $types "[static]incoming-body.finish" (func $finish-in))
  (core func $finish-in (canon lower (func $finish-in)))
  (alias export $streams "[method]input-stream.blocking-read" (func $read))
  (core func $read (canon lower (func $read) (memory $memory) (realloc $realloc)))
  (alias export $streams "[method]output-stream.check-write" (func $check-write))
  (core func $check-write (canon lower (func $check-write) (memory $memory)))
  (alias export $streams "[method]output-stream.write" (func $write))
  (core func $write (canon lower (func $write) (memory $memory)))
  (core func $drop-request (canon resource.drop $incoming-request))
  (core func $drop-outparam (canon resource.drop $response-outparam))
  (core func $drop-trailers (canon resource.drop $future-trailers))
  (core func $drop-input (canon resource.drop $input))
  (core func $drop-output (canon resource.drop $output))
  (core module $code
    (import "host" "memory" (memory 1))
    (import "host" "new-fields" (func $new-fields (result i32)))
    (import "host" "new-response" (func $new-response (param i32) (result i32)))
    (import "host" "status" (func $status (param i32 i32) (result i32)))
    (import "host" "body" (func $body (param i32 i32)))
    (import "host" "stream-out" (func $stream-out (param i32 i32)))
    (import "host" "finish-out" (func $finish-out (param i32 i32 i32 i32)))
    (import "host" "set" (func $set (param i32 i32 i32 i32 i64 i32 i32 i32 i32)))
    (import "host" "consume" (func $consume (param i32 i32)))
    (import "host" "stream-in" (func $stream-in (param i32 i32)))
    (import "host" "finish-in" (func $finish-in (param i32) (result i32)))
    (import "host" "read" (func $read (param i32 i64 i32)))
    (import "host" "check-write" (func $check-write (param i32 i32)))
    (import "host" "write" (func $write (param i32 i32 i32 i32)))
    (import "host" "drop-request" (func $drop-request (param i32)))
    (import "host" "drop-outparam" (func $drop-outparam (param i32)))
    (import "host" "drop-trailers" (func $drop-trailers (param i32)))
    (import "host" "drop-input" (func $drop-input (param i32)))
    (import "host" "drop-output" (func $drop-output (param i32)))
    (global $mode (mut i32) (i32.const 0))
    (data (i32.const 512) "pong")
    (func (export "configure") (param i32) (global.set $mode (local.get 0)))
    (func (export "handle") (param $request i32) (param $out i32)
      (local $body i32) (local $input i32) (local $response i32) (local $output i32)
      (local $count i32) (local $n i32) (local $ptr i32) (local $i i32)
      (if (i32.eq (global.get $mode) (i32.const 2)) (then unreachable))
      (if (i32.eq (global.get $mode) (i32.const 4)) (then (loop $spin (br $spin))))
      (if (i32.eq (global.get $mode) (i32.const 1)) (then
        (call $drop-request (local.get $request)) (call $drop-outparam (local.get $out)) (return)))
      (if (i32.eq (global.get $mode) (i32.const 3)) (then
        (call $drop-request (local.get $request))
        (call $set (local.get $out) (i32.const 1) (i32.const 15) (i32.const 0) (i64.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)) (return)))
      (call $consume (local.get $request) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $body (i32.load (i32.const 4)))
      (call $drop-request (local.get $request))
      (call $stream-in (local.get $body) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $input (i32.load (i32.const 4)))
      (loop $read-loop
        (call $read (local.get $input) (i64.const 4) (i32.const 0))
        (if (i32.load8_u (i32.const 0)) (then unreachable))
        (local.set $ptr (i32.load (i32.const 4))) (local.set $n (i32.load (i32.const 8)))
        (local.set $i (i32.const 0))
        (block $end (loop $bytes
          (br_if $end (i32.ge_u (local.get $i) (local.get $n)))
          (if (i32.ge_u (local.get $count) (i32.const 4)) (then unreachable))
          (if (i32.ne (i32.load8_u (i32.add (local.get $ptr) (local.get $i)))
              (i32.load8_u (i32.add (i32.const 512) (local.get $count)))) (then unreachable))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (local.set $count (i32.add (local.get $count) (i32.const 1))) (br $bytes)))
        (br_if $read-loop (i32.lt_u (local.get $count) (i32.const 4))))
      (call $drop-input (local.get $input))
      (call $drop-trailers (call $finish-in (local.get $body)))
      (local.set $response (call $new-response (call $new-fields)))
      (if (call $status (local.get $response) (i32.const 202)) (then unreachable))
      (call $body (local.get $response) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $body (i32.load (i32.const 4)))
      (call $stream-out (local.get $body) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $output (i32.load (i32.const 4)))
      (call $set (local.get $out) (i32.const 0) (local.get $response) (i32.const 0) (i64.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
      (call $check-write (local.get $output) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (if (i64.lt_u (i64.load (i32.const 8)) (i64.const 4)) (then unreachable))
      (call $write (local.get $output) (i32.const 512) (i32.const 4) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (call $drop-output (local.get $output))
      (call $finish-out (local.get $body) (i32.const 0) (i32.const 0) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))))
  (core instance $host (export "memory" (memory $memory))
    (export "new-fields" (func $new-fields))
    (export "new-response" (func $new-response))
    (export "status" (func $status))
    (export "body" (func $body))
    (export "stream-out" (func $stream-out))
    (export "finish-out" (func $finish-out))
    (export "set" (func $set))
    (export "consume" (func $consume))
    (export "stream-in" (func $stream-in))
    (export "finish-in" (func $finish-in))
    (export "read" (func $read))
    (export "check-write" (func $check-write))
    (export "write" (func $write))
    (export "drop-request" (func $drop-request))
    (export "drop-outparam" (func $drop-outparam))
    (export "drop-trailers" (func $drop-trailers))
    (export "drop-input" (func $drop-input))
    (export "drop-output" (func $drop-output))
  )
  (core instance $code (instantiate $code (with "host" (instance $host))))
  (alias core export $code "configure" (core func $configure))
  (func (export "configure") (param "mode" u32) (canon lift (core func $configure)))
  (alias core export $code "handle" (core func $handle))
  (func $handle (param "request" (own $incoming-request)) (param "response-out" (own $response-outparam))
    (canon lift (core func $handle)))
  (instance $incoming-handler
    (export "incoming-request" (type $incoming-request))
    (export "response-outparam" (type $response-outparam))
    (export "handle" (func $handle)))
  (export "wasi:http/incoming-handler@0.2.0" (instance $incoming-handler)))
