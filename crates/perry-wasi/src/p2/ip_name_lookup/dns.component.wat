(component
  (import "wasi:io/poll@0.2.0" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.block" (func (param "self" (borrow $pollable))))))
  (alias export $poll "pollable" (type $pollable))
  (import "wasi:sockets/network@0.2.0" (instance $network
    (export "network" (type $network (sub resource)))
    (type $error (enum "unknown" "access-denied" "not-supported" "invalid-argument" "out-of-memory" "timeout" "concurrency-conflict" "not-in-progress" "would-block" "invalid-state" "new-socket-limit" "address-not-bindable" "address-in-use" "remote-unreachable" "connection-refused" "connection-reset" "connection-aborted" "datagram-too-large" "name-unresolvable" "temporary-resolver-failure" "permanent-resolver-failure"))
    (export "error-code" (type (eq $error)))
    (type $ip (variant (case "ipv4" (tuple u8 u8 u8 u8))
                       (case "ipv6" (tuple u16 u16 u16 u16 u16 u16 u16 u16))))
    (export "ip-address" (type (eq $ip)))))
  (alias export $network "network" (type $network))
  (alias export $network "error-code" (type $error))
  (alias export $network "ip-address" (type $ip))
  (import "wasi:sockets/instance-network@0.2.0" (instance $instance-network
    (alias outer 1 $network (type $network))
    (export "network" (type (eq $network)))
    (export "instance-network" (func (result (own $network))))))
  (import "wasi:sockets/ip-name-lookup@0.2.0" (instance $dns
    (alias outer 1 $network (type $network))
    (alias outer 1 $error (type $error))
    (alias outer 1 $ip (type $ip))
    (alias outer 1 $pollable (type $pollable))
    (export "network" (type (eq $network)))
    (export "error-code" (type (eq $error)))
    (export "ip-address" (type (eq $ip)))
    (export "pollable" (type (eq $pollable)))
    (export "resolve-address-stream" (type $stream (sub resource)))
    (export "resolve-addresses" (func (param "network" (borrow $network))
      (param "name" string) (result (result (own $stream) (error $error)))))
    (export "[method]resolve-address-stream.resolve-next-address" (func
      (param "self" (borrow $stream)) (result (result (option $ip) (error $error)))))
    (export "[method]resolve-address-stream.subscribe" (func
      (param "self" (borrow $stream)) (result (own $pollable))))))
  (alias export $dns "resolve-address-stream" (type $stream))
  (alias export $instance-network "instance-network" (func $get-network))
  (alias export $dns "resolve-addresses" (func $resolve))
  (alias export $dns "[method]resolve-address-stream.resolve-next-address" (func $next))
  (alias export $dns "[method]resolve-address-stream.subscribe" (func $subscribe))
  (alias export $poll "[method]pollable.block" (func $block))
  (core module $mem
    (memory (export "memory") 1)
    (global $bump (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32 i32) (param $size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (global.get $bump))
      (global.set $bump (i32.add (global.get $bump) (local.get $size)))
      (local.get $ptr)))
  (core instance $mem (instantiate $mem))
  (alias core export $mem "memory" (core memory $memory))
  (alias core export $mem "realloc" (core func $realloc))
  (core func $get-network (canon lower (func $get-network)))
  (core func $resolve (canon lower (func $resolve) (memory $memory)))
  (core func $next (canon lower (func $next) (memory $memory)))
  (core func $subscribe (canon lower (func $subscribe)))
  (core func $block (canon lower (func $block)))
  (core func $drop-network (canon resource.drop $network))
  (core func $drop-stream (canon resource.drop $stream))
  (core func $drop-pollable (canon resource.drop $pollable))
  (core module $code
    (import "host" "memory" (memory 1))
    (import "host" "network" (func $network (result i32)))
    (import "host" "resolve" (func $resolve (param i32 i32 i32 i32)))
    (import "host" "next" (func $next (param i32 i32)))
    (import "host" "subscribe" (func $subscribe (param i32) (result i32)))
    (import "host" "block" (func $block (param i32)))
    (import "host" "drop-network" (func $drop-network (param i32)))
    (import "host" "drop-stream" (func $drop-stream (param i32)))
    (import "host" "drop-pollable" (func $drop-pollable (param i32)))
    (func (export "run") (param $name i32) (param $len i32) (param $expected-error i32) (result i32)
      (local $network i32) (local $stream i32) (local $pollable i32) (local $count i32)
      (local.set $network (call $network))
      (call $resolve (local.get $network) (local.get $name) (local.get $len) (i32.const 0))
      (call $drop-network (local.get $network))
      (if (i32.load8_u (i32.const 0)) (then
        (if (i32.ne (i32.load8_u (i32.const 4)) (local.get $expected-error)) (then unreachable))
        (return (i32.const 0))))
      (if (local.get $expected-error) (then unreachable))
      (local.set $stream (i32.load (i32.const 4)))
      (local.set $pollable (call $subscribe (local.get $stream)))
      (call $block (local.get $pollable))
      (call $drop-pollable (local.get $pollable))
      (block $done (loop $again
        (call $next (local.get $stream) (i32.const 64))
        (if (i32.load8_u (i32.const 64)) (then unreachable))
        (br_if $done (i32.eqz (i32.load8_u (i32.const 66))))
        ;; Fixtures resolve loopback only. Check the lifted IPv4/IPv6 payload.
        (if (i32.eqz (i32.load8_u (i32.const 68)))
          (then
            (if (i32.ne (i32.load8_u (i32.const 70)) (i32.const 127)) (then unreachable)))
          (else
            (if (i64.ne (i64.load (i32.const 70)) (i64.const 0)) (then unreachable))
            (if (i32.load (i32.const 78)) (then unreachable))
            (if (i32.load16_u (i32.const 82)) (then unreachable))
            (if (i32.ne (i32.load16_u (i32.const 84)) (i32.const 1)) (then unreachable))))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (if (i32.gt_u (local.get $count) (i32.const 64)) (then unreachable))
        (br $again)))
      ;; Exhaustion remains stable.
      (call $next (local.get $stream) (i32.const 64))
      (if (i32.or (i32.load8_u (i32.const 64)) (i32.load8_u (i32.const 66))) (then unreachable))
      (call $drop-stream (local.get $stream))
      (local.get $count)))
  (core instance $host
    (export "memory" (memory $memory))
    (export "network" (func $get-network))
    (export "resolve" (func $resolve))
    (export "next" (func $next))
    (export "subscribe" (func $subscribe))
    (export "block" (func $block))
    (export "drop-network" (func $drop-network))
    (export "drop-stream" (func $drop-stream))
    (export "drop-pollable" (func $drop-pollable)))
  (core instance $code (instantiate $code (with "host" (instance $host))))
  (alias core export $code "run" (core func $run))
  (func (export "run") (param "name" string) (param "expected-error" u32) (result u32)
    (canon lift (core func $run) (memory $memory) (realloc $realloc))))
