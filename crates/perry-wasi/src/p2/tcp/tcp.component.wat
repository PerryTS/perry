(component
  (import "wasi:io/poll@0.2.0" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.block" (func (param "self" (borrow $pollable))))))
  (alias export $poll "pollable" (type $pollable))
  (import "wasi:io/error@0.2.0" (instance $errors
    (export "error" (type (sub resource)))))
  (alias export $errors "error" (type $io-error))
  (import "wasi:io/streams@0.2.0" (instance $streams
    (alias outer 1 $io-error (type $io-error))
    (export "error" (type (eq $io-error)))
    (export "input-stream" (type $input (sub resource)))
    (export "output-stream" (type $output (sub resource)))
    (type $stream-error-definition (variant (case "last-operation-failed" (own $io-error)) (case "closed")))
    (export "stream-error" (type $stream-error (eq $stream-error-definition)))
    (export "[method]output-stream.check-write" (func (param "self" (borrow $output)) (result (result u64 (error $stream-error)))))
    (export "[method]output-stream.write" (func (param "self" (borrow $output)) (param "contents" (list u8)) (result (result (error $stream-error)))))
    (export "[method]input-stream.blocking-read" (func (param "self" (borrow $input)) (param "len" u64) (result (result (list u8) (error $stream-error)))))))
  (alias export $streams "input-stream" (type $input))
  (alias export $streams "output-stream" (type $output))
  (import "wasi:sockets/network@0.2.0" (instance $network
    (export "network" (type $network (sub resource)))
    (type $error (enum "unknown" "access-denied" "not-supported" "invalid-argument" "out-of-memory" "timeout" "concurrency-conflict" "not-in-progress" "would-block" "invalid-state" "new-socket-limit" "address-not-bindable" "address-in-use" "remote-unreachable" "connection-refused" "connection-reset" "connection-aborted" "datagram-too-large" "name-unresolvable" "temporary-resolver-failure" "permanent-resolver-failure"))
    (export "error-code" (type (eq $error)))
    (type $family (enum "ipv4" "ipv6"))
    (export "ip-address-family" (type (eq $family)))
    (type $v4-definition (record (field "port" u16) (field "address" (tuple u8 u8 u8 u8))))
    (export "ipv4-socket-address" (type $v4 (eq $v4-definition)))
    (type $v6-definition (record (field "port" u16) (field "flow-info" u32) (field "address" (tuple u16 u16 u16 u16 u16 u16 u16 u16)) (field "scope-id" u32)))
    (export "ipv6-socket-address" (type $v6 (eq $v6-definition)))
    (type $address (variant (case "ipv4" $v4) (case "ipv6" $v6)))
    (export "ip-socket-address" (type (eq $address)))))
  (alias export $network "network" (type $network))
  (alias export $network "error-code" (type $error))
  (alias export $network "ip-address-family" (type $family))
  (alias export $network "ip-socket-address" (type $address))
  (import "wasi:sockets/instance-network@0.2.0" (instance $instance-network
    (alias outer 1 $network (type $network))
    (export "network" (type (eq $network)))
    (export "instance-network" (func (result (own $network))))))
  (import "wasi:sockets/tcp@0.2.0" (instance $tcp
    (alias outer 1 $network (type $network))
    (alias outer 1 $error (type $error))
    (alias outer 1 $address (type $address))
    (alias outer 1 $pollable (type $pollable))
    (alias outer 1 $input (type $input))
    (alias outer 1 $output (type $output))
    (export "network" (type (eq $network)))
    (export "error-code" (type (eq $error)))
    (export "ip-socket-address" (type (eq $address)))
    (export "pollable" (type (eq $pollable)))
    (export "input-stream" (type (eq $input)))
    (export "output-stream" (type (eq $output)))
    (export "tcp-socket" (type $socket (sub resource)))
    (type $shutdown-definition (enum "receive" "send" "both"))
    (export "shutdown-type" (type $shutdown (eq $shutdown-definition)))
    (export "[method]tcp-socket.start-connect" (func (param "self" (borrow $socket)) (param "network" (borrow $network)) (param "remote-address" $address) (result (result (error $error)))))
    (export "[method]tcp-socket.finish-connect" (func (param "self" (borrow $socket)) (result (result (tuple (own $input) (own $output)) (error $error)))))
    (export "[method]tcp-socket.subscribe" (func (param "self" (borrow $socket)) (result (own $pollable))))
    (export "[method]tcp-socket.shutdown" (func (param "self" (borrow $socket)) (param "shutdown-type" $shutdown) (result (result (error $error)))))))
  (alias export $tcp "tcp-socket" (type $socket))
  (import "wasi:sockets/tcp-create-socket@0.2.0" (instance $create
    (alias outer 1 $socket (type $socket))
    (alias outer 1 $error (type $error))
    (alias outer 1 $family (type $family))
    (export "tcp-socket" (type (eq $socket)))
    (export "error-code" (type (eq $error)))
    (export "ip-address-family" (type (eq $family)))
    (export "create-tcp-socket" (func (param "address-family" $family) (result (result (own $socket) (error $error)))))))
  (core module $mem
    (memory (export "memory") 1)
    (global $bump (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (i32.and (i32.add (global.get $bump) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $bump (i32.add (local.get $ptr) (local.get $size))) (local.get $ptr)))
  (core instance $mem (instantiate $mem))
  (alias core export $mem "memory" (core memory $memory))
  (alias core export $mem "realloc" (core func $realloc))
  (alias export $instance-network "instance-network" (func $network))
  (core func $network (canon lower (func $network)))
  (alias export $create "create-tcp-socket" (func $create))
  (core func $create (canon lower (func $create) (memory $memory)))
  (alias export $tcp "[method]tcp-socket.start-connect" (func $connect))
  (core func $connect (canon lower (func $connect) (memory $memory)))
  (alias export $tcp "[method]tcp-socket.finish-connect" (func $finish))
  (core func $finish (canon lower (func $finish) (memory $memory)))
  (alias export $tcp "[method]tcp-socket.subscribe" (func $subscribe))
  (core func $subscribe (canon lower (func $subscribe)))
  (alias export $tcp "[method]tcp-socket.shutdown" (func $shutdown))
  (core func $shutdown (canon lower (func $shutdown) (memory $memory)))
  (alias export $poll "[method]pollable.block" (func $block))
  (core func $block (canon lower (func $block)))
  (alias export $streams "[method]output-stream.check-write" (func $check))
  (core func $check (canon lower (func $check) (memory $memory)))
  (alias export $streams "[method]output-stream.write" (func $write))
  (core func $write (canon lower (func $write) (memory $memory)))
  (alias export $streams "[method]input-stream.blocking-read" (func $read))
  (core func $read (canon lower (func $read) (memory $memory) (realloc $realloc)))
  (core func $drop-network (canon resource.drop $network))
  (core func $drop-socket (canon resource.drop $socket))
  (core func $drop-pollable (canon resource.drop $pollable))
  (core func $drop-input (canon resource.drop $input))
  (core func $drop-output (canon resource.drop $output))
  (core module $code
    (import "host" "memory" (memory 1))
    (import "host" "network" (func $network (result i32)))
    (import "host" "create" (func $create (param i32 i32)))
    (import "host" "connect" (func $connect (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "host" "finish" (func $finish (param i32 i32)))
    (import "host" "subscribe" (func $subscribe (param i32) (result i32)))
    (import "host" "shutdown" (func $shutdown (param i32 i32 i32)))
    (import "host" "block" (func $block (param i32)))
    (import "host" "check" (func $check (param i32 i32)))
    (import "host" "write" (func $write (param i32 i32 i32 i32)))
    (import "host" "read" (func $read (param i32 i64 i32)))
    (import "host" "drop-network" (func $drop-network (param i32)))
    (import "host" "drop-socket" (func $drop-socket (param i32)))
    (import "host" "drop-pollable" (func $drop-pollable (param i32)))
    (import "host" "drop-input" (func $drop-input (param i32)))
    (import "host" "drop-output" (func $drop-output (param i32)))
    (data (i32.const 256) "pingpong")
    (func (export "run") (param $port i32) (result i32)
      (local $network i32) (local $socket i32) (local $poll i32) (local $input i32) (local $output i32) (local $count i32)
      (local.set $network (call $network))
      (call $create (i32.const 0) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $socket (i32.load (i32.const 4)))
      ;; IPv4 payload: port, 127.0.0.1, then the unused IPv6 union slots.
      (call $connect (local.get $socket) (local.get $network)
        (i32.const 0) (local.get $port) (i32.const 127) (i32.const 0) (i32.const 0) (i32.const 1)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $poll (call $subscribe (local.get $socket)))
      (call $block (local.get $poll))
      (call $finish (local.get $socket) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $input (i32.load (i32.const 4)))
      (local.set $output (i32.load (i32.const 8)))
      (call $drop-pollable (local.get $poll))
      (call $check (local.get $output) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (if (i64.lt_u (i64.load (i32.const 8)) (i64.const 4)) (then unreachable))
      (call $write (local.get $output) (i32.const 256) (i32.const 4) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      ;; The peer waits for FIN before replying. No output polling follows.
      (call $shutdown (local.get $socket) (i32.const 1) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (block $eof (loop $read
        (call $read (local.get $input) (i64.const 1) (i32.const 0))
        (if (i32.load8_u (i32.const 0)) (then
          (if (i32.ne (i32.load8_u (i32.const 4)) (i32.const 1)) (then unreachable))
          (br $eof)))
        (if (i32.ne (i32.load (i32.const 8)) (i32.const 1)) (then unreachable))
        (if (i32.ge_u (local.get $count) (i32.const 4)) (then unreachable))
        (if (i32.ne (i32.load8_u (i32.load (i32.const 4))) (i32.load8_u (i32.add (i32.const 260) (local.get $count)))) (then unreachable))
        (local.set $count (i32.add (local.get $count) (i32.const 1))) (br $read)))
      (call $drop-input (local.get $input))
      (call $drop-output (local.get $output))
      (call $drop-socket (local.get $socket))
      (call $drop-network (local.get $network))
      (local.get $count)))
  (core instance $host
    (export "memory" (memory $memory))
    (export "network" (func $network))
    (export "create" (func $create))
    (export "connect" (func $connect))
    (export "finish" (func $finish))
    (export "subscribe" (func $subscribe))
    (export "shutdown" (func $shutdown))
    (export "block" (func $block))
    (export "check" (func $check))
    (export "write" (func $write))
    (export "read" (func $read))
    (export "drop-network" (func $drop-network))
    (export "drop-socket" (func $drop-socket))
    (export "drop-pollable" (func $drop-pollable))
    (export "drop-input" (func $drop-input))
    (export "drop-output" (func $drop-output))
  )
  (core instance $code (instantiate $code (with "host" (instance $host))))
  (alias core export $code "run" (core func $run))
  (func (export "run") (param "port" u16) (result u32)
    (canon lift (core func $run))))
