(component
  (import "wasi:io/poll@0.2.0" (instance $poll
    (export "pollable" (type $pollable (sub resource)))
    (export "[method]pollable.block" (func (param "self" (borrow $pollable))))))
  (alias export $poll "pollable" (type $pollable))
  (import "wasi:sockets/network@0.2.0" (instance $network
    (export "network" (type $network (sub resource)))
    (type $error (enum "unknown" "access-denied" "not-supported" "invalid-argument" "out-of-memory" "timeout" "concurrency-conflict" "not-in-progress" "would-block" "invalid-state" "new-socket-limit" "address-not-bindable" "address-in-use" "remote-unreachable" "connection-refused" "connection-reset" "connection-aborted" "datagram-too-large" "name-unresolvable" "temporary-resolver-failure" "permanent-resolver-failure"))
    (export "error-code" (type (eq $error)))
    (type $family (enum "ipv4" "ipv6"))
    (export "ip-address-family" (type (eq $family)))
    (type $v4-definition (record (field "port" u16) (field "address" (tuple u8 u8 u8 u8))))
    (export "ipv4-socket-address" (type $v4 (eq $v4-definition)))
    (type $v6-definition (record (field "port" u16) (field "flow-info" u32) (field "address" (tuple u16 u16 u16 u16 u16 u16 u16 u16)) (field "scope-id" u32)))
    (export "ipv6-socket-address" (type $v6 (eq $v6-definition)))
    (type $address (variant (case "ipv4" $v4) (case "ipv6" $v6)))
    (export "ip-socket-address" (type (eq $address)))))
  (alias export $network "network" (type $network))
  (alias export $network "error-code" (type $error))
  (alias export $network "ip-address-family" (type $family))
  (alias export $network "ip-socket-address" (type $address))
  (import "wasi:sockets/instance-network@0.2.0" (instance $instance-network
    (alias outer 1 $network (type $network))
    (export "network" (type (eq $network)))
    (export "instance-network" (func (result (own $network))))))
  (import "wasi:sockets/udp@0.2.0" (instance $udp
    (alias outer 1 $network (type $network))
    (alias outer 1 $error (type $error))
    (alias outer 1 $address (type $address))
    (alias outer 1 $pollable (type $pollable))
    (export "network" (type (eq $network)))
    (export "error-code" (type (eq $error)))
    (export "ip-socket-address" (type (eq $address)))
    (export "pollable" (type (eq $pollable)))
    (export "udp-socket" (type $socket (sub resource)))
    (export "incoming-datagram-stream" (type $input (sub resource)))
    (export "outgoing-datagram-stream" (type $output (sub resource)))
    (type $incoming-def (record (field "data" (list u8)) (field "remote-address" $address)))
    (export "incoming-datagram" (type $incoming (eq $incoming-def)))
    (type $outgoing-def (record (field "data" (list u8)) (field "remote-address" (option $address))))
    (export "outgoing-datagram" (type $outgoing (eq $outgoing-def)))
    (export "[method]udp-socket.start-bind" (func (param "self" (borrow $socket)) (param "network" (borrow $network)) (param "local-address" $address) (result (result (error $error)))))
    (export "[method]udp-socket.finish-bind" (func (param "self" (borrow $socket)) (result (result (error $error)))))
    (export "[method]udp-socket.stream" (func (param "self" (borrow $socket)) (param "remote-address" (option $address)) (result (result (tuple (own $input) (own $output)) (error $error)))))
    (export "[method]incoming-datagram-stream.subscribe" (func (param "self" (borrow $input)) (result (own $pollable))))
    (export "[method]incoming-datagram-stream.receive" (func (param "self" (borrow $input)) (param "max-results" u64) (result (result (list $incoming) (error $error)))))
    (export "[method]outgoing-datagram-stream.subscribe" (func (param "self" (borrow $output)) (result (own $pollable))))
    (export "[method]outgoing-datagram-stream.check-send" (func (param "self" (borrow $output)) (result (result u64 (error $error)))))
    (export "[method]outgoing-datagram-stream.send" (func (param "self" (borrow $output)) (param "datagrams" (list $outgoing)) (result (result u64 (error $error)))))))
  (alias export $udp "udp-socket" (type $socket))
  (alias export $udp "incoming-datagram-stream" (type $input))
  (alias export $udp "outgoing-datagram-stream" (type $output))
  (import "wasi:sockets/udp-create-socket@0.2.0" (instance $create
    (alias outer 1 $socket (type $socket))
    (alias outer 1 $error (type $error))
    (alias outer 1 $family (type $family))
    (export "udp-socket" (type (eq $socket)))
    (export "error-code" (type (eq $error)))
    (export "ip-address-family" (type (eq $family)))
    (export "create-udp-socket" (func (param "address-family" $family) (result (result (own $socket) (error $error)))))))
  (core module $mem
    (memory (export "memory") 1)
    (global $bump (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (i32.and (i32.add (global.get $bump) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $bump (i32.add (local.get $ptr) (local.get $size))) (local.get $ptr)))
  (core instance $mem (instantiate $mem))
  (alias core export $mem "memory" (core memory $memory))
  (alias core export $mem "realloc" (core func $realloc))
  (alias export $instance-network "instance-network" (func $network))
  (core func $network (canon lower (func $network)))
  (alias export $create "create-udp-socket" (func $create))
  (core func $create (canon lower (func $create) (memory $memory)))
  (alias export $udp "[method]udp-socket.start-bind" (func $bind))
  (core func $bind (canon lower (func $bind) (memory $memory)))
  (alias export $udp "[method]udp-socket.finish-bind" (func $finish))
  (core func $finish (canon lower (func $finish) (memory $memory)))
  (alias export $udp "[method]udp-socket.stream" (func $stream))
  (core func $stream (canon lower (func $stream) (memory $memory)))
  (alias export $udp "[method]incoming-datagram-stream.subscribe" (func $subscribe-in))
  (core func $subscribe-in (canon lower (func $subscribe-in)))
  (alias export $udp "[method]outgoing-datagram-stream.subscribe" (func $subscribe-out))
  (core func $subscribe-out (canon lower (func $subscribe-out)))
  (alias export $udp "[method]incoming-datagram-stream.receive" (func $receive))
  (core func $receive (canon lower (func $receive) (memory $memory) (realloc $realloc)))
  (alias export $udp "[method]outgoing-datagram-stream.check-send" (func $check))
  (core func $check (canon lower (func $check) (memory $memory)))
  (alias export $udp "[method]outgoing-datagram-stream.send" (func $send))
  (core func $send (canon lower (func $send) (memory $memory)))
  (alias export $poll "[method]pollable.block" (func $block))
  (core func $block (canon lower (func $block)))
  (core func $drop-network (canon resource.drop $network))
  (core func $drop-socket (canon resource.drop $socket))
  (core func $drop-input (canon resource.drop $input))
  (core func $drop-output (canon resource.drop $output))
  (core func $drop-pollable (canon resource.drop $pollable))
  (core module $code
    (import "host" "memory" (memory 1))
    (import "host" "network" (func $network (result i32)))
    (import "host" "create" (func $create (param i32 i32)))
    (import "host" "bind" (func $bind (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "host" "finish" (func $finish (param i32 i32)))
    (import "host" "stream" (func $stream (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "host" "subscribe-in" (func $subscribe-in (param i32) (result i32)))
    (import "host" "subscribe-out" (func $subscribe-out (param i32) (result i32)))
    (import "host" "receive" (func $receive (param i32 i64 i32)))
    (import "host" "check" (func $check (param i32 i32)))
    (import "host" "send" (func $send (param i32 i32 i32 i32)))
    (import "host" "block" (func $block (param i32)))
    (import "host" "drop-network" (func $drop-network (param i32)))
    (import "host" "drop-socket" (func $drop-socket (param i32)))
    (import "host" "drop-input" (func $drop-input (param i32)))
    (import "host" "drop-output" (func $drop-output (param i32)))
    (import "host" "drop-pollable" (func $drop-pollable (param i32)))
    (func (export "run") (param $port i32) (result i32)
      (local $network i32) (local $socket i32) (local $input i32) (local $output i32) (local $poll i32) (local $packet i32)
      (local.set $network (call $network))
      (call $create (i32.const 0) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $socket (i32.load (i32.const 4)))
      (call $bind (local.get $socket) (local.get $network)
        (i32.const 0) (i32.const 0) (i32.const 127) (i32.const 0) (i32.const 0) (i32.const 1)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (call $finish (local.get $socket) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (call $stream (local.get $socket) (i32.const 1)
        (i32.const 0) (local.get $port) (i32.const 127) (i32.const 0) (i32.const 0) (i32.const 1)
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (local.set $input (i32.load (i32.const 4)))
      (local.set $output (i32.load (i32.const 8)))
      (call $check (local.get $output) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (if (i64.lt_u (i64.load (i32.const 8)) (i64.const 1)) (then unreachable))
      ;; One zero-filled outgoing record: empty payload and no explicit peer.
      (call $send (local.get $output) (i32.const 256) (i32.const 1) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (if (i64.ne (i64.load (i32.const 8)) (i64.const 1)) (then unreachable))
      (local.set $poll (call $subscribe-out (local.get $output)))
      (call $block (local.get $poll))
      (call $drop-pollable (local.get $poll))
      (local.set $poll (call $subscribe-in (local.get $input)))
      (call $block (local.get $poll))
      (call $receive (local.get $input) (i64.const 1) (i32.const 0))
      (if (i32.load8_u (i32.const 0)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 8)) (i32.const 1)) (then unreachable))
      (local.set $packet (i32.load (i32.const 4)))
      (if (i32.ne (i32.load offset=4 (local.get $packet)) (i32.const 4)) (then unreachable))
      (if (i32.ne (i32.load (i32.load (local.get $packet))) (i32.const 1735290736)) (then unreachable))
      (if (i32.load8_u offset=8 (local.get $packet)) (then unreachable))
      (if (i32.ne (i32.load16_u offset=12 (local.get $packet)) (local.get $port)) (then unreachable))
      (if (i32.ne (i32.load offset=14 (local.get $packet)) (i32.const 16777343)) (then unreachable))
      (call $drop-pollable (local.get $poll))
      (call $drop-input (local.get $input))
      (call $drop-output (local.get $output))
      (call $drop-socket (local.get $socket))
      (call $drop-network (local.get $network))
      (i32.const 4)))
  (core instance $host
    (export "memory" (memory $memory))
    (export "network" (func $network))
    (export "create" (func $create))
    (export "bind" (func $bind))
    (export "finish" (func $finish))
    (export "stream" (func $stream))
    (export "subscribe-in" (func $subscribe-in))
    (export "subscribe-out" (func $subscribe-out))
    (export "receive" (func $receive))
    (export "check" (func $check))
    (export "send" (func $send))
    (export "block" (func $block))
    (export "drop-network" (func $drop-network))
    (export "drop-socket" (func $drop-socket))
    (export "drop-input" (func $drop-input))
    (export "drop-output" (func $drop-output))
    (export "drop-pollable" (func $drop-pollable))
  )
  (core instance $code (instantiate $code (with "host" (instance $host))))
  (alias core export $code "run" (core func $run))
  (func (export "run") (param "port" u32) (result u32) (canon lift (core func $run)))
)
