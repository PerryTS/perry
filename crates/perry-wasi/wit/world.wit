package perry:wasi-providers;

// Provider migration is incremental. Filesystem, CLI and socket interfaces are
// added here as their implementations are ported; they are not stubbed.
world providers {
  include wasi:io/imports@0.2.12;
  include wasi:clocks/imports@0.2.12;
  include wasi:random/imports@0.2.12;
  import wasi:http/types@0.2.12;
  import wasi:http/outgoing-handler@0.2.12;
  include wasi:filesystem/imports@0.2.12;
  import wasi:sockets/network@0.2.12;
  import wasi:sockets/tcp@0.2.12;
  import wasi:sockets/tcp-create-socket@0.2.12;
  import wasi:sockets/udp@0.2.12;
  import wasi:sockets/udp-create-socket@0.2.12;
  import wasi:sockets/instance-network@0.2.12;
  import wasi:sockets/ip-name-lookup@0.2.12;
  import wasi:cli/environment@0.2.12;
  import wasi:cli/exit@0.2.12;
  import wasi:cli/stdin@0.2.12;
  import wasi:cli/stdout@0.2.12;
  import wasi:cli/stderr@0.2.12;
  import wasi:cli/terminal-input@0.2.12;
  import wasi:cli/terminal-output@0.2.12;
  import wasi:cli/terminal-stdin@0.2.12;
  import wasi:cli/terminal-stdout@0.2.12;
  import wasi:cli/terminal-stderr@0.2.12;
}

// Export contract used by the one-shot command host; imported capabilities are
// registered independently by the provider linker.
world command-entry {
  export wasi:cli/run@0.2.12;
}

// HTTP resources share the same I/O resource identities as the base providers.
world http-provider {
  import wasi:http/types@0.2.12;
  import wasi:http/outgoing-handler@0.2.12;
  export wasi:http/incoming-handler@0.2.12;
}
