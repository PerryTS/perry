(component
  (type $bytes (list u8))
  (type $payload (tuple u64 string $bytes))
  (type $data (future $payload))
  (type $strings (stream string))
  (type $void (future))
  (type $units (stream))
  (type $inner (future u32))
  (type $nested (future $inner))
  (core module $code (func (export "echo") (param i32) (result i32) (local.get 0)))
  (core instance $code (instantiate $code))
  (func (export "data") (param "value" $data) (result $data) (canon lift (core func $code "echo")))
  (func (export "strings") (param "value" $strings) (result $strings) (canon lift (core func $code "echo")))
  (func (export "void") (param "value" $void) (result $void) (canon lift (core func $code "echo")))
  (func (export "units") (param "value" $units) (result $units) (canon lift (core func $code "echo")))
  (func (export "nested") (param "value" $nested) (result $nested) (canon lift (core func $code "echo"))))
