(component
  ;; Define callback trampolines before instantiating the main core module.
  ;; Fill them afterwards; the async lift and lowered self-call remain private.
  (core module $proxy
    (type $entry (func (param i32) (result i32)))
    (type $callback (func (param i32 i32 i32) (result i32)))
    (table (export "table") 2 funcref)
    (func (export "entry") (type $entry) (param i32) (result i32)
      (call_indirect (type $entry) (local.get 0) (i32.const 0)))
    (func (export "callback") (type $callback) (param i32 i32 i32) (result i32)
      (call_indirect (type $callback) (local.get 0) (local.get 1) (local.get 2) (i32.const 1))))
  (core instance $proxy (instantiate $proxy))
  (func $actor async (param "writer" u32)
    (canon lift (core func $proxy "entry") async (callback (core func $proxy "callback"))))
  (core func $actor (canon lower (func $actor) async))
  (core module $heap
    (memory (export "memory") 1)
    (data (i32.const 128) "AB"))
  (core instance $heap (instantiate $heap))
  (alias core export $heap "memory" (core memory $memory))
  (type $stream (stream u8))
  (core func $new (canon stream.new $stream))
  (core func $write (canon stream.write $stream async (memory $memory)))
  (core func $drop (canon stream.drop-writable $stream))
  (core func $return (canon task.return))
  (core func $drop-child (canon subtask.drop))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core module $main
    (import "env" "actor" (func $actor (param i32) (result i32)))
    (import "env" "new" (func $new (result i64)))
    (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
    (import "env" "drop" (func $drop (param i32)))
    (import "env" "return" (func $return))
    (import "env" "drop-child" (func $drop-child (param i32)))
    (import "env" "new-set" (func $new-set (result i32)))
    (import "env" "join" (func $join (param i32 i32)))
    (import "env" "drop-set" (func $drop-set (param i32)))
    (global $child (mut i32) (i32.const 0))
    (global $writer (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (global $phase (mut i32) (i32.const 0))
    (global $finished (mut i32) (i32.const 0))
    (func $send (result i32)
      (if (i32.ne
          (call $write (global.get $writer) (i32.add (i32.const 128) (global.get $phase)) (i32.const 1))
          (i32.const -1)) (then unreachable))
      (call $join (global.get $writer) (global.get $set))
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func (export "make") (result i32) (local $pair i64) (local $status i32)
      (local.set $pair (call $new))
      (local.set $status (call $actor (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32)))))
      ;; The synchronous factory holds the instance's exclusive lease.
      (if (i32.ne (i32.and (local.get $status) (i32.const 15)) (i32.const 0)) (then unreachable))
      (global.set $child (i32.shr_u (local.get $status) (i32.const 4)))
      (i32.wrap_i64 (local.get $pair)))
    (func (export "actor") (param i32) (result i32)
      (global.set $writer (local.get 0))
      (global.set $set (call $new-set))
      (call $return)
      (call $drop-child (global.get $child))
      (call $send))
    (func (export "callback") (param i32 i32 i32) (result i32)
      (if (i32.ne (local.get 0) (i32.const 3)) (then unreachable))
      (if (i32.ne (local.get 1) (global.get $writer)) (then unreachable))
      (if (i32.ne (local.get 2) (i32.const 16)) (then unreachable))
      (global.set $phase (i32.add (global.get $phase) (i32.const 1)))
      (if (result i32) (i32.eq (global.get $phase) (i32.const 1))
        (then (call $send))
        (else
          (call $drop (global.get $writer))
          (call $drop-set (global.get $set))
          (global.set $finished (i32.const 1))
          (i32.const 0))))
    (func (export "finished") (result i32) (global.get $finished)))
  (core instance $main (instantiate $main (with "env" (instance
    (export "actor" (func $actor)) (export "new" (func $new))
    (export "write" (func $write)) (export "drop" (func $drop))
    (export "return" (func $return)) (export "drop-child" (func $drop-child))
    (export "new-set" (func $new-set)) (export "join" (func $join))
    (export "drop-set" (func $drop-set))))))
  (core module $fill
    (import "env" "table" (table 2 funcref))
    (import "env" "entry" (func $entry (param i32) (result i32)))
    (import "env" "callback" (func $callback (param i32 i32 i32) (result i32)))
    (elem (i32.const 0) func $entry $callback))
  (core instance $filled (instantiate $fill (with "env" (instance
    (export "table" (table $proxy "table"))
    (export "entry" (func $main "actor"))
    (export "callback" (func $main "callback"))))))
  (func (export "make") (result $stream) (canon lift (core func $main "make")))
  (func (export "finished") (result u32) (canon lift (core func $main "finished"))))
