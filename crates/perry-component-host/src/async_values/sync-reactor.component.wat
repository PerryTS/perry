(component
  (component $producer
  (core module $heap
    (memory (export "memory") 1)
    (data (i32.const 128) "AB"))
  (core instance $heap (instantiate $heap))
  (alias core export $heap "memory" (core memory $memory))
  (type $stream-private (stream u8))
  (export $stream "bytes" (type $stream-private))
  (core func $new (canon stream.new $stream))
  (core func $write (canon stream.write $stream async (memory $memory)))
  (core func $drop (canon stream.drop-writable $stream))
  (core func $return (canon task.return (result $stream)))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core module $main
    (import "env" "new" (func $new (result i64)))
    (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
    (import "env" "drop" (func $drop (param i32)))
    (import "env" "return" (func $return (param i32)))
    (import "env" "new-set" (func $new-set (result i32)))
    (import "env" "join" (func $join (param i32 i32)))
    (import "env" "drop-set" (func $drop-set (param i32)))
    (global $writer (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (global $phase (mut i32) (i32.const 0))
    (global $finished (mut i32) (i32.const 0))
    (func $send (result i32)
      (if (i32.ne
          (call $write (global.get $writer) (i32.add (i32.const 128) (global.get $phase)) (i32.const 1))
          (i32.const -1)) (then unreachable))
      (call $join (global.get $writer) (global.get $set))
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func (export "make") (result i32) (local $pair i64)
      (local.set $pair (call $new))
      (global.set $writer (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
      (global.set $set (call $new-set))
      (call $return (i32.wrap_i64 (local.get $pair)))
      (call $send))
    (func (export "callback") (param i32 i32 i32) (result i32)
      (if (i32.ne (local.get 0) (i32.const 3)) (then unreachable))
      (if (i32.ne (local.get 1) (global.get $writer)) (then unreachable))
      (if (i32.ne (local.get 2) (i32.const 16)) (then unreachable))
      (global.set $phase (i32.add (global.get $phase) (i32.const 1)))
      (if (result i32) (i32.eq (global.get $phase) (i32.const 1))
        (then (call $send))
        (else
          (call $drop (global.get $writer))
          (call $drop-set (global.get $set))
          (global.set $finished (i32.const 1))
          (i32.const 0))))
    (func (export "finished") (result i32) (global.get $finished)))
  (core instance $main (instantiate $main (with "env" (instance
    (export "new" (func $new))
    (export "write" (func $write)) (export "drop" (func $drop))
    (export "return" (func $return))
    (export "new-set" (func $new-set)) (export "join" (func $join))
    (export "drop-set" (func $drop-set))))))
  (func (export "make") async (result $stream)
    (canon lift (core func $main "make") async (callback (core func $main "callback"))))
  (func (export "finished") (result u32) (canon lift (core func $main "finished"))))
  (instance $producer (instantiate $producer))
  (alias export $producer "bytes" (type $stream))
  (alias export $producer "make" (func $make))
  ;; Keep the producer and facade as siblings: calls through equal or
  ;; ancestor component instances are rejected by canonical adapter validation.
  (component $facade
    (type $stream (stream u8))
    (import "make" (func $make async (result $stream)))
    (core func $make (canon lower (func $make)))
    (core module $wrapper
      (import "host" "make" (func $make (result i32)))
      (func (export "make") (result i32) (call $make)))
    (core instance $wrapper (instantiate $wrapper (with "host" (instance (export "make" (func $make))))))
    (func (export "make") (result $stream) (canon lift (core func $wrapper "make"))))
  (instance $facade (instantiate $facade (with "make" (func $make))))
  (alias export $facade "make" (func $public-make))
  (export "make" (func $public-make))
  (alias export $producer "finished" (func $finished))
  (export "finished" (func $finished)))
