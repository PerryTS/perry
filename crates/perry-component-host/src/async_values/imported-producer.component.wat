(component
  (import "test:host/types" (instance $input-types
    (export "thing" (type $thing (sub resource)))
    (export "make" (func (result (own $thing))))))
  (alias export $input-types "thing" (type $thing))
  (alias export $input-types "make" (func $host-make))
  (core module $support
    (memory (export "memory") 1)
    (global $drops (mut i32) (i32.const 0))
    (func (export "drop") (param i32)
      (if (i32.ne (local.get 0) (i32.const 77)) (then unreachable))
      (global.set $drops (i32.add (global.get $drops) (i32.const 1))))
    (func (export "drops") (result i32) (global.get $drops)))
  (core instance $support (instantiate $support))
  (alias core export $support "memory" (core memory $memory))
  (instance $types (export "thing" (type $thing)))
  (export "types" (instance $types))
  (type $future (future (own $thing)))
  (core func $new-thing (canon lower (func $host-make)))
  (core func $drop-thing (canon resource.drop $thing))
  (core func $new (canon future.new $future))
  (core func $write (canon future.write $future async (memory $memory)))
  (core func $drop (canon future.drop-writable $future))
  (core func $return (canon task.return (result $future)))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core module $code
    (import "env" "memory" (memory 1))
    (import "env" "new-thing" (func $new-thing (result i32)))
    (import "env" "drop-thing" (func $drop-thing (param i32)))
    (import "env" "new" (func $new (result i64)))
    (import "env" "write" (func $write (param i32 i32) (result i32)))
    (import "env" "drop" (func $drop (param i32)))
    (import "env" "return" (func $return (param i32)))
    (import "env" "new-set" (func $new-set (result i32)))
    (import "env" "join" (func $join (param i32 i32)))
    (import "env" "drop-set" (func $drop-set (param i32)))
    (global $writer (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (func $finish (param $status i32) (result i32)
      (if (i32.eq (i32.and (local.get $status) (i32.const 15)) (i32.const 1))
        (then (call $drop-thing (i32.load (i32.const 0)))))
      (call $drop (global.get $writer))
      (call $drop-set (global.get $set))
      (i32.const 0))
    (func (export "make") (result i32) (local $packed i64) (local $status i32)
      (global.set $set (call $new-set))
      (local.set $packed (call $new))
      (global.set $writer (i32.wrap_i64 (i64.shr_u (local.get $packed) (i64.const 32))))
      (i32.store (i32.const 0) (call $new-thing))
      (call $return (i32.wrap_i64 (local.get $packed)))
      (local.set $status (call $write (global.get $writer) (i32.const 0)))
      (if (result i32) (i32.eq (local.get $status) (i32.const -1))
        (then
          (call $join (global.get $writer) (global.get $set))
          (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
        (else (call $finish (local.get $status)))))
    (func (export "callback") (param i32 i32 i32) (result i32)
      (if (i32.ne (local.get 0) (i32.const 5)) (then unreachable))
      (if (i32.ne (local.get 1) (global.get $writer)) (then unreachable))
      (call $finish (local.get 2))))
  (core instance $code (instantiate $code (with "env" (instance
    (export "memory" (memory $memory)) (export "new-thing" (func $new-thing))
    (export "drop-thing" (func $drop-thing))
    (export "new" (func $new)) (export "write" (func $write))
    (export "drop" (func $drop)) (export "return" (func $return))
    (export "new-set" (func $new-set)) (export "join" (func $join))
    (export "drop-set" (func $drop-set))))))
  (func $make (export "make") async (result $future)
    (canon lift (core func $code "make") async (callback (core func $code "callback"))))
  (func $drops (export "drops") (result u32) (canon lift (core func $support "drops")))
  (core func $consume (canon resource.drop $thing))
  (core module $consumer
    (import "host" "drop" (func $drop (param i32)))
    (func (export "consume") (param i32) (call $drop (local.get 0))))
  (core instance $consumer (instantiate $consumer (with "host" (instance (export "drop" (func $consume))))))
  (func $consume (export "consume") (param "value" (own $thing)) (canon lift (core func $consumer "consume")))
)
