;; Private functions only: writer integers never cross the public transport.
;; The embedding owns each writer, serializes writes, and retires the Store
;; on producer failure. An unwritten future writer cannot simply be dropped.
(func (export "writer-new") (result i32) (local $pair i64) (local $p i32)
  (local.set $pair (call $writer-new))
  (local.set $p (call $alloc (i32.const 8)))
  (i32.store (local.get $p) (i32.wrap_i64 (local.get $pair)))
  (i32.store offset=4 (local.get $p) (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
  (local.get $p))
(func (export "writer-close") (param i32) (call $drop-write (local.get 0)))
;; Same task-local frame as reads, with the original input list at offsets 40/44.
;; Returned remaining elements are lifted before we free the full input buffer.
(func $writer-finish (result i32) (local $f i32) (local $packet i32) (local $count i32) (local $status i32)
  (local.set $f (call $get))
  (if (i32.load offset=8 (local.get $f)) (then unreachable))
  (local.set $packet (i32.load offset=32 (local.get $f)))
  (local.set $count (i32.shr_u (i32.load offset=36 (local.get $f)) (i32.const 4)))
  (local.set $status (i32.and (i32.load offset=36 (local.get $f)) (i32.const 15)))
  (if (i32.and (i32.eqz (i32.const @stream@))
        (i32.and (i32.load offset=12 (local.get $f)) (i32.eqz (local.get $status))))
    (then (local.set $count (i32.const 1))))
  (if (i32.or (i32.gt_u (local.get $count) (i32.load offset=28 (local.get $f)))
              (i32.gt_u (local.get $status) (i32.const 2))) (then unreachable))
  ;; Streams retain their writer across calls. Remove it from this task's
  ;; waitable set before dropping the set, including after partial writes.
  (call $join (i32.load (local.get $f)) (i32.const 0))
  ;; A completed future or a closed reader permits dropping its writer. A
  ;; cancelled, unwritten future retains its writer for retry or Store abort.
  (if (i32.or (i32.eq (local.get $status) (i32.const 1))
        (i32.and (i32.eqz (i32.const @stream@)) (local.get $count)))
    (then (call $drop-write (i32.load (local.get $f)))))
  (if (i32.load offset=16 (local.get $f)) (then (local.set $status (i32.const 2))))
  (i32.store offset=@write-status@ (local.get $packet) (local.get $status))
  (i32.store offset=@write-count@ (local.get $packet) (local.get $count))
  (i32.store offset=@remaining@ (local.get $packet)
    (i32.add (i32.load offset=40 (local.get $f)) (i32.mul (local.get $count) (i32.const @element-size@))))
  (i32.store offset=@remaining-length@ (local.get $packet)
    (i32.mul (i32.sub (i32.load offset=28 (local.get $f)) (local.get $count)) (i32.const @has-payload@)))
  (call $drop-set (i32.load offset=4 (local.get $f)))
  (call $writer-return (local.get $packet))
  (call $clean@list-id@ (i32.add (local.get $f) (i32.const 40)))
  (call $free (local.get $packet))
  (call $set (i32.const 0))
  (call $free (local.get $f))
  (i32.const 0))
(func $write-complete (param $status i32) (result i32)
  (i32.store offset=12 (call $get) (i32.const 1))
  (i32.store offset=36 (call $get) (local.get $status))
  (if (i32.eqz (i32.load offset=8 (call $get))) (then (return (call $writer-finish))))
  (call $join (i32.load offset=8 (call $get)) (i32.const 0))
  (local.set $status (call $cancel-task (i32.load offset=8 (call $get))))
  (if (result i32) (i32.ge_u (i32.and (local.get $status) (i32.const 15)) (i32.const 2))
    (then (call $drop-signal) (call $writer-finish))
    (else (call $waiting))))
(func $write-signal-complete (param $code i32) (result i32) (local $status i32)
  (call $drop-signal)
  (if (i32.eq (local.get $code) (i32.const 2)) (then (i32.store offset=16 (call $get) (i32.const 1))))
  (if (i32.load offset=12 (call $get)) (then (return (call $writer-finish))))
  (call $join (i32.load (call $get)) (i32.const 0))
  (local.set $status (call $cancel-write (i32.load (call $get))))
  (if (result i32) (i32.eq (local.get $status) (i32.const -1))
    (then (call $waiting))
    (else
      (i32.store offset=12 (call $get) (i32.const 1))
      (i32.store offset=36 (call $get) (local.get $status))
      (call $writer-finish))))
(func (export "writer-write") (param $writer i32) (param $ptr i32) (param $len i32) (param $count i32) (param $id i32) (result i32)
  (local $f i32) (local $status i32) (local $packet i32)
  (if (i32.or (i32.eqz (local.get $count)) (i32.gt_u (local.get $count) (i32.const 65536))) (then unreachable))
  (if (i32.and (i32.eqz (i32.const @stream@)) (i32.ne (local.get $count) (i32.const 1))) (then unreachable))
  (if (i32.ne (local.get $len) (i32.mul (local.get $count) (i32.const @has-payload@))) (then unreachable))
  (local.set $f (call $alloc (i32.const 48)))
  (memory.fill (local.get $f) (i32.const 0) (i32.const 48))
  (call $set (local.get $f))
  (i32.store (local.get $f) (local.get $writer))
  (i32.store offset=4 (local.get $f) (call $new))
  (i32.store offset=20 (local.get $f) (local.get $id))
  (i32.store offset=24 (local.get $f) (local.get $ptr))
  (i32.store offset=28 (local.get $f) (local.get $count))
  (i32.store offset=40 (local.get $f) (local.get $ptr))
  (i32.store offset=44 (local.get $f) (local.get $len))
  (local.set $packet (call $alloc (i32.const @write-packet-size@)))
  (memory.fill (local.get $packet) (i32.const 0) (i32.const @write-packet-size@))
  (i32.store offset=32 (local.get $f) (local.get $packet))
  (local.set $status (call $wait (local.get $id)))
  (i32.store offset=8 (local.get $f) (i32.shr_u (local.get $status) (i32.const 4)))
  (if (i32.eq (i32.and (local.get $status) (i32.const 15)) (i32.const 2))
    (then
      (if (i32.load offset=8 (local.get $f)) (then (call $drop-signal)))
      (i32.store offset=16 (local.get $f) (i32.const 1))
      (return (call $writer-finish))))
  (call $join (i32.load offset=8 (local.get $f)) (i32.load offset=4 (local.get $f)))
  (local.set $status (call $write (local.get $writer) (local.get $ptr) @write-capacity@))
  (if (result i32) (i32.eq (local.get $status) (i32.const -1))
    (then (call $join (local.get $writer) (i32.load offset=4 (local.get $f))) (call $waiting))
    (else (call $write-complete (local.get $status)))))
(func (export "writer-callback") (param $event i32) (param $waitable i32) (param $code i32) (result i32)
  (if (i32.eq (local.get $event) (i32.const 1))
    (then
      (if (i32.ne (local.get $waitable) (i32.load offset=8 (call $get))) (then unreachable))
      (if (i32.lt_u (local.get $code) (i32.const 2)) (then (return (call $waiting))))
      (return (call $write-signal-complete (local.get $code)))))
  (if (i32.ne (local.get $event) (i32.const @write-event@)) (then unreachable))
  (if (i32.ne (local.get $waitable) (i32.load (call $get))) (then unreachable))
  (call $write-complete (local.get $code)))
