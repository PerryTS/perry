(component
  (type $future (future u32))
  (import "test:input/source" (instance $source (export "get" (func (result $future)))))
  (alias export $source "get" (func $get))
  (core func $get (canon lower (func $get)))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "memory" (core memory $memory))
  (core func $read (canon future.read $future async (memory $memory)))
  (core func $drop-read (canon future.drop-readable $future))
  (core func $return (canon task.return (result u32)))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core module $code
    (import "env" "memory" (memory 1))
    (import "env" "get" (func $get (result i32)))
    (import "env" "read" (func $read (param i32 i32) (result i32)))
    (import "env" "drop-read" (func $drop-read (param i32)))
    (import "env" "return" (func $return (param i32)))
    (import "env" "new-set" (func $new-set (result i32)))
    (import "env" "join" (func $join (param i32 i32)))
    (import "env" "drop-set" (func $drop-set (param i32)))
    (global $reader (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (func $finish (param $status i32) (result i32)
      (if (local.get $status) (then unreachable))
      (call $drop-read (global.get $reader))
      (call $drop-set (global.get $set))
      (call $return (i32.load (i32.const 0))) (i32.const 0))
    (func (export "take") (result i32) (local $status i32)
      (global.set $reader (call $get))
      (global.set $set (call $new-set))
      (local.set $status (call $read (global.get $reader) (i32.const 0)))
      (if (result i32) (i32.eq (local.get $status) (i32.const -1))
        (then (call $join (global.get $reader) (global.get $set))
          (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
        (else (call $finish (local.get $status)))))
    (func (export "callback") (param i32 i32 i32) (result i32)
      (if (i32.or (i32.ne (local.get 0) (i32.const 4)) (i32.ne (local.get 1) (global.get $reader))) (then unreachable))
      (call $finish (local.get 2))))
  (core instance $code (instantiate $code (with "env" (instance
    (export "memory" (memory $memory)) (export "get" (func $get))
    (export "read" (func $read)) (export "drop-read" (func $drop-read))
    (export "return" (func $return)) (export "new-set" (func $new-set))
    (export "join" (func $join)) (export "drop-set" (func $drop-set))))))
  (func (export "take") async (result u32)
    (canon lift (core func $code "take") async (callback (core func $code "callback")))))
