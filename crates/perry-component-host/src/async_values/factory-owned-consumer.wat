;; Appended inside producer.component.wat; shares the original nominal thing.
(core func $take-read (canon future.read $future async (memory $memory)))
(core func $take-drop (canon future.drop-readable $future))
(core func $take-return (canon task.return (result (own $thing))))
(core func $take-new-set (canon waitable-set.new))
(core func $take-join (canon waitable.join))
(core func $take-drop-set (canon waitable-set.drop))
(core module $take-code
  (import "env" "memory" (memory 1))
  (import "env" "read" (func $read (param i32 i32) (result i32)))
  (import "env" "drop" (func $drop (param i32)))
  (import "env" "return" (func $return (param i32)))
  (import "env" "new-set" (func $new-set (result i32)))
  (import "env" "join" (func $join (param i32 i32)))
  (import "env" "drop-set" (func $drop-set (param i32)))
  (global $reader (mut i32) (i32.const 0))
  (global $set (mut i32) (i32.const 0))
  (func $finish (param $status i32) (result i32)
    (if (local.get $status) (then unreachable))
    (call $drop (global.get $reader)) (call $drop-set (global.get $set))
    (call $return (i32.load (i32.const 16))) (i32.const 0))
  (func (export "take") (param $reader i32) (result i32) (local $status i32)
    (global.set $reader (local.get $reader)) (global.set $set (call $new-set))
    (local.set $status (call $read (global.get $reader) (i32.const 16)))
    (if (result i32) (i32.eq (local.get $status) (i32.const -1))
      (then (call $join (global.get $reader) (global.get $set))
        (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
      (else (call $finish (local.get $status)))))
  (func (export "callback") (param i32 i32 i32) (result i32)
    (if (i32.or (i32.ne (local.get 0) (i32.const 4)) (i32.ne (local.get 1) (global.get $reader))) (then unreachable))
    (call $finish (local.get 2))))
(core instance $take-code (instantiate $take-code (with "env" (instance
  (export "memory" (memory $memory)) (export "read" (func $take-read))
  (export "drop" (func $take-drop)) (export "return" (func $take-return))
  (export "new-set" (func $take-new-set)) (export "join" (func $take-join))
  (export "drop-set" (func $take-drop-set))))))
(func $take async (param "value" $future) (result (own $thing))
  (canon lift (core func $take-code "take") async (callback (core func $take-code "callback"))))
