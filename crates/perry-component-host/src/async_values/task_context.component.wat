(component
  (import "clock" (instance $clock
    (export "wait-for" (func async (param "value" u64)))))
  (alias export $clock "wait-for" (func $wait))
  (core func $wait (canon lower (func $wait) async))
  (core func $return (canon task.return (result u64)))
  (core func $get (canon context.get i32 0))
  (core func $set (canon context.set i32 0))
  (core func $new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core func $drop-task (canon subtask.drop))
  ;; HEAP
  (core instance $heap (instantiate $heap))
  (core module $code
    (import "host" "memory" (memory 1))
    (import "host" "alloc" (func $alloc (param i32) (result i32)))
    (import "host" "free" (func $free (param i32)))
    (import "host" "get" (func $get (result i32)))
    (import "host" "set" (func $set (param i32)))
    (import "host" "wait" (func $wait (param i64) (result i32)))
    (import "host" "return" (func $return (param i64)))
    (import "host" "new" (func $new (result i32)))
    (import "host" "join" (func $join (param i32 i32)))
    (import "host" "drop-set" (func $drop-set (param i32)))
    (import "host" "drop-task" (func $drop-task (param i32)))
    (func $waiting (result i32)
      (i32.or (i32.const 2) (i32.shl (i32.load offset=8 (call $get)) (i32.const 4))))
    (func $finish (result i32) (local $frame i32) (local $task i32)
      (local.set $frame (call $get))
      (local.set $task (i32.load offset=12 (local.get $frame)))
      (if (local.get $task) (then (call $drop-task (local.get $task))))
      (call $drop-set (i32.load offset=8 (local.get $frame)))
      (call $return (i64.load (local.get $frame)))
      (call $set (i32.const 0))
      (call $free (local.get $frame))
      (i32.const 0))
    (func (export "run") (param $value i64) (result i32) (local $frame i32) (local $status i32)
      (local.set $frame (call $alloc (i32.const 16)))
      (call $set (local.get $frame))
      (i64.store (local.get $frame) (local.get $value))
      (i32.store offset=8 (local.get $frame) (call $new))
      (local.set $status (call $wait (local.get $value)))
      (i32.store offset=12 (local.get $frame) (i32.shr_u (local.get $status) (i32.const 4)))
      (if (result i32) (i32.eq (i32.and (local.get $status) (i32.const 15)) (i32.const 2))
        (then (call $finish))
        (else
          (call $join (i32.load offset=12 (local.get $frame)) (i32.load offset=8 (local.get $frame)))
          (call $waiting))))
    (func (export "callback") (param $event i32) (param $waitable i32) (param $code i32) (result i32)
      (if (i32.ne (local.get $event) (i32.const 1)) (then unreachable))
      (if (i32.ne (local.get $waitable) (i32.load offset=12 (call $get))) (then unreachable))
      (if (result i32) (i32.eq (local.get $code) (i32.const 2))
        (then (call $finish)) (else (call $waiting)))))
  (core instance $code (instantiate $code (with "host" (instance
    (export "memory" (memory $heap "memory"))
    (export "alloc" (func $heap "alloc")) (export "free" (func $heap "free"))
    (export "get" (func $get)) (export "set" (func $set))
    (export "wait" (func $wait)) (export "return" (func $return))
    (export "new" (func $new)) (export "join" (func $join))
    (export "drop-set" (func $drop-set)) (export "drop-task" (func $drop-task))))))
  (func (export "run") async (param "value" u64) (result u64)
    (canon lift (core func $code "run") async (callback (core func $code "callback")))))
