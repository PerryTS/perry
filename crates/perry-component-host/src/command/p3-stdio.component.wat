;; Transfer stdin's stream through guest memory to stdout, returning both
;; completion futures to the host. No stream or future is substituted in Rust.
(component
  (import "wasi:cli/types@0.3.0" (instance $types
    (type $error (enum "io" "illegal-byte-sequence" "pipe"))
    (export "error-code" (type (eq $error)))))
  (alias export $types "error-code" (type $error))
  (type $outcome (result (error $error)))
  (type $completion (future $outcome))
  (type $bytes (stream u8))
  (import "wasi:cli/stdin@0.3.0" (instance $stdin
    (alias outer 1 $error (type $error))
    (alias outer 1 $completion (type $completion))
    (alias outer 1 $bytes (type $bytes))
    (export "error-code" (type (eq $error)))
    (export "read-via-stream" (func (result (tuple $bytes $completion))))))
  (import "wasi:cli/stdout@0.3.0" (instance $stdout
    (alias outer 1 $error (type $error))
    (alias outer 1 $completion (type $completion))
    (alias outer 1 $bytes (type $bytes))
    (export "error-code" (type (eq $error)))
    (export "write-via-stream" (func (param "data" $bytes) (result $completion)))))
  (alias export $stdin "read-via-stream" (func $read))
  (alias export $stdout "write-via-stream" (func $write))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (core func $read (canon lower (func $read) (memory (core memory $memory "memory"))))
  (core func $write (canon lower (func $write)))
  (core func $future-read (canon future.read $completion async (memory (core memory $memory "memory"))))
  (core func $drop-readable (canon future.drop-readable $completion))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core func $return (canon task.return (result (result))))
  (core module $guest
    (import "memory" "memory" (memory 1))
    (import "host" "read" (func $read (param i32)))
    (import "host" "write" (func $write (param i32) (result i32)))
    (import "host" "future-read" (func $future-read (param i32 i32) (result i32)))
    (import "host" "drop-readable" (func $drop-readable (param i32)))
    (import "host" "new-set" (func $new-set (result i32)))
    (import "host" "join" (func $join (param i32 i32)))
    (import "host" "drop-set" (func $drop-set (param i32)))
    (import "host" "return" (func $return (param i32)))
    (global $set (mut i32) (i32.const 0))
    (global $input (mut i32) (i32.const 0))
    (global $output (mut i32) (i32.const 0))
    (global $phase (mut i32) (i32.const 0))
    (global $failed (mut i32) (i32.const 0))
    (func $waiting (result i32)
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func $finish-input (param $status i32) (result i32)
      ;; A completed future has an implicit value and a zero count nibble.
      ;; Dropped/cancelled are 1/2: never treat close as success.
      (if (i32.ne (local.get $status) (i32.const 0)) (then unreachable))
      (if (i32.gt_u (i32.load8_u (i32.const 68)) (i32.const 1)) (then unreachable))
      (if (i32.load8_u (i32.const 68)) (then (global.set $failed (i32.const 1))))
      (call $drop-readable (global.get $input))
      (call $drop-set (global.get $set))
      (call $return (global.get $failed))
      (i32.const 0))
    (func $finish-output (param $status i32) (result i32) (local $input-status i32)
      (if (i32.ne (local.get $status) (i32.const 0)) (then unreachable))
      (if (i32.gt_u (i32.load8_u (i32.const 64)) (i32.const 1)) (then unreachable))
      (if (i32.load8_u (i32.const 64)) (then (global.set $failed (i32.const 1))))
      (call $drop-readable (global.get $output))
      (global.set $phase (i32.const 1))
      (local.set $input-status (call $future-read (global.get $input) (i32.const 68)))
      (if (result i32) (i32.eq (local.get $input-status) (i32.const -1))
        (then (call $join (global.get $input) (global.get $set)) (call $waiting))
        (else (call $finish-input (local.get $input-status)))))
    (func (export "run") (result i32) (local $status i32)
      (global.set $set (call $new-set))
      (i32.store8 (i32.const 64) (i32.const 255))
      (i32.store8 (i32.const 68) (i32.const 255))
      (call $read (i32.const 16))
      (global.set $input (i32.load (i32.const 20)))
      (global.set $output (call $write (i32.load (i32.const 16))))
      (local.set $status (call $future-read (global.get $output) (i32.const 64)))
      (if (result i32) (i32.eq (local.get $status) (i32.const -1))
        (then (call $join (global.get $output) (global.get $set)) (call $waiting))
        (else (call $finish-output (local.get $status)))))
    (func (export "callback") (param $event i32) (param $waitable i32) (param $code i32) (result i32)
      (if (i32.ne (local.get $event) (i32.const 4)) (then unreachable))
      (if (result i32) (global.get $phase)
        (then
          (if (i32.ne (local.get $waitable) (global.get $input)) (then unreachable))
          (call $finish-input (local.get $code)))
        (else
          (if (i32.ne (local.get $waitable) (global.get $output)) (then unreachable))
          (call $finish-output (local.get $code))))))
  (core instance $guest (instantiate $guest (with "memory" (instance $memory))
    (with "host" (instance
      (export "read" (func $read)) (export "write" (func $write))
      (export "future-read" (func $future-read)) (export "drop-readable" (func $drop-readable))
      (export "new-set" (func $new-set)) (export "join" (func $join))
      (export "drop-set" (func $drop-set)) (export "return" (func $return))))))
  (func $run async (result (result))
    (canon lift (core func $guest "run") async (callback (core func $guest "callback"))))
  (instance $command (export "run" (func $run)))
  (export "wasi:cli/run@0.3.0" (instance $command)))
