;; Reentrant P3 HTTP fixture: each task owns a heap frame in context slot zero.
(component
  (import "wasi:http/types@0.3.0" (instance $http
    (type $dns-definition (record (field "rcode" (option string)) (field "info-code" (option u16))))
    (export "DNS-error-payload" (type $dns (eq $dns-definition)))
    (type $tls-definition (record (field "alert-id" (option u8)) (field "alert-message" (option string))))
    (export "TLS-alert-received-payload" (type $tls (eq $tls-definition)))
    (type $size-definition (record (field "field-name" (option string)) (field "field-size" (option u32))))
    (export "field-size-payload" (type $size (eq $size-definition)))
    (type $error-definition (variant
      (case "DNS-timeout")
      (case "DNS-error" $dns)
      (case "destination-not-found")
      (case "destination-unavailable")
      (case "destination-IP-prohibited")
      (case "destination-IP-unroutable")
      (case "connection-refused")
      (case "connection-terminated")
      (case "connection-timeout")
      (case "connection-read-timeout")
      (case "connection-write-timeout")
      (case "connection-limit-reached")
      (case "TLS-protocol-error")
      (case "TLS-certificate-error")
      (case "TLS-alert-received" $tls)
      (case "HTTP-request-denied")
      (case "HTTP-request-length-required")
      (case "HTTP-request-body-size" (option u64))
      (case "HTTP-request-method-invalid")
      (case "HTTP-request-URI-invalid")
      (case "HTTP-request-URI-too-long")
      (case "HTTP-request-header-section-size" (option u32))
      (case "HTTP-request-header-size" (option $size))
      (case "HTTP-request-trailer-section-size" (option u32))
      (case "HTTP-request-trailer-size" $size)
      (case "HTTP-response-incomplete")
      (case "HTTP-response-header-section-size" (option u32))
      (case "HTTP-response-header-size" $size)
      (case "HTTP-response-body-size" (option u64))
      (case "HTTP-response-trailer-section-size" (option u32))
      (case "HTTP-response-trailer-size" $size)
      (case "HTTP-response-transfer-coding" (option string))
      (case "HTTP-response-content-coding" (option string))
      (case "HTTP-response-timeout")
      (case "HTTP-upgrade-failed")
      (case "HTTP-protocol-error")
      (case "loop-detected")
      (case "configuration-error")
      (case "internal-error" (option string))))
    (export "error-code" (type $error (eq $error-definition)))
    (export "fields" (type $fields (sub resource)))
    (export "headers" (type (eq $fields)))
    (export "trailers" (type (eq $fields)))
    (export "request" (type $request (sub resource)))
    (export "response" (type $response (sub resource)))
    (type $outcome (result (error $error)))
    (type $completion (future $outcome))
    (type $bytes (stream u8))
    (type $trailers (future (result (option (own $fields)) (error $error))))
    (export "[method]request.get-headers" (func (param "self" (borrow $request)) (result (own $fields))))
    (export "[static]request.consume-body" (func (param "this" (own $request)) (param "res" $completion) (result (tuple $bytes $trailers))))
    (export "[static]response.new" (func (param "headers" (own $fields)) (param "contents" (option $bytes)) (param "trailers" $trailers) (result (tuple (own $response) $completion))))))
  (alias export $http "request" (type $request))
  (alias export $http "response" (type $response))
  (alias export $http "fields" (type $fields))
  (alias export $http "error-code" (type $error))
  (export "request" (type $request))
  (export "response" (type $response))
  (export "fields" (type $fields))
  (export "error-code" (type $error))
  (type $completion (future (result (error $error))))
  (alias export $http "[method]request.get-headers" (func $headers))
  (alias export $http "[static]request.consume-body" (func $consume))
  (alias export $http "[static]response.new" (func $response))
  ;; Private helper memory. Size-class free lists recycle canonical payload
;; buffers after task.return has lifted their values. No WASI imports, native
;; pointers or host allocator are needed. Store limits account for all growth.
(core module $memory
  (memory (export "memory") 1)
  (global $bump (mut i32) (i32.const 4096))
  ;; Free-list heads occupy 1024 + class*4. Blocks have a 16-byte header and
  ;; 2^class total bytes; minimum class 5 keeps every payload 16-byte aligned.
  (func $check (param $ptr i32) (result i32) (local $header i32) (local $class i32)
    (if (i32.or (i32.lt_u (local.get $ptr) (i32.const 4112))
                (i32.ne (i32.and (local.get $ptr) (i32.const 15)) (i32.const 0)))
      (then unreachable))
    (local.set $header (i32.sub (local.get $ptr) (i32.const 16)))
    (if (i32.ne (i32.load offset=4 (local.get $header)) (i32.const 1348825714))
      (then unreachable))
    (local.set $class (i32.load (local.get $header)))
    (if (i32.or (i32.lt_u (local.get $class) (i32.const 5))
                (i32.gt_u (local.get $class) (i32.const 31))) (then unreachable))
    (local.get $header))

  (func $alloc (export "alloc") (param $size i32) (result i32)
    (local $class i32) (local $bin i32) (local $header i32)
    (local $end i32) (local $pages i32) (local $current i32)
    (if (i32.eqz (local.get $size)) (then (return (i32.const 0))))
    (if (i32.gt_u (local.get $size) (i32.const 2147483632)) (then unreachable))
    (local.set $class (i32.sub (i32.const 32) (i32.clz (i32.add (local.get $size) (i32.const 15)))))
    (if (i32.lt_u (local.get $class) (i32.const 5)) (then (local.set $class (i32.const 5))))
    (local.set $bin (i32.add (i32.const 1024) (i32.shl (local.get $class) (i32.const 2))))
    (local.set $header (i32.load (local.get $bin)))
    (if (local.get $header)
      (then (i32.store (local.get $bin) (i32.load offset=8 (local.get $header))))
      (else
        (local.set $header (global.get $bump))
        (local.set $end (i32.add (local.get $header) (i32.shl (i32.const 1) (local.get $class))))
        (if (i32.le_u (local.get $end) (local.get $header)) (then unreachable))
        (local.set $pages (i32.add (i32.const 1) (i32.shr_u (i32.sub (local.get $end) (i32.const 1)) (i32.const 16))))
        (local.set $current (memory.size))
        (if (i32.gt_u (local.get $pages) (local.get $current))
          (then (if (i32.eq (memory.grow (i32.sub (local.get $pages) (local.get $current))) (i32.const -1))
                  (then unreachable))))
        ;; Publish only after growth succeeds: a denied allocation must not
        ;; consume the remaining address space or invalidate existing blocks.
        (global.set $bump (local.get $end))))
    (i32.store (local.get $header) (local.get $class))
    (i32.store offset=4 (local.get $header) (i32.const 1348825714))
    (i32.store offset=8 (local.get $header) (local.get $size))
    (i32.add (local.get $header) (i32.const 16)))

  (func $free (export "free") (param $ptr i32) (local $header i32) (local $bin i32)
    (if (i32.eqz (local.get $ptr)) (then (return)))
    (local.set $header (call $check (local.get $ptr)))
    (local.set $bin (i32.add (i32.const 1024) (i32.shl (i32.load (local.get $header)) (i32.const 2))))
    (i32.store offset=4 (local.get $header) (i32.const 0))
    (i32.store offset=8 (local.get $header) (i32.load (local.get $bin)))
    (i32.store (local.get $bin) (local.get $header)))

  (func (export "realloc") (param $old i32) (param $old-size i32)
    (param $align i32) (param $size i32) (result i32)
    (local $header i32) (local $new i32) (local $capacity i32)
    (if (i32.or (i32.eqz (local.get $align))
          (i32.or (i32.gt_u (local.get $align) (i32.const 16))
            (i32.ne (i32.and (local.get $align) (i32.sub (local.get $align) (i32.const 1))) (i32.const 0))))
      (then unreachable))
    (if (i32.eqz (local.get $old))
      (then
        (if (local.get $old-size) (then unreachable))
        (return (call $alloc (local.get $size)))))
    (local.set $header (call $check (local.get $old)))
    (if (i32.gt_u (local.get $old-size) (i32.load offset=8 (local.get $header))) (then unreachable))
    (if (i32.eqz (local.get $size))
      (then (call $free (local.get $old)) (return (i32.const 0))))
    (local.set $capacity (i32.sub (i32.shl (i32.const 1) (i32.load (local.get $header))) (i32.const 16)))
    (if (i32.le_u (local.get $size) (local.get $capacity))
      (then
        (i32.store offset=8 (local.get $header) (local.get $size))
        (return (local.get $old))))
    (local.set $new (call $alloc (local.get $size)))
    (memory.copy (local.get $new) (local.get $old) (local.get $old-size))
    (call $free (local.get $old))
    (local.get $new))
)

  (core instance $memory (instantiate $memory))
  (core func $headers (canon lower (func $headers)))
  (core func $consume (canon lower (func $consume) (memory (core memory $memory "memory"))))
  (core func $response (canon lower (func $response) (memory (core memory $memory "memory"))))
  (type $reply (result (own $response) (error $error)))
  (core func $future-new (canon future.new $completion))
  (core func $future-write (canon future.write $completion async (memory (core memory $memory "memory"))))
  (core func $drop-readable (canon future.drop-readable $completion))
  (core func $drop-writable (canon future.drop-writable $completion))
  (core func $get (canon context.get i32 0))
  (core func $set (canon context.set i32 0))
  (core func $return (canon task.return (result $reply) (memory (core memory $memory "memory"))))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-set (canon waitable-set.drop))
  (core module $guest
    (import "memory" "memory" (memory 1))
    (import "host" "get" (func $get (result i32)))
    (import "host" "set" (func $set (param i32)))
    (import "host" "alloc" (func $alloc (param i32) (result i32)))
    (import "host" "free" (func $free (param i32)))
    (import "host" "headers" (func $headers (param i32) (result i32)))
    (import "host" "consume" (func $consume (param i32 i32 i32)))
    (import "host" "response" (func $response (param i32 i32 i32 i32 i32)))
    (import "host" "future-new" (func $future-new (result i64)))
    (import "host" "future-write" (func $future-write (param i32 i32) (result i32)))
    (import "host" "drop-readable" (func $drop-readable (param i32)))
    (import "host" "drop-writable" (func $drop-writable (param i32)))
    (import "host" "return" (func $return (param i32 i32 i32 i64 i32 i32 i32 i32)))
    (import "host" "new-set" (func $new-set (result i32)))
    (import "host" "join" (func $join (param i32 i32)))
    (import "host" "drop-set" (func $drop-set (param i32)))
    (func $finish (result i32)
      (call $drop-writable (i32.load offset=128 (call $get)))
      (call $drop-set (i32.load offset=132 (call $get)))
      (call $return (i32.const 0) (i32.load offset=104 (call $get))
        (i32.const 0) (i64.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
      (call $free (call $get))
      (call $set (i32.const 0))
      (i32.const 0))
    (func (export "handle") (param $request i32) (result i32) (local $headers i32) (local $future i64) (local $status i32)
      (call $set (call $alloc (i32.const 160)))
      (i32.store offset=132 (call $get) (call $new-set))
      (local.set $future (call $future-new))
      (i32.store offset=128 (call $get) (i32.wrap_i64 (i64.shr_u (local.get $future) (i64.const 32))))
      (local.set $headers (call $headers (local.get $request)))
      (call $consume (local.get $request) (i32.wrap_i64 (local.get $future)) (i32.add (call $get) (i32.const 16)))
      (call $response (local.get $headers) (i32.const 1) (i32.load offset=16 (call $get)) (i32.load offset=20 (call $get)) (call $get))
      (call $drop-readable (i32.load offset=4 (call $get)))
      (i32.store8 offset=96 (call $get) (i32.const 0))
      (i32.store offset=104 (call $get) (i32.load offset=0 (call $get)))
      (i32.store8 offset=64 (call $get) (i32.const 0))
      (local.set $status (call $future-write (i32.load offset=128 (call $get)) (i32.add (call $get) (i32.const 64))))
      (if (result i32) (i32.eq (local.get $status) (i32.const -1))
        (then (call $join (i32.load offset=128 (call $get)) (i32.load offset=132 (call $get)))
          (i32.or (i32.const 2) (i32.shl (i32.load offset=132 (call $get)) (i32.const 4))))
        (else (call $finish))))
    (func (export "callback") (param $event i32) (param $waitable i32) (param $code i32) (result i32)
      (if (i32.ne (local.get $event) (i32.const 5)) (then unreachable))
      (if (i32.ne (local.get $waitable) (i32.load offset=128 (call $get))) (then unreachable))
      (call $finish)))
  (core instance $guest (instantiate $guest (with "memory" (instance $memory))
    (with "host" (instance
      (export "get" (func $get)) (export "set" (func $set))
      (export "alloc" (func $memory "alloc")) (export "free" (func $memory "free"))
      (export "headers" (func $headers)) (export "consume" (func $consume)) (export "response" (func $response))
      (export "future-new" (func $future-new)) (export "future-write" (func $future-write))
      (export "drop-readable" (func $drop-readable)) (export "drop-writable" (func $drop-writable))
      (export "return" (func $return)) (export "new-set" (func $new-set)) (export "join" (func $join)) (export "drop-set" (func $drop-set))))))
  (func $handle async (param "request" (own $request)) (result $reply)
    (canon lift (core func $guest "handle") async (memory (core memory $memory "memory")) (callback (core func $guest "callback"))))
  (instance $handler (export "handle" (func $handle)))
  (export "wasi:http/handler@0.3.0" (instance $handler)))
